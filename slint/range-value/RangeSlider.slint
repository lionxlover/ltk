import { Theme } from "../core/Theme.slint";

export component RangeSlider inherits Rectangle {
    in-out property <float> low: 25;
    in-out property <float> high: 75;
    in-out property <float> minimum: 0;
    in-out property <float> maximum: 100;

    height: 20px;
    horizontal-stretch: 1;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 6px;
        background: Theme.bg-overlay;
        border-radius: 3px;

        fill := Rectangle {
            x: max(0, (root.low - root.minimum) / max(1, root.maximum - root.minimum) * parent.width);
            width: max(0, (root.high - root.low) / max(1, root.maximum - root.minimum) * parent.width);
            height: parent.height;
            background: Theme.accent;
            border-radius: 3px;
        }
    }

    low-handle := Rectangle {
        width: 20px;
        height: 20px;
        background: Theme.bg-surface;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: 10px;
        x: max(0, min(parent.width - self.width,
            (root.low - root.minimum) / max(1, root.maximum - root.minimum) * (parent.width - self.width)));
        y: (parent.height - self.height) / 2;

        drop-shadow-color: Theme.border-default;
        drop-shadow-blur: 4px;

        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            moved => {
                if (self.pressed) {
                    root.low = max(root.minimum, min(root.high,
                        root.minimum + (self.mouse-x + parent.x) / max(1px, root.width - parent.width) * (root.maximum - root.minimum)));
                }
            }
        }
    }

    high-handle := Rectangle {
        width: 20px;
        height: 20px;
        background: Theme.bg-surface;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: 10px;
        x: max(0, min(parent.width - self.width,
            (root.high - root.minimum) / max(1, root.maximum - root.minimum) * (parent.width - self.width)));
        y: (parent.height - self.height) / 2;

        drop-shadow-color: Theme.border-default;
        drop-shadow-blur: 4px;

        TouchArea {
            mouse-cursor: MouseCursor.pointer;
            moved => {
                if (self.pressed) {
                    root.high = max(root.low, min(root.maximum,
                        root.minimum + (self.mouse-x + parent.x) / max(1px, root.width - parent.width) * (root.maximum - root.minimum)));
                }
            }
        }
    }
}
