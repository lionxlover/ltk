import { Theme } from "../core/Theme.slint";

export component OpacitySlider inherits Rectangle {
    in-out property <float> opacity-value: 100;

    height: 20px;
    horizontal-stretch: 1;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 12px;
        border-radius: 6px;
        clip: true;
        background: Theme.bg-overlay;

        checker := Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: 6px;
            background: #ffffff;
        }

        fill := Rectangle {
            x: 0;
            width: parent.width * (root.opacity-value / 100);
            height: parent.height;
            background: Theme.accent;
            border-radius: 6px;
        }
    }

    handle := Rectangle {
        width: 20px;
        height: 20px;
        background: Theme.bg-surface;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: 10px;
        x: max(0, min(parent.width - self.width, root.opacity-value / 100 * parent.width));
        y: (parent.height - self.height) / 2;

        drop-shadow-color: Theme.border-default;
        drop-shadow-blur: 4px;
    }

    TouchArea {
        moved => {
            root.opacity-value = max(0, min(100, (self.mouse-x / parent.width) * 100));
        }
    }
}
