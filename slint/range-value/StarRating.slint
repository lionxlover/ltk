import { Theme } from "../core/Theme.slint";

export component StarRating inherits Rectangle {
    in-out property <int> rating: 3;
    in property <[int]> max-stars: [0, 1, 2, 3, 4];

    height: 28px;
    horizontal-stretch: 1;

    HorizontalLayout {
        spacing: 4px;

        for i in root.max-stars: Rectangle {
            width: 24px;
            height: 24px;
            background: transparent;

            star := Rectangle {
                width: 24px;
                height: 24px;
                background: i < root.rating ? Theme.warning : Theme.bg-overlay;
                border-radius: 12px;

                Text {
                    text: "★";
                    color: i < root.rating ? #ffffff : Theme.text-tertiary;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            TouchArea {
                clicked => { root.rating = i + 1; }
            }
        }
    }
}
