import { Theme } from "../core/Theme.slint";

export component VerticalSlider inherits Rectangle {
    in-out property <float> value: 50;
    in-out property <float> minimum: 0;
    in-out property <float> maximum: 100;

    width: 20px;
    vertical-stretch: 1;

    Rectangle {
        x: (parent.width - self.width) / 2;
        width: 6px;
        height: parent.height;
        background: Theme.bg-overlay;
        border-radius: 3px;

        fill := Rectangle {
            y: max(0, (1 - (root.value - root.minimum) / max(1, root.maximum - root.minimum)) * parent.height);
            width: parent.width;
            height: max(0, (root.value - root.minimum) / max(1, root.maximum - root.minimum) * parent.height);
            background: Theme.accent;
            border-radius: 3px;
        }
    }

    handle := Rectangle {
        width: 20px;
        height: 20px;
        background: Theme.bg-surface;
        border-width: 2px;
        border-color: Theme.accent;
        border-radius: 10px;
        x: (parent.width - self.width) / 2;
        y: max(0, min(parent.height - self.height,
            (1 - (root.value - root.minimum) / max(1, root.maximum - root.minimum)) * (parent.height - self.height)));

        drop-shadow-color: Theme.border-default;
        drop-shadow-blur: 4px;
    }

    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        moved => {
            // Inverted because the track fills from the bottom: the
            // topmost pixel (mouse-y == 0) represents maximum, matching
            // the fill/handle position bindings above which use
            // (1 - fraction) for the same reason.
            root.value = max(root.minimum, min(root.maximum,
                (1 - (self.mouse-y / parent.height)) * (root.maximum - root.minimum) + root.minimum));
        }
    }
}
