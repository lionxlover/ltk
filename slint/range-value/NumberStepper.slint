import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component NumberStepper inherits Rectangle {
    in-out property <float> value: 0;
    in-out property <float> step: 1;
    in-out property <float> minimum: 0;
    in-out property <float> maximum: 100;

    height: 36px;
    horizontal-stretch: 1;

    Rectangle {
        background: Theme.bg-surface;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-base;

        Rectangle {
            width: 36px;
            height: parent.height;
            background: Theme.bg-raised;

            FaIcon {
                source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/minus.svg");
                fa-size: 12px;
                fa-color: Theme.text-secondary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            TouchArea {
                clicked => {
                    root.value = max(root.minimum, root.value - root.step);
                }
            }
        }

        Rectangle {
            x: 36px;
            width: parent.width - 72px;
            height: parent.height;

            Text {
                text: round(root.value);
                color: Theme.text-primary;
                font-size: 14px;
                font-weight: Theme.weight-medium;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            x: parent.width - 36px;
            width: 36px;
            height: parent.height;
            background: Theme.bg-raised;

            FaIcon {
                source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/plus.svg");
                fa-size: 12px;
                fa-color: Theme.text-secondary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            TouchArea {
                clicked => {
                    root.value = min(root.maximum, root.value + root.step);
                }
            }
        }
    }
}
