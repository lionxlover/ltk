import { Theme } from "../core/Theme.slint";

export component FocusRingCustom inherits Rectangle {
    background: transparent;

    in property <bool> active: false;
    in property <length> ring-width: 2px;
    in property <length> ring-offset: 2px;
    in property <string> ring-color-name: "accent";

    border-width: active ? ring-width : 0px;
    border-color: ring-color-name == "error" ? Theme.error
        : ring-color-name == "success" ? Theme.success
        : ring-color-name == "warning" ? Theme.warning
        : Theme.accent;
    border-radius: Theme.radius-sm;
}
