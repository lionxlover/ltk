import { Theme } from "../core/Theme.slint";

// Bug: the code snippet was hardcoded with no way to override it. Since
// this inherits Rectangle (not Text, unlike most of this category's
// presets), the builtin `text` property isn't available to override —
// nothing exposed a way to show different code at all. Added an
// explicit `in property <string> code`.
export component InlineCodeSpan inherits Rectangle {
    in property <string> code: "let x = 42;";

    background: Theme.bg-surface;
    border-radius: Theme.radius-sm;
    horizontal-stretch: 1;
    height: self.preferred-height;
    vertical-stretch: 0;

    VerticalLayout {
        alignment: center;
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 2px;
        padding-bottom: 2px;

        Text {
            text: root.code;
            color: Theme.accent;
            font-family: Theme.font-mono;
            font-size: 13px;
            font-weight: Theme.weight-regular;
        }
    }
}

