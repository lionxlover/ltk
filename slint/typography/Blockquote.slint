import { Theme } from "../core/Theme.slint";

// Bug: quote/author were hardcoded with no way to override either —
// same reusability gap fixed elsewhere in this category.
export component Blockquote inherits Rectangle {
    in property <string> quote: "Design is not just what it looks like and feels like. Design is how it works.";
    in property <string> author: "— Steve Jobs";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 3px;
        height: parent.height;
        background: Theme.accent;
        border-radius: 3px;
    }

    VerticalLayout {
        padding-left: 20px;
        padding-right: 16px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 8px;

        Text {
            text: root.quote;
            color: Theme.text-primary;
            font-family: Theme.font-ui;
            font-size: 15px;
            font-weight: Theme.weight-regular;
            font-italic: true;
            wrap: word-wrap;
        }
        Text {
            text: root.author;
            color: Theme.text-tertiary;
            font-family: Theme.font-ui;
            font-size: 12px;
            font-weight: Theme.weight-medium;
        }
    }
}

