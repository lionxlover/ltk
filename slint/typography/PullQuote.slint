import { Theme } from "../core/Theme.slint";

// Bug: quote/author were hardcoded with no way to override either —
// same reusability gap fixed elsewhere in this category
// (RunningText/NumericTabular/DropCap/InlineCodeSpan).
export component PullQuote inherits Rectangle {
    in property <string> quote: "The details are not the details. They make the design.";
    in property <string> author: "— Charles Eames";

    horizontal-stretch: 1;
    vertical-stretch: 0;

    VerticalLayout {
        spacing: 12px;

        Rectangle {
            height: 2px;
            background: Theme.border-base;
        }

        Text {
            text: root.quote;
            color: Theme.text-primary;
            font-family: Theme.font-display;
            font-size: 22px;
            font-weight: Theme.weight-semibold;
            font-italic: true;
            wrap: word-wrap;
        }

        Text {
            text: root.author;
            color: Theme.text-tertiary;
            font-family: Theme.font-ui;
            font-size: 12px;
            font-weight: Theme.weight-regular;
        }

        Rectangle {
            height: 2px;
            background: Theme.border-base;
        }
    }
}

