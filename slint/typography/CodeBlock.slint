import { Theme } from "../core/Theme.slint";

// Bug: the code sample was four hardcoded Text lines with no way to
// show different code at all. Exposed as a `[string] lines` array so
// any snippet (any number of lines) can be shown — same reusability
// gap fixed elsewhere in this category.
export component CodeBlock inherits Rectangle {
    in property <[string]> lines: [
        "fn main() {",
        "    let x = 42;",
        "    println!(\"{x}\");",
        "}",
    ];

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;
    horizontal-stretch: 1;

    VerticalLayout {
        padding: 16px;
        spacing: 4px;

        for line in root.lines: Text {
            text: line;
            color: Theme.text-primary;
            font-family: Theme.font-mono;
            font-size: 13px;
            font-weight: Theme.weight-regular;
        }
    }
}

