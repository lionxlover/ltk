import { Theme } from "Theme.slint";

// A single monochrome Font Awesome-style glyph, recolored via `colorize`
// so one SVG asset works in both light and dark mode (icons-and-theming.md).
export component FaIcon inherits Image {
    in property <length> fa-size: Theme.icon-md;
    in property <color> fa-color: Theme.text-primary;
    // Was previously impossible to render a disabled icon without the
    // caller hand-rolling an opacity binding at every call site; expose
    // it here once, using the same disabled-opacity token every other
    // disableable control in this library already uses.
    in property <bool> fa-disabled: false;
    // Icons are almost always decorative (the adjacent label already
    // conveys meaning to a screen reader). `accessible-role` must be a
    // compile-time *constant* in Slint (it can't be a reactive
    // expression the way accessible-label can) — an earlier version of
    // this file tried `fa-label == "" ? AccessibleRole.none :
    // AccessibleRole.image`, which is exactly the kind of runtime
    // expression the compiler rejects there, and broke every file that
    // transitively imports FaIcon behind it. Image already defaults to
    // `accessible-role: image` on its own, so nothing needs to be set
    // here at all; screen readers treat an image with an empty
    // accessible-label as decorative, which is what fa-label empty
    // should mean anyway.
    in property <string> fa-label: "";

    width: fa-size;
    height: fa-size;
    colorize: fa-color;
    opacity: fa-disabled ? Theme.opacity-disabled : 1.0;
    image-rendering: smooth;

    accessible-label: fa-label;

    animate opacity { duration: Theme.dur-fast; easing: Theme.ease-standard; }
}
