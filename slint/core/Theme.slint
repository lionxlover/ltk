// LTK Theme Global
//
// Single source of truth for every component in this library. Semantic
// tokens below (bg-*, text-*, border-*, ...) are what components should
// bind to; the primitive palette exists mainly to define those semantics
// and for the rare case a component needs a raw hue.
//
// NOTE ON ARCHITECTURE: `design-tokens/ColorPrimitives.slint` defines the
// same hue ramps (dash-case, e.g. `slate-50`) as a standalone token layer.
// The primitives below are bound *from* that file instead of hardcoding a
// second copy of the hex values, so the two can no longer drift apart. The
// property names here keep their original underscore casing
// (`slate_500`, not `slate-500`) for backward compatibility with existing
// callers (see feedback/Snackbar.slint, media/LivestreamPill.slint, and the
// chart components) — only the *source of the value* changed, not the API.
import { ColorPrimitives } from "../design-tokens/ColorPrimitives.slint";
import { TouchTarget } from "../design-tokens/TouchTarget.slint";

export global Theme {
    // ═══════════════════════════════════════════
    // THEME MODE
    // ═══════════════════════════════════════════
    in-out property <bool> dark-mode: true;

    // ═══════════════════════════════════════════
    // PRIMITIVE PALETTES
    // (sourced from design-tokens/ColorPrimitives.slint — see note above)
    // ═══════════════════════════════════════════
    out property <color> slate_50: ColorPrimitives.slate-50;
    out property <color> slate_100: ColorPrimitives.slate-100;
    out property <color> slate_200: ColorPrimitives.slate-200;
    out property <color> slate_300: ColorPrimitives.slate-300;
    out property <color> slate_400: ColorPrimitives.slate-400;
    out property <color> slate_500: ColorPrimitives.slate-500;
    out property <color> slate_600: ColorPrimitives.slate-600;
    out property <color> slate_700: ColorPrimitives.slate-700;
    out property <color> slate_800: ColorPrimitives.slate-800;
    out property <color> slate_900: ColorPrimitives.slate-900;
    out property <color> slate_950: ColorPrimitives.slate-950;

    out property <color> blue_50: ColorPrimitives.blue-50;
    out property <color> blue_100: ColorPrimitives.blue-100;
    out property <color> blue_200: ColorPrimitives.blue-200;
    out property <color> blue_300: ColorPrimitives.blue-300;
    out property <color> blue_400: ColorPrimitives.blue-400;
    out property <color> blue_500: ColorPrimitives.blue-500;
    out property <color> blue_600: ColorPrimitives.blue-600;
    out property <color> blue_700: ColorPrimitives.blue-700;
    out property <color> blue_800: ColorPrimitives.blue-800;
    out property <color> blue_900: ColorPrimitives.blue-900;

    out property <color> violet_50: ColorPrimitives.violet-50;
    out property <color> violet_100: ColorPrimitives.violet-100;
    out property <color> violet_200: ColorPrimitives.violet-200;
    out property <color> violet_300: ColorPrimitives.violet-300;
    out property <color> violet_400: ColorPrimitives.violet-400;
    out property <color> violet_500: ColorPrimitives.violet-500;
    out property <color> violet_600: ColorPrimitives.violet-600;
    out property <color> violet_700: ColorPrimitives.violet-700;
    out property <color> violet_800: ColorPrimitives.violet-800;
    out property <color> violet_900: ColorPrimitives.violet-900;

    out property <color> cyan_400: ColorPrimitives.cyan-400;
    out property <color> cyan_500: ColorPrimitives.cyan-500;
    out property <color> cyan_600: ColorPrimitives.cyan-600;
    out property <color> cyan_700: ColorPrimitives.cyan-700;

    out property <color> green_50: ColorPrimitives.green-50;
    out property <color> green_100: ColorPrimitives.green-100;
    out property <color> green_200: ColorPrimitives.green-200;
    out property <color> green_300: ColorPrimitives.green-300;
    out property <color> green_400: ColorPrimitives.green-400;
    out property <color> green_500: ColorPrimitives.green-500;
    out property <color> green_600: ColorPrimitives.green-600;
    out property <color> green_700: ColorPrimitives.green-700;
    out property <color> green_800: ColorPrimitives.green-800;

    out property <color> amber_50: ColorPrimitives.amber-50;
    out property <color> amber_100: ColorPrimitives.amber-100;
    out property <color> amber_200: ColorPrimitives.amber-200;
    out property <color> amber_300: ColorPrimitives.amber-300;
    out property <color> amber_400: ColorPrimitives.amber-400;
    out property <color> amber_500: ColorPrimitives.amber-500;
    out property <color> amber_600: ColorPrimitives.amber-600;

    out property <color> red_50: ColorPrimitives.red-50;
    out property <color> red_100: ColorPrimitives.red-100;
    out property <color> red_200: ColorPrimitives.red-200;
    out property <color> red_300: ColorPrimitives.red-300;
    out property <color> red_400: ColorPrimitives.red-400;
    out property <color> red_500: ColorPrimitives.red-500;
    out property <color> red_600: ColorPrimitives.red-600;
    out property <color> red_700: ColorPrimitives.red-700;
    out property <color> red_800: ColorPrimitives.red-800;

    out property <color> orange_400: ColorPrimitives.orange-400;
    out property <color> orange_500: ColorPrimitives.orange-500;
    out property <color> orange_600: ColorPrimitives.orange-600;

    out property <color> pink_400: ColorPrimitives.pink-400;
    out property <color> pink_500: ColorPrimitives.pink-500;
    out property <color> pink_600: ColorPrimitives.pink-600;

    // ═══════════════════════════════════════════
    // ACCENT PALETTE
    // ═══════════════════════════════════════════
    out property <color> accent: #5B9DFA;
    out property <color> accent-dim: #3B7DD8;
    out property <color> accent-glow: #5B9DFA44;
    out property <color> accent-subtle: #5B9DFA1A;
    out property <color> on-accent: #ffffff;

    // Named Swatches
    out property <color> swatch-blue: #5B9DFA;
    out property <color> swatch-purple: #9D7AFA;
    out property <color> swatch-pink: #F472B6;
    out property <color> swatch-red: #F28B82;
    out property <color> swatch-orange: #FB923C;
    out property <color> swatch-yellow: #FBBF24;
    out property <color> swatch-green: #5EE29A;
    out property <color> swatch-graphite: #8B8FA8;

    // ═══════════════════════════════════════════
    // SURFACE COLORS — Dark/Light
    // ═══════════════════════════════════════════
    out property <color> bg-base: dark-mode ? #0B0D0F : #f5f6f8;
    out property <color> bg-surface: dark-mode ? #15171B : #ffffff;
    out property <color> bg-raised: dark-mode ? #1C1F25 : #f8f9fb;
    out property <color> bg-overlay: dark-mode ? #24272F : #f0f1f4;
    out property <color> bg-headerbar: dark-mode ? #12141A : #ebedf0;
    out property <color> bg-sidebar: dark-mode ? #0F1115 : #f2f3f5;
    out property <color> bg-elevated: dark-mode ? #1a1f2e : #ffffff;
    out property <color> bg-scrim: dark-mode ? rgba(0, 0, 0, 0.6) : rgba(0, 0, 0, 0.04);

    // Glass
    out property <color> glass-thin: dark-mode ? rgba(21, 23, 27, 0.40) : rgba(255, 255, 255, 0.40);
    out property <color> glass-regular: dark-mode ? rgba(21, 23, 27, 0.67) : rgba(255, 255, 255, 0.67);
    out property <color> glass-thick: dark-mode ? rgba(21, 23, 27, 0.85) : rgba(255, 255, 255, 0.85);
    out property <color> glass-bg: dark-mode ? rgba(18, 21, 30, 0.72) : rgba(255, 255, 255, 0.72);
    out property <color> glass-border: dark-mode ? rgba(255, 255, 255, 0.10) : rgba(0, 0, 0, 0.08);

    // ═══════════════════════════════════════════
    // SEMANTIC TOKENS — Dark/Light
    // ═══════════════════════════════════════════
    out property <color> btn-primary-bg: dark-mode ? #5B9DFA : #2563eb;
    out property <color> btn-primary-bg-hover: dark-mode ? #3B7DD8 : #1d4ed8;
    out property <color> btn-primary-bg-pressed: dark-mode ? #3B7DD8 : #1d4ed8;
    out property <color> btn-disabled-bg: dark-mode ? #2b3440 : #e2e5ea;
    out property <color> btn-disabled-text: dark-mode ? #6B7280 : #71767f;

    out property <color> surface-base: dark-mode ? #15171B : #ffffff;
    out property <color> surface-hover: dark-mode ? #111318 : #eceef2;
    out property <color> surface-pressed: dark-mode ? #0D0F12 : #e2e5ea;
    out property <color> surface-elevated: dark-mode ? #1a1f2e : #ffffff;
    out property <color> surface-overlay: dark-mode ? rgba(0, 0, 0, 0.6) : rgba(0, 0, 0, 0.04);

    // Text
    out property <color> text-primary: dark-mode ? #F1F2F5 : #0f172a;
    out property <color> text-secondary: dark-mode ? #9CA3AF : #64748b;
    out property <color> text-tertiary: dark-mode ? #6B7280 : #94a3b8;
    out property <color> text-disabled: dark-mode ? #4B5563 : #9ca3af;
    out property <color> text-on-accent: #ffffff;
    // Sibling on-* tokens for the other saturated button/badge backgrounds
    // (error/success/warning). Several button components previously
    // hardcoded raw #ffffff / #000000 for this instead of a Theme token —
    // see buttons/PrimaryButton.slint etc. Warning intentionally resolves
    // to a *dark* foreground: amber/yellow backgrounds fail WCAG contrast
    // against white text, so pairing them with near-black text is the
    // correct accessible choice, not an inconsistency to "fix" to white.
    out property <color> text-on-error: #ffffff;
    out property <color> text-on-success: #ffffff;
    out property <color> text-on-warning: #1a1400;
    out property <color> text-inverse: dark-mode ? #0f172a : #f8fafc;
    out property <color> text-link: dark-mode ? #60a5fa : #2563eb;
    out property <color> text-placeholder: dark-mode ? #4B5563 : #9ca3af;

    // Border widths — 477 call sites across this library currently
    // hardcode `border-width: 1px` as a literal rather than a token; this
    // scale gives new components (and this batch's button fixes) a named
    // value instead of adding literal #478.
    out property <length> border-width-hairline: 0.5px;
    out property <length> border-width-thin: 1px;
    out property <length> border-width-medium: 2px;
    out property <length> border-width-thick: 3px;

    // Borders
    out property <color> border-subtle: dark-mode ? rgba(255, 255, 255, 0.06) : rgba(0, 0, 0, 0.06);
    out property <color> border-base: dark-mode ? rgba(255, 255, 255, 0.10) : rgba(0, 0, 0, 0.10);
    out property <color> border-strong: dark-mode ? rgba(255, 255, 255, 0.18) : rgba(0, 0, 0, 0.16);
    out property <color> border-focus: dark-mode ? #5B9DFA : #2563eb;
    out property <color> border-error: dark-mode ? #F28B82 : #dc2626;
    out property <color> border-default: dark-mode ? rgba(255, 255, 255, 0.08) : rgba(0, 0, 0, 0.08);
    out property <color> border-dashed: dark-mode ? rgba(255, 255, 255, 0.15) : rgba(0, 0, 0, 0.15);

    // State
    out property <color> state-success: dark-mode ? #5EE29A : #15803d;
    out property <color> state-warning: dark-mode ? #FBBF24 : #92400e;
    out property <color> state-error: dark-mode ? #F28B82 : #dc2626;
    out property <color> state-info: dark-mode ? #5B9DFA : #2563eb;
    out property <color> error: dark-mode ? #F28B82 : #dc2626;
    out property <color> success: dark-mode ? #5EE29A : #15803d;
    out property <color> warning: dark-mode ? #FBBF24 : #92400e;

    // Traffic lights
    out property <color> traffic-close: #FF5F57;
    out property <color> traffic-minimize: #FFBD2E;
    out property <color> traffic-zoom: #28C840;
    out property <color> traffic-inactive: #3A3D45;

    // Focus ring
    out property <color> focus-ring: dark-mode ? #5B9DFA40 : rgba(37, 99, 235, 0.25);

    // Selection
    out property <color> selection-bg: dark-mode ? #3b82f6 : #2563eb;
    out property <color> selection-text: #ffffff;

    // Divider
    out property <color> divider: dark-mode ? rgba(255, 255, 255, 0.06) : rgba(0, 0, 0, 0.06);

    // Backdrop
    out property <color> backdrop: dark-mode ? rgba(0, 0, 0, 0.7) : rgba(0, 0, 0, 0.4);

    // ═══════════════════════════════════════════
    // SPACING (8px grid)
    // ═══════════════════════════════════════════
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;
    out property <length> space-2xl: 32px;
    out property <length> space-3xl: 48px;

    // Granular scale
    out property <length> sp-0: 0px;
    out property <length> sp-0-5: 2px;
    out property <length> sp-1: 4px;
    out property <length> sp-1-5: 6px;
    out property <length> sp-2: 8px;
    out property <length> sp-2-5: 10px;
    out property <length> sp-3: 12px;
    out property <length> sp-4: 16px;
    out property <length> sp-5: 20px;
    out property <length> sp-6: 24px;
    out property <length> sp-7: 28px;
    out property <length> sp-8: 32px;
    out property <length> sp-10: 40px;

    // Gutters
    out property <length> gutter-sm: 8px;
    out property <length> gutter-md: 12px;
    out property <length> gutter-lg: 16px;
    out property <length> gutter-xl: 24px;

    // Section
    out property <length> section-sm: 16px;
    out property <length> section-md: 24px;
    out property <length> section-lg: 32px;

    // ═══════════════════════════════════════════
    // BORDER RADIUS
    // ═══════════════════════════════════════════
    out property <length> radius-xs: 3px;
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 14px;
    out property <length> radius-xl: 18px;
    out property <length> radius-2xl: 24px;
    out property <length> radius-full: 9999px;

    // Component radius
    out property <length> radius-button: 8px;
    out property <length> radius-button-pill: 9999px;
    out property <length> radius-input: 8px;
    out property <length> radius-card: 12px;
    out property <length> radius-dialog: 16px;
    out property <length> radius-window: 12px;
    out property <length> radius-tooltip: 6px;

    // Per-corner radius presets — for the specific components that are
    // genuinely asymmetric (a rectangle attached flush to another edge
    // should not round the corners on that edge). Bind these to Slint's
    // border-top-left-radius / border-top-right-radius /
    // border-bottom-left-radius / border-bottom-right-radius, not to the
    // uniform `border-radius` shorthand.
    //   - sheet: a bottom sheet / drawer that slides up from the screen
    //     edge — top corners rounded, bottom corners flush with the edge.
    //   - headerbar: a window title bar sitting inside a rounded window —
    //     top corners match the window radius, bottom corners are flat
    //     where it meets the content below.
    //   - tab: the active tab of a tab strip sitting atop its panel — top
    //     corners rounded, bottom corners flat where it meets the panel.
    out property <length> radius-sheet-top: 20px;
    out property <length> radius-sheet-bottom: 0px;
    out property <length> radius-headerbar-top: 12px;
    out property <length> radius-headerbar-bottom: 0px;
    out property <length> radius-tab-top: 8px;
    out property <length> radius-tab-bottom: 0px;

    // ═══════════════════════════════════════════
    // TYPOGRAPHY
    // ═══════════════════════════════════════════
    out property <string> font-ui: "Inter";
    out property <string> font-display: "Space Grotesk";
    out property <string> font-mono: "JetBrains Mono";

    // Type scale
    out property <length> text-xs: 11px;
    out property <length> text-sm: 12px;
    out property <length> text-base: 14px;
    out property <length> text-md: 15px;
    out property <length> text-lg: 16px;
    out property <length> text-xl: 18px;
    out property <length> text-2xl: 20px;
    out property <length> text-3xl: 24px;
    out property <length> text-4xl: 30px;

    // Weights
    out property <int> weight-light: 300;
    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <int> weight-bold: 700;

    // Letter spacing
    out property <length> tracking-tight: -0.2px;
    out property <length> tracking-normal: 0px;
    out property <length> tracking-wide: 0.3px;

    // ═══════════════════════════════════════════
    // SHADOW & ELEVATION
    // ═══════════════════════════════════════════
    out property <color> shadow-xs: #00000033;
    out property <color> shadow-sm: #00000055;
    out property <color> shadow-md: #00000077;
    out property <color> shadow-lg: #000000AA;

    out property <length> elevation-1-y: 1px;
    out property <length> elevation-1-blur: 3px;
    out property <color> elevation-1-color: shadow-xs;

    out property <length> elevation-2-y: 4px;
    out property <length> elevation-2-blur: 12px;
    out property <color> elevation-2-color: shadow-sm;

    out property <length> elevation-3-y: 10px;
    out property <length> elevation-3-blur: 20px;
    out property <color> elevation-3-color: shadow-md;

    // ═══════════════════════════════════════════
    // ANIMATION & MOTION
    // ═══════════════════════════════════════════
    out property <duration> dur-instant: 0ms;
    out property <duration> dur-fastest: 50ms;
    out property <duration> dur-faster: 100ms;
    out property <duration> dur-fast: 150ms;
    out property <duration> dur-normal: 200ms;
    out property <duration> dur-medium: 250ms;
    out property <duration> dur-slow: 300ms;
    out property <duration> dur-slower: 400ms;
    out property <duration> dur-slowest: 500ms;

    // Easing
    out property <easing> ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1.0);
    out property <easing> ease-soft: cubic-bezier(0.16, 1.0, 0.3, 1.0);
    out property <easing> ease-out: cubic-bezier(0.0, 0.0, 0.58, 1.0);
    out property <easing> ease-in: cubic-bezier(0.42, 0.0, 1.0, 1.0);
    out property <easing> ease-in-out: cubic-bezier(0.42, 0.0, 0.58, 1.0);
    out property <easing> ease-standard: cubic-bezier(0.4, 0.0, 0.2, 1.0);
    out property <easing> ease-decelerate: cubic-bezier(0.0, 0.0, 0.2, 1.0);
    out property <easing> ease-accelerate: cubic-bezier(0.4, 0.0, 1.0, 1.0);

    // Stagger
    out property <duration> stagger-xs: 30ms;
    out property <duration> stagger-sm: 50ms;
    out property <duration> stagger-md: 80ms;
    out property <duration> stagger-lg: 120ms;

    // ═══════════════════════════════════════════
    // COMPONENT SIZING
    // ═══════════════════════════════════════════
    out property <length> button-height-xs: 24px;
    out property <length> button-height-sm: 30px;
    out property <length> button-height-md: 36px;
    out property <length> button-height-lg: 42px;
    out property <length> button-padding-x: 14px;
    out property <length> button-padding-y: 8px;
    // WCAG / Apple HIG / Material minimum tappable target — sourced from
    // design-tokens/TouchTarget.slint so this repo has one accessibility
    // baseline instead of three unused, independently-guessed copies.
    out property <length> button-min-width: TouchTarget.min-width;
    out property <length> button-min-height: TouchTarget.min-height;

    out property <length> input-height-sm: 30px;
    out property <length> input-height-md: 36px;
    out property <length> input-height-lg: 42px;
    out property <length> input-padding-x: 12px;
    out property <length> input-padding-y: 8px;
    out property <length> input-min-width: 120px;
    out property <length> input-max-width: 480px;

    out property <length> checkbox-size-sm: 14px;
    out property <length> checkbox-size-md: 16px;
    out property <length> checkbox-size-lg: 20px;

    out property <length> toggle-width: 38px;
    out property <length> toggle-height: 22px;
    out property <length> toggle-thumb: 16px;

    out property <color> toggle-track-off: dark-mode ? #2A2D35 : #d1d5db;
    out property <color> toggle-track-disabled: dark-mode ? #1E2128 : #e5e7eb;

    out property <length> icon-sm: 14px;
    out property <length> icon-md: 16px;
    out property <length> icon-lg: 20px;
    out property <length> icon-xl: 24px;

    // Avatar sizes — a common component this library was missing a scale
    // for even though checkboxes, toggles, and icons all had one.
    out property <length> avatar-size-xs: 20px;
    out property <length> avatar-size-sm: 28px;
    out property <length> avatar-size-md: 36px;
    out property <length> avatar-size-lg: 48px;
    out property <length> avatar-size-xl: 64px;

    out property <length> toast-width: 360px;
    out property <length> toast-min-width: 280px;
    out property <length> toast-max-width: 420px;
    // Split from the single `toast-padding` (kept below for compatibility):
    // a toast pairs an icon + short text, so its horizontal inset is
    // usually roomier than its vertical inset.
    out property <length> toast-padding: 14px;
    out property <length> toast-padding-x: 14px;
    out property <length> toast-padding-y: 10px;

    out property <length> card-padding: 16px;
    out property <length> card-padding-x: 16px;
    out property <length> card-padding-y: 16px;
    out property <length> card-min-width: 160px;
    out property <length> card-max-width: 420px;

    // ═══════════════════════════════════════════
    // SIZE CONSTRAINTS — min/max for resizable surfaces
    // ═══════════════════════════════════════════
    // A dialog should never shrink below a legible width nor grow to fill
    // an ultrawide display; clamp both axes.
    out property <length> dialog-min-width: 320px;
    out property <length> dialog-max-width: 640px;
    out property <length> dialog-min-height: 160px;
    out property <length> dialog-max-height: 720px;

    // A popover/menu/dropdown should size to its content but stay within
    // sane bounds so a long menu scrolls instead of running off-screen.
    out property <length> popover-min-width: 160px;
    out property <length> popover-max-width: 320px;
    out property <length> dropdown-max-height: 320px;

    // A tooltip's whole purpose is to stay short; force-wrap past this.
    out property <length> tooltip-max-width: 240px;

    // A collapsible sidebar's usable range (below min it should auto-hide;
    // above max it starts eating into content space).
    out property <length> sidebar-min-width: 200px;
    out property <length> sidebar-max-width: 360px;
    out property <length> sidebar-collapsed-width: 56px;

    // Body text readability: very long line lengths hurt reading speed,
    // very narrow columns cause awkward wrapping — this is the classic
    // ~65-75 characters-per-line guideline expressed as a layout width.
    out property <length> content-min-width: 320px;
    out property <length> content-max-width: 720px;

    // ═══════════════════════════════════════════
    // INTERACTIVE STATES
    // ═══════════════════════════════════════════
    out property <float> opacity-hover: 0.92;
    out property <float> opacity-pressed: 0.85;
    out property <float> opacity-disabled: 0.4;

    out property <color> hover-overlay: dark-mode ? rgba(255, 255, 255, 0.06) : rgba(0, 0, 0, 0.04);
    out property <color> pressed-overlay: dark-mode ? rgba(255, 255, 255, 0.10) : rgba(0, 0, 0, 0.08);

    out property <length> focus-ring-width: 2px;
    out property <length> focus-ring-offset: 2px;

    // ═══════════════════════════════════════════
    // TRANSITION PRESETS
    // ═══════════════════════════════════════════
    out property <duration> transition-fade-in: 200ms;
    out property <duration> transition-fade-out: 150ms;
    out property <duration> transition-scale-enter: 200ms;
    out property <duration> transition-scale-exit: 150ms;
    out property <duration> transition-slide-up: 300ms;
    out property <duration> transition-color: 150ms;

    // ═══════════════════════════════════════════
}
