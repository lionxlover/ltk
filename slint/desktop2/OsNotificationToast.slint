import { Theme } from "../core/Theme.slint";

export component OsNotificationToast inherits Rectangle {
    background: Theme.bg-elevated;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-default;
    clip: true;

    in property <string> app-name: "System";
    in property <string> title: "Notification";
    in property <string> body: "";
    in property <string> icon: "🔔";
    in property <bool> show-close: true;

    callback dismissed();

    width: 340px;
    height: 80px;

    HorizontalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-3;

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: Theme.bg-overlay;
            y: 4px;

            Text {
                text: icon;
                font-size: 18px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 2px;
            y: 4px;

            Text {
                text: app-name;
                font-size: Theme.text-xs;
                color: Theme.text-tertiary;
            }

            Text {
                text: title;
                font-size: Theme.text-sm;
                font-weight: Theme.weight-semibold;
                color: Theme.text-primary;
            }

            if body != "": Text {
                text: body;
                font-size: Theme.text-xs;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }

        if show-close: Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: close-area.has-hover ? Theme.hover-overlay : transparent;
            y: 4px;

            Text {
                text: "×";
                font-size: 12px;
                color: Theme.text-tertiary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            close-area := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.dismissed(); }
            }
        }
    }
}
