import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component SpotlightDialog inherits Rectangle {
    background: Theme.bg-scrim;
    clip: true;

    in property <string> placeholder: "Search apps, files, commands...";
    in-out property <string> query: "";

    callback accepted(string);

    Rectangle {
        width: 560px;
        height: 64px;
        background: Theme.bg-elevated;
        border-radius: Theme.radius-xl;
        border-width: 1px;
        border-color: Theme.border-default;
        x: (parent.width - self.width) / 2;
        y: parent.height / 3;

        HorizontalLayout {
            padding-left: Theme.sp-4;
            padding-right: Theme.sp-4;
            spacing: Theme.sp-3;

            FaIcon {
                source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/magnifying-glass.svg");
                fa-size: 18px;
                fa-color: Theme.text-tertiary;
                y: (parent.height - self.height) / 2;
            }

            search-input := TextInput {
                text <=> root.query;
                font-size: Theme.text-lg;
                color: Theme.text-primary;
                vertical-alignment: center;
                vertical-stretch: 1;
                single-line: true;
                accepted => { root.accepted(self.text); }
            }

            placeholder-text := Text {
                x: search-input.x;
                text: root.placeholder;
                font-size: Theme.text-lg;
                color: Theme.text-tertiary;
                vertical-alignment: center;
                visible: root.query == "" && !search-input.has-focus;
                overflow: elide;
            }
        }
    }

    Rectangle {
        width: 560px;
        height: 200px;
        background: Theme.bg-elevated;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border-default;
        x: (parent.width - self.width) / 2;
        y: parent.height / 3 + 72px;

        @children
    }
}
