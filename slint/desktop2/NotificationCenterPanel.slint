import { Theme } from "../core/Theme.slint";

export component NotificationCenterPanel inherits Rectangle {
    background: Theme.bg-elevated;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-default;
    clip: true;

    in property <length> panel-width: 360px;
    in property <int> notification-count: 3;

    width: panel-width;

    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: 48px;
            border-radius: Theme.radius-lg;

            HorizontalLayout {
                padding-left: Theme.sp-4;
                padding-right: Theme.sp-4;

                Text {
                    text: "Notifications";
                    font-size: Theme.text-base;
                    font-weight: Theme.weight-semibold;
                    color: Theme.text-primary;
                    y: (parent.height - self.height) / 2;
                    vertical-stretch: 1;
                }

                if notification-count > 0: Rectangle {
                    height: 20px;
                    border-radius: 10px;
                    background: Theme.accent;
                    y: 14px;

                    Text {
                        text: "\{Math.mod(notification_count, 10)}";
                        font-size: Theme.text-xs;
                        font-weight: Theme.weight-bold;
                        color: #ffffff;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.border-default;
        }

        for notif[n] in notification-count: Rectangle {
            height: 64px;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border-subtle;
            }

            HorizontalLayout {
                padding: Theme.sp-3;
                spacing: Theme.sp-3;

                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: Theme.bg-overlay;
                    y: 8px;

                    Text {
                        text: "🔔";
                        font-size: 14px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 2px;
                    y: 10px;

                    Text {
                        text: "Notification " + Math.mod(n + 1, 10);
                        font-size: Theme.text-sm;
                        font-weight: Theme.weight-medium;
                        color: Theme.text-primary;
                    }

                    Text {
                        text: "This is a notification message";
                        font-size: Theme.text-xs;
                        color: Theme.text-tertiary;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
