import { Theme } from "../core/Theme.slint";

export component PreferencesWindow inherits Rectangle {
    background: Theme.bg-surface;
    border-radius: Theme.radius-window;
    border-width: 1px;
    border-color: Theme.border-default;
    clip: true;

    in property <length> sidebar-width: 180px;
    in property <length> win-width: 640px;
    in property <length> win-height: 480px;
    in property <[string]> sections: ["General", "Appearance", "Keyboard", "Privacy", "Advanced"];
    in-out property <int> active-section: 0;

    callback section-selected(int);

    width: win-width;
    height: win-height;

    VerticalLayout {
        Rectangle {
            height: 38px;
            background: Theme.bg-headerbar;
            border-radius: Theme.radius-window;

            HorizontalLayout {
                padding-left: Theme.sp-3;
                padding-right: Theme.sp-3;

                Rectangle { width: 12px; height: 12px; border-radius: 6px; background: Theme.traffic-close; y: 13px; }
                Rectangle { width: 12px; height: 12px; border-radius: 6px; background: Theme.traffic-minimize; y: 13px; }
                Rectangle { width: 12px; height: 12px; border-radius: 6px; background: Theme.traffic-zoom; y: 13px; }

                Text {
                    text: "Preferences";
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-medium;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;

            Rectangle {
                width: sidebar-width;
                background: Theme.bg-overlay;

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.border-default;
                }

                VerticalLayout {
                    padding: Theme.sp-2;
                    spacing: Theme.sp-1;

                    for item[idx] in root.sections: Rectangle {
                        height: 32px;
                        border-radius: Theme.radius-sm;
                        background: root.active-section == idx ? Theme.accent-subtle : (section-area.has-hover ? Theme.hover-overlay : transparent);

                        HorizontalLayout {
                            padding-left: Theme.sp-3;
                            Text {
                                text: item;
                                font-size: Theme.text-sm;
                                color: root.active-section == idx ? Theme.accent : Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        section-area := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.active-section = idx;
                                root.section-selected(idx);
                            }
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-surface;
                HorizontalLayout {
                    padding: Theme.sp-4;
                    @children
                }
            }
        }
    }
}
