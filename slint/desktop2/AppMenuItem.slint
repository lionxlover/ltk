import { Theme } from "../core/Theme.slint";

export component AppMenuItem inherits Rectangle {
    background: item-area.has-hover ? Theme.hover-overlay : transparent;
    height: 28px;

    in property <string> label: "";
    in property <string> shortcut: "";
    in property <bool> show-check: false;
    in property <bool> checked: false;
    in property <bool> danger: false;

    callback clicked();

    HorizontalLayout {
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-3;
        spacing: Theme.sp-3;

        if show-check: Text {
            text: checked ? "✓" : "";
            font-size: Theme.text-sm;
            color: Theme.text-primary;
            width: 16px;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: label;
            font-size: Theme.text-sm;
            color: danger ? Theme.error : Theme.text-primary;
            vertical-stretch: 1;
            y: (parent.height - self.height) / 2;
            overflow: elide;
        }

        if shortcut != "": Text {
            text: shortcut;
            font-size: Theme.text-xs;
            color: Theme.text-tertiary;
            y: (parent.height - self.height) / 2;
        }
    }

    Rectangle {
        height: 1px;
        y: parent.height - 1px;
        background: Theme.border-default;
    }

    item-area := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}
