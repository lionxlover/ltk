import { Theme } from "../core/Theme.slint";

export component SkipLink inherits Rectangle {
    in property <string> target: "";

    visible: false;
    height: 36px;
    background: Theme.accent;
    border-radius: Theme.radius-sm;
    z: 9999;

    TouchArea {
        clicked => {
            root.visible = false;
        }
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == "tab" || event.text == "enter" || event.text == " ") {
                root.visible = true;
                return accept;
            }
            reject;
        }
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 16px;
        padding-right: 16px;

        Text {
            text: "Skip to content";
            color: Theme.on-accent;
            font-size: Theme.text-base;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
        }
    }
}
