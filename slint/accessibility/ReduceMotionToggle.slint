import { Theme } from "../core/Theme.slint";
import { SrOnlyText } from "SrOnlyText.slint";

export component ReduceMotionToggle inherits Rectangle {
    in-out property <bool> active: false;

    height: Theme.toggle-height;
    width: Theme.toggle-width;
    background: active ? Theme.accent : Theme.toggle-track-off;
    border-radius: self.height / 2;

    TouchArea {
        clicked => {
            root.active = !root.active;
        }
    }

    Rectangle {
        x: parent.active ? parent.width - Theme.toggle-thumb - 3px : 3px;
        width: Theme.toggle-thumb;
        height: Theme.toggle-thumb;
        background: Theme.on-accent;
        border-radius: Theme.radius-full;
    }

    HorizontalLayout {
        padding-left: Theme.sp-2;
        padding-right: Theme.sp-2;
        alignment: center;

        SrOnlyText {
            text: "Reduce Motion";
        }
    }
}
