import { Theme } from "../core/Theme.slint";

export component VoiceSpeechInput inherits Rectangle {
    in-out property <bool> recording: false;
    in-out property <string> transcript: "";
    out property <bool> has-focus: input.has-focus;

    // Real speech-to-text is a platform/host capability outside what
    // .slint alone can do — this signals record start/stop so the host
    // can run its own recognizer and write results into `transcript`,
    // which the person can also correct here by typing directly.
    callback recording-toggled(bool);

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: recording ? Theme.error : (has-focus ? Theme.accent : Theme.border-base);
    height: 40px;
    horizontal-stretch: 1;

    Rectangle {
        x: 4px;
        y: (parent.height - 28px) / 2;
        width: 28px;
        height: 28px;
        border-radius: Theme.radius-full;
        background: recording ? Theme.error : Theme.bg-raised;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: "🎙";
            font-size: 13px;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => {
                root.recording = !root.recording;
                root.recording-toggled(root.recording);
            }
        }
    }

    TouchArea {
        clicked => { input.focus(); }
    }

    if root.transcript == "" && !input.has-focus: Text {
        x: 40px;
        y: (parent.height - self.height) / 2;
        text: root.recording ? "Listening..." : "Tap mic to speak, or type here";
        color: Theme.text-placeholder;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }

    input := TextInput {
        x: 40px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 52px;
        text <=> root.transcript;
        color: Theme.text-primary;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }
}
