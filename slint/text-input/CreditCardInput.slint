import { Theme } from "../core/Theme.slint";

export component CreditCardInput inherits Rectangle {
    in-out property <string> card-number;
    in-out property <string> placeholder: "1234  5678  9012  3456";
    out property <bool> has-focus: input.has-focus;

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 48px;
    horizontal-stretch: 1;

    TouchArea {
        clicked => { input.focus(); }
    }

    // Card brand icon
    Rectangle {
        x: 12px;
        y: (parent.height - 28px) / 2;
        width: 40px;
        height: 28px;
        border-radius: Theme.radius-sm;
        background: Theme.bg-raised;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: "◈";
            color: Theme.accent;
            font-size: 16px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    if root.card-number == "" && !input.has-focus: Text {
        x: 64px;
        y: (parent.height - self.height) / 2;
        text: root.placeholder;
        color: Theme.text-placeholder;
        font-family: Theme.font-mono;
        font-size: 16px;
        letter-spacing: 2px;
        vertical-alignment: center;
    }

    input := TextInput {
        x: 64px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 76px;
        text <=> root.card-number;
        color: Theme.text-primary;
        font-family: Theme.font-mono;
        font-size: 16px;
        letter-spacing: 2px;
        vertical-alignment: center;
        // Digit-group auto-formatting (inserting spaces every 4 digits
        // as the person types) would need string slicing, which Slint
        // doesn't support (see SLINT-GOTCHAS-DISCOVERED.md — no
        // substring/indexing on strings) — the host is responsible for
        // formatting `card-number` before displaying/submitting it.
    }
}
