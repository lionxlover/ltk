import { Theme } from "../core/Theme.slint";

export component EmojiPickerInput inherits Rectangle {
    in-out property <string> text;
    in-out property <bool> has-focus: false;

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;


    Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: root.text == "" ? "😊" : root.text;
        font-size: 18px;
        vertical-alignment: center;
    }

    Text {
        x: 40px;
        y: (parent.height - self.height) / 2;
        text: root.text == "" ? "Pick an emoji" : root.text;
        color: root.text == "" ? Theme.text-placeholder : Theme.text-primary;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }

    // Common emojis
    HorizontalLayout {
        x: parent.width - 180px;
        spacing: 4px;
        alignment: end;

        for e in ["😊", "❤️", "👍", "🎉", "🔥", "⭐"]: Text {
            text: e;
            font-size: 16px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.has-focus = true; }
    }
}
