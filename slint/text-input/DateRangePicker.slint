import { Theme } from "../core/Theme.slint";

export component DateRangePicker inherits Rectangle {
    in-out property <string> start-date;
    in-out property <string> end-date;
    out property <bool> has-focus: start-input.has-focus || end-input.has-focus;

    callback calendar-clicked();

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;

    Rectangle {
        x: 4px;
        y: (parent.height - 28px) / 2;
        width: 28px;
        height: 28px;
        border-radius: Theme.radius-sm;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: "📅";
            font-size: 14px;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { root.calendar-clicked(); }
        }
    }

    TouchArea {
        clicked => { start-input.focus(); }
    }

    if root.start-date == "" && !start-input.has-focus: Text {
        x: 36px;
        y: (parent.height - self.height) / 2;
        text: "Start date";
        color: Theme.text-placeholder;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }

    start-input := TextInput {
        x: 36px;
        y: (parent.height - self.height) / 2;
        width: 90px;
        text <=> root.start-date;
        color: Theme.text-primary;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }

    // Arrow
    Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: "→";
        color: Theme.text-tertiary;
        font-size: 14px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    TouchArea {
        x: parent.width - 130px;
        width: 120px;
        clicked => { end-input.focus(); }
    }

    if root.end-date == "" && !end-input.has-focus: Text {
        x: parent.width - 130px;
        y: (parent.height - self.height) / 2;
        text: "End date";
        color: Theme.text-placeholder;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }

    end-input := TextInput {
        x: parent.width - 130px;
        y: (parent.height - self.height) / 2;
        width: 118px;
        text <=> root.end-date;
        color: Theme.text-primary;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }
}
