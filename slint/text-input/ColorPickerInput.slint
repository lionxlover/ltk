import { Theme } from "../core/Theme.slint";

export component ColorPickerInput inherits Rectangle {
    in-out property <color> current-color: Theme.accent;
    in-out property <string> hex-text: "#5B9DFA";
    in-out property <int> active-tab: 0;
    out property <bool> has-focus: input.has-focus;

    // Opening a real color wheel/swatch-picker popup is out of scope for
    // a text field — this signals the host to show one.
    callback swatch-clicked();

    property <[string]> formats: ["HEX", "RGB", "HSL", "OKLCH"];

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;

    // Color swatch
    Rectangle {
        x: 8px;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        border-radius: Theme.radius-sm;
        background: root.current-color;
        border-width: 1px;
        border-color: Theme.border-base;

        TouchArea {
            clicked => { root.swatch-clicked(); }
        }
    }

    TouchArea {
        clicked => { input.focus(); }
    }

    input := TextInput {
        x: 40px;
        y: (parent.height - self.height) / 2;
        width: 108px;
        text <=> root.hex-text;
        color: Theme.text-primary;
        font-family: Theme.font-mono;
        font-size: 13px;
        vertical-alignment: center;
    }

    // Format tabs
    Rectangle {
        x: parent.width - 160px;
        y: (parent.height - 28px) / 2;
        width: 152px;
        height: 28px;
        border-radius: Theme.radius-sm;
        background: Theme.bg-raised;

        HorizontalLayout {
            padding: 2px;
            spacing: 2px;

            for tabitem[idx] in root.formats: Rectangle {
                horizontal-stretch: 1;
                border-radius: 4px;
                background: root.active-tab == idx ? Theme.bg-surface : transparent;

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: tabitem;
                    color: root.active-tab == idx ? Theme.text-primary : Theme.text-tertiary;
                    font-size: 9px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                TouchArea {
                    clicked => { root.active-tab = idx; }
                }
            }
        }
    }
}
