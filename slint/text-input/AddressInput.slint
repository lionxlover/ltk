import { Theme } from "../core/Theme.slint";

export component AddressInput inherits Rectangle {
    in-out property <string> street;
    in-out property <string> city;
    in-out property <string> zip;
    // Derived from the three fields' own focus state — not something a
    // host should set directly, so this is `out`, not `in-out` (an
    // in-out property with a computed expression binding would conflict
    // with external assignment).
    out property <bool> has-focus: street-input.has-focus || city-input.has-focus || zip-input.has-focus;

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    horizontal-stretch: 1;
    height: self.preferred-height;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        Text {
            text: "Address";
            color: Theme.text-secondary;
            font-size: 12px;
            font-weight: Theme.weight-semibold;
        }

        Rectangle {
            height: 36px;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: street-input.has-focus ? Theme.accent : Theme.border-base;

            TouchArea {
                clicked => { street-input.focus(); }
            }

            if root.street == "" && !street-input.has-focus: Text {
                x: 10px;
                y: (parent.height - self.height) / 2;
                text: "Street address";
                color: Theme.text-placeholder;
                font-size: 13px;
                vertical-alignment: center;
            }

            street-input := TextInput {
                x: 10px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 20px;
                text <=> root.street;
                color: Theme.text-primary;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 8px;

            Rectangle {
                horizontal-stretch: 2;
                height: 36px;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: city-input.has-focus ? Theme.accent : Theme.border-base;

                TouchArea {
                    clicked => { city-input.focus(); }
                }

                if root.city == "" && !city-input.has-focus: Text {
                    x: 10px;
                    y: (parent.height - self.height) / 2;
                    text: "City";
                    color: Theme.text-placeholder;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                city-input := TextInput {
                    x: 10px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 20px;
                    text <=> root.city;
                    color: Theme.text-primary;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 36px;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: zip-input.has-focus ? Theme.accent : Theme.border-base;

                TouchArea {
                    clicked => { zip-input.focus(); }
                }

                if root.zip == "" && !zip-input.has-focus: Text {
                    x: 10px;
                    y: (parent.height - self.height) / 2;
                    text: "ZIP";
                    color: Theme.text-placeholder;
                    font-size: 13px;
                    vertical-alignment: center;
                }

                zip-input := TextInput {
                    x: 10px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 20px;
                    text <=> root.zip;
                    color: Theme.text-primary;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
