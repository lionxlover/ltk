import { Theme } from "../core/Theme.slint";

export component FontPickerInput inherits Rectangle {
    in-out property <string> selected-font: "Inter";
    in-out property <bool> has-focus: false;

    // A real font-list dropdown needs to enumerate installed/available
    // fonts (host-side data), so this just signals the tap; the host
    // shows its own popup and sets `selected-font` back.
    callback clicked();

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;

    Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: root.selected-font;
        color: Theme.text-primary;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 24px;
        y: (parent.height - self.height) / 2;
        text: "▾";
        color: Theme.text-tertiary;
        font-size: 12px;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => {
            root.has-focus = !root.has-focus;
            root.clicked();
        }
    }
}
