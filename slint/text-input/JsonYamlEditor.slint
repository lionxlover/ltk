import { Theme } from "../core/Theme.slint";

// Real JSON/YAML validation (parsing and checking syntax as the person
// types) is a substantial feature on its own — `valid` stays a plain
// `in` property the host sets after its own validation, same as before;
// what's fixed here is that the content area is now genuinely editable
// instead of frozen static text.
export component JsonYamlEditor inherits Rectangle {
    in-out property <string> text: "{\n  \"name\": \"LTK\",\n  \"version\": \"1.0\"\n}";
    in property <bool> valid: true;
    out property <bool> has-focus <=> input.has-focus;
    in-out property <int> active-tab: 0;

    background: Theme.bg-base;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : (root.valid ? Theme.border-base : Theme.error);
    height: 200px;
    horizontal-stretch: 1;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 32px;
        background: Theme.bg-raised;

        HorizontalLayout {
            padding-left: 8px;
            spacing: 4px;
            alignment: start;

            for tabitem[idx] in ["JSON", "YAML"]: Rectangle {
                width: 60px;
                height: 24px;
                border-radius: 4px;
                background: root.active-tab == idx ? Theme.bg-surface : transparent;
                vertical-stretch: 0;

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: tabitem;
                    color: root.active-tab == idx ? Theme.text-primary : Theme.text-tertiary;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                TouchArea {
                    clicked => { root.active-tab = idx; }
                }
            }
        }

        Rectangle {
            x: parent.width - 24px;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: root.valid ? Theme.success : Theme.error;
        }
    }

    TouchArea {
        y: 32px;
        height: parent.height - 32px;
        clicked => { input.focus(); }
    }

    Flickable {
        x: 12px;
        y: 44px;
        width: parent.width - 24px;
        height: parent.height - 56px;
        viewport-height: input.preferred-height;

        input := TextInput {
            width: parent.width;
            text <=> root.text;
            single-line: false;
            wrap: word-wrap;
            color: Theme.text-primary;
            font-family: Theme.font-mono;
            font-size: 12px;
        }
    }
}
