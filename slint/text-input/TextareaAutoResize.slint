import { Theme } from "../core/Theme.slint";

export component TextareaAutoResize inherits Rectangle {
    in-out property <string> text;
    in-out property <string> placeholder: "Start typing...";
    out property <bool> has-focus: input.has-focus;

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    min-height: max(80px, input.preferred-height + 24px);
    horizontal-stretch: 1;

    TouchArea {
        clicked => { input.focus(); }
    }

    if root.text == "" && !input.has-focus: Text {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        text: root.placeholder;
        color: Theme.text-placeholder;
        font-family: Theme.font-ui;
        font-size: 14px;
        wrap: word-wrap;
    }

    input := TextInput {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        text <=> root.text;
        single-line: false;
        wrap: word-wrap;
        color: Theme.text-primary;
        font-family: Theme.font-ui;
        font-size: 14px;
    }

    // Resize grip
    Rectangle {
        x: parent.width - 16px;
        y: parent.height - 16px;
        width: 12px;
        height: 12px;

        Text {
            text: "⋰";
            color: Theme.text-disabled;
            font-size: 10px;
        }
    }
}
