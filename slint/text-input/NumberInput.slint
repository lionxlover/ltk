import { Theme } from "../core/Theme.slint";

export component NumberInput inherits Rectangle {
    in-out property <string> text;
    in-out property <string> placeholder: "0";
    in-out property <bool> has-focus <=> input.has-focus;

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;

    TouchArea {
        clicked => { input.focus(); }
    }

    if root.text == "" && !input.has-focus: Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: root.placeholder;
        color: Theme.text-placeholder;
        font-family: Theme.font-mono;
        font-size: 14px;
        vertical-alignment: center;
    }

    input := TextInput {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 24px;
        text <=> root.text;
        input-type: InputType.decimal;
        color: Theme.text-primary;
        font-family: Theme.font-mono;
        font-size: 14px;
        vertical-alignment: center;
    }
}
