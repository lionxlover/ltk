import { Theme } from "../core/Theme.slint";

export component SignaturePad inherits Rectangle {
    in-out property <bool> has-signature: false;

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-signature ? Theme.accent : Theme.border-base;
    height: 120px;
    horizontal-stretch: 1;

    if !root.has-signature: VerticalLayout {
        alignment: center;
        spacing: 4px;

        Text {
            text: "✍";
            font-size: 24px;
            horizontal-alignment: center;
        }
        Text {
            text: "Click to sign";
            color: Theme.text-placeholder;
            font-family: Theme.font-ui;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }

    if root.has-signature: Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: "Signature captured";
        color: Theme.accent;
        font-family: Theme.font-display;
        font-size: 16px;
        font-italic: true;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    TouchArea {
        clicked => { root.has-signature = !root.has-signature; }
    }
}
