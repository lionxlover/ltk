import { Theme } from "../core/Theme.slint";

// Real syntax highlighting (tokenizing and coloring keywords, strings,
// etc. as the person types) is a substantial feature on its own — this
// is a genuinely editable plain-text code area instead of the previous
// fully hardcoded, non-editable "highlighted" text.
export component CodeEditor inherits Rectangle {
    in-out property <string> code: "fn main() {\n    let name = \"LTK\";\n    let version = 1.0;\n\n    if name == \"LTK\" {\n        println!(\"Hello, {name}!\");\n    }\n}";
    out property <bool> has-focus <=> input.has-focus;

    background: Theme.bg-base;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 280px;
    horizontal-stretch: 1;
    clip: true;

    TouchArea {
        clicked => { input.focus(); }
    }

    HorizontalLayout {
        // Line numbers
        Rectangle {
            width: 48px;
            background: Theme.bg-surface;

            VerticalLayout {
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 0px;

                // Line numbers are a fixed range (up to 40), not
                // dynamically matching the actual content's line count —
                // that would need splitting the text on "\n", which
                // Slint's string type doesn't support (no length/
                // indexing/substring; see SLINT-GOTCHAS-DISCOVERED.md).
                for ln in 40: Text {
                    horizontal-stretch: 0;
                    text: "\{ln + 1}";
                    color: Theme.text-disabled;
                    font-family: Theme.font-mono;
                    font-size: 12px;
                    horizontal-alignment: right;
                }
            }
        }

        // Code area
        Flickable {
            background: Theme.bg-base;
            viewport-height: input.preferred-height + 24px;

            input := TextInput {
                x: 12px;
                y: 12px;
                width: parent.width - 12px;
                text <=> root.code;
                single-line: false;
                wrap: no-wrap;
                color: Theme.text-primary;
                font-family: Theme.font-mono;
                font-size: 13px;
            }
        }
    }
}
