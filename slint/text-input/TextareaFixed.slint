import { Theme } from "../core/Theme.slint";

export component TextareaFixed inherits Rectangle {
    in-out property <string> text;
    in-out property <string> placeholder: "Enter text...";
    out property <bool> has-focus: input.has-focus;
    in-out property <length> input-height: 120px;

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: self.input-height;
    horizontal-stretch: 1;
    clip: true;

    TouchArea {
        clicked => { input.focus(); }
    }

    if root.text == "" && !input.has-focus: Text {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        text: root.placeholder;
        color: Theme.text-placeholder;
        font-family: Theme.font-ui;
        font-size: 14px;
        wrap: word-wrap;
    }

    Flickable {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: parent.height - 24px;
        viewport-height: input.preferred-height;

        input := TextInput {
            width: parent.width;
            text <=> root.text;
            single-line: false;
            wrap: word-wrap;
            color: Theme.text-primary;
            font-family: Theme.font-ui;
            font-size: 14px;
        }
    }
}
