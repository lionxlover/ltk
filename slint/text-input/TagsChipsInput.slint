import { Theme } from "../core/Theme.slint";

export component TagsChipsInput inherits Rectangle {
    in-out property <[string]> tags: ["react", "slint", "rust"];
    in-out property <string> text;
    in-out property <string> placeholder: "Add tag...";
    in-out property <bool> has-focus <=> input.has-focus;

    callback tag-removed(int);
    callback tag-added(string);

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;
    clip: true;

    TouchArea {
        clicked => { input.focus(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        spacing: 6px;

        for tag[idx] in root.tags: Rectangle {
            height: 28px;
            border-radius: 14px;
            background: Theme.accent-subtle;
            vertical-stretch: 0;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 6px;
                spacing: 4px;
                alignment: center;

                Text {
                    text: tag;
                    color: Theme.accent;
                    font-size: 12px;
                    font-weight: Theme.weight-medium;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;

                    Text {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        text: "✕";
                        color: Theme.accent;
                        font-size: 8px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    TouchArea {
                        clicked => { root.tag-removed(idx); }
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            min-width: 60px;

            if root.text == "" && !input.has-focus: Text {
                x: 4px;
                y: (parent.height - self.height) / 2;
                text: root.placeholder;
                color: Theme.text-placeholder;
                font-size: 13px;
                vertical-alignment: center;
            }

            input := TextInput {
                x: 4px;
                y: (parent.height - self.height) / 2;
                width: parent.width - 8px;
                text <=> root.text;
                color: Theme.text-primary;
                font-family: Theme.font-ui;
                font-size: 13px;
                vertical-alignment: center;
                accepted => {
                    if self.text != "" {
                        root.tag-added(self.text);
                        self.text = "";
                    }
                }
            }
        }
    }
}
