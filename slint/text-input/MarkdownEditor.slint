import { Theme } from "../core/Theme.slint";

// Real live-rendered Markdown preview (parsing headings, bold/italic,
// lists, etc.) is a substantial feature on its own — the "Write" tab is
// now genuinely editable; "Preview" shows the raw source rather than a
// faked rendered view, which is honest about what isn't implemented
// rather than faking a preview that doesn't actually render anything.
export component MarkdownEditor inherits Rectangle {
    in-out property <string> markdown: "# Hello World\n\nThis is a **markdown** editor with *live* preview.\n\n- Item one\n- Item two";
    in-out property <bool> preview-mode: false;
    out property <bool> has-focus: input.has-focus;

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 300px;
    horizontal-stretch: 1;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 36px;
        background: Theme.bg-raised;

        HorizontalLayout {
            padding-left: 4px;
            spacing: 2px;
            alignment: start;

            Rectangle {
                width: 80px;
                height: 28px;
                border-radius: Theme.radius-sm;
                background: !root.preview-mode ? Theme.bg-surface : transparent;
                vertical-stretch: 0;

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "Write";
                    color: !root.preview-mode ? Theme.text-primary : Theme.text-tertiary;
                    font-size: 12px;
                    font-weight: !root.preview-mode ? 600 : 400;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                TouchArea {
                    clicked => { root.preview-mode = false; }
                }
            }

            Rectangle {
                width: 80px;
                height: 28px;
                border-radius: Theme.radius-sm;
                background: root.preview-mode ? Theme.bg-surface : transparent;
                vertical-stretch: 0;

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "Preview";
                    color: root.preview-mode ? Theme.text-primary : Theme.text-tertiary;
                    font-size: 12px;
                    font-weight: root.preview-mode ? 600 : 400;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                TouchArea {
                    clicked => { root.preview-mode = true; }
                }
            }
        }
    }

    Rectangle { x: 0px; y: 36px; width: root.width; height: 1px; background: Theme.border-subtle; }

    if !root.preview-mode: TouchArea {
        y: 37px;
        height: parent.height - 37px;
        clicked => { input.focus(); }
    }

    if !root.preview-mode: Flickable {
        x: 16px;
        y: 52px;
        width: parent.width - 32px;
        height: parent.height - 68px;
        viewport-height: input.preferred-height;

        input := TextInput {
            width: parent.width;
            text <=> root.markdown;
            single-line: false;
            wrap: word-wrap;
            color: Theme.text-primary;
            font-family: Theme.font-mono;
            font-size: 13px;
        }
    }

    if root.preview-mode: Text {
        x: 16px;
        y: 52px;
        width: parent.width - 32px;
        text: root.markdown;
        color: Theme.text-primary;
        font-family: Theme.font-mono;
        font-size: 13px;
        wrap: word-wrap;
    }
}
