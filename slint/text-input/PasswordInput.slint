import { Theme } from "../core/Theme.slint";

export component PasswordInput inherits Rectangle {
    in-out property <string> text;
    in-out property <string> placeholder: "Enter password...";
    out property <bool> has-focus: input.has-focus;
    in-out property <bool> enabled: true;
    in-out property <bool> revealed: false;

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;

    TouchArea {
        enabled: root.enabled;
        clicked => { input.focus(); }
    }

    if root.text == "" && !input.has-focus: Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: root.placeholder;
        color: Theme.text-placeholder;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }

    input := TextInput {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 60px;
        text <=> root.text;
        enabled: root.enabled;
        // input-type is a real, documented TextInput property; `password`
        // is its most standard variant and is what actually masks the
        // characters — there's no other way to get masking in Slint.
        input-type: root.revealed ? InputType.text : InputType.password;
        color: Theme.text-primary;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 36px;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        border-radius: Theme.radius-sm;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: root.revealed ? "◉" : "○";
            color: Theme.text-tertiary;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        TouchArea {
            enabled: root.enabled;
            clicked => { root.revealed = !root.revealed; }
        }
    }
}
