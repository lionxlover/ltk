import { Theme } from "../core/Theme.slint";

export component PasswordInput inherits Rectangle {
    in-out property <string> text;
    in-out property <string> placeholder: "Enter password...";
    in-out property <bool> has-focus: false;
    in-out property <bool> enabled: true;
    in-out property <bool> revealed: false;

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;

    Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: root.text == "" ? root.placeholder : (root.revealed ? root.text : "••••••••");
        color: root.text == "" ? Theme.text-placeholder : Theme.text-primary;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 36px;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        border-radius: Theme.radius-sm;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: root.revealed ? "◉" : "○";
            color: Theme.text-tertiary;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        TouchArea {
            clicked => { root.revealed = !root.revealed; }
        }
    }

    TouchArea {
        clicked => { root.has-focus = true; }
    }
}
