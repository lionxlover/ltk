import { Theme } from "../core/Theme.slint";

export component MonthYearPicker inherits Rectangle {
    in-out property <string> text;
    in-out property <string> placeholder: "Select month...";
    in-out property <bool> has-focus <=> input.has-focus;

    callback calendar-clicked();

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;

    Rectangle {
        x: 4px;
        y: (parent.height - 28px) / 2;
        width: 28px;
        height: 28px;
        border-radius: Theme.radius-sm;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: "🗓";
            font-size: 14px;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { root.calendar-clicked(); }
        }
    }

    TouchArea {
        clicked => { input.focus(); }
    }

    if root.text == "" && !input.has-focus: Text {
        x: 36px;
        y: (parent.height - self.height) / 2;
        text: root.placeholder;
        color: Theme.text-placeholder;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }

    input := TextInput {
        x: 36px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 48px;
        text <=> root.text;
        color: Theme.text-primary;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }
}
