import { Theme } from "../core/Theme.slint";

// Real rich-text formatting (actually bolding/italicizing selected
// spans, embedding images/links) is a substantial feature needing a rich
// text model Slint doesn't provide natively — the toolbar buttons now
// fire a real callback with which format was requested instead of doing
// nothing, so a host could apply formatting to its own text model, but
// the content area here is honest plain-text editing.
export component RichTextEditor inherits Rectangle {
    in-out property <string> content: "";
    out property <bool> has-focus: input.has-focus;

    callback format-requested(string);

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 300px;
    horizontal-stretch: 1;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 40px;
        background: Theme.bg-raised;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 4px;
            alignment: start;

            for op in ["B", "I", "U", "S", "-", "=", "<>", "><", "Img", "Link"]: Rectangle {
                width: 32px;
                height: 28px;
                border-radius: Theme.radius-sm;
                background: op-ta.has-hover ? Theme.surface-hover : transparent;
                vertical-stretch: 0;

                animate background { duration: Theme.dur-fast; }

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: op;
                    color: Theme.text-secondary;
                    font-size: 13px;
                    font-weight: op == "B" ? 700 : 400;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }

                op-ta := TouchArea {
                    clicked => { root.format-requested(op); }
                }
            }
        }
    }

    Rectangle {
        x: 0px;
        y: 40px;
        width: parent.width;
        height: 1px;
        background: Theme.border-subtle;
    }

    TouchArea {
        y: 41px;
        height: parent.height - 41px;
        clicked => { input.focus(); }
    }

    if root.content == "" && !input.has-focus: Text {
        x: 16px;
        y: 56px;
        width: parent.width - 32px;
        text: "Start writing your rich text content here. Use the toolbar above to format text.";
        color: Theme.text-placeholder;
        font-family: Theme.font-ui;
        font-size: 14px;
        wrap: word-wrap;
    }

    Flickable {
        x: 16px;
        y: 56px;
        width: parent.width - 32px;
        height: parent.height - 72px;
        viewport-height: input.preferred-height;

        input := TextInput {
            width: parent.width;
            text <=> root.content;
            single-line: false;
            wrap: word-wrap;
            color: Theme.text-primary;
            font-family: Theme.font-ui;
            font-size: 14px;
        }
    }
}
