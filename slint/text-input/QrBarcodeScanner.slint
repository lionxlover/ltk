import { Theme } from "../core/Theme.slint";

export component QrBarcodeScanner inherits Rectangle {
    in-out property <string> scanned-text;
    in-out property <bool> scanning: false;

    background: Theme.bg-base;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-base;
    height: 200px;
    horizontal-stretch: 1;

    // Viewfinder frame
    Rectangle {
        x: (parent.width - 160px) / 2;
        y: 20px;
        width: 160px;
        height: 160px;
        border-radius: Theme.radius-md;
        border-width: 2px;
        border-color: scanning ? Theme.accent : Theme.border-base;

        // Corner accents
        Rectangle { x: 0px; y: 0px; width: 20px; height: 3px; background: Theme.accent; }
        Rectangle { x: 0px; y: 0px; width: 3px; height: 20px; background: Theme.accent; }
        Rectangle { x: parent.width - 20px; y: 0px; width: 20px; height: 3px; background: Theme.accent; }
        Rectangle { x: parent.width - 3px; y: 0px; width: 3px; height: 20px; background: Theme.accent; }
        Rectangle { x: 0px; y: parent.height - 3px; width: 20px; height: 3px; background: Theme.accent; }
        Rectangle { x: 0px; y: parent.height - 20px; width: 3px; height: 20px; background: Theme.accent; }
        Rectangle { x: parent.width - 20px; y: parent.height - 3px; width: 20px; height: 3px; background: Theme.accent; }
        Rectangle { x: parent.width - 3px; y: parent.height - 20px; width: 3px; height: 20px; background: Theme.accent; }

        // Scan line
        if scanning: Rectangle {
            x: 10px;
            y: (parent.height - 2px) / 2;
            width: parent.width - 20px;
            height: 2px;
            background: Theme.accent;
            opacity: 0.8;
        }
    }

    TouchArea {
        clicked => { root.scanning = !root.scanning; }
    }
}
