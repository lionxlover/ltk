import { Theme } from "../core/Theme.slint";

export component DateTimePicker inherits Rectangle {
    in-out property <string> date-text;
    in-out property <string> time-text;
    out property <bool> has-focus: date-input.has-focus || time-input.has-focus;

    callback calendar-clicked();
    callback clock-clicked();

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;

    Rectangle {
        x: 4px;
        y: (parent.height - 28px) / 2;
        width: 28px;
        height: 28px;
        border-radius: Theme.radius-sm;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: "📅";
            font-size: 14px;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { root.calendar-clicked(); }
        }
    }

    TouchArea {
        x: 36px;
        width: parent.width / 2 - 36px;
        clicked => { date-input.focus(); }
    }

    if root.date-text == "" && !date-input.has-focus: Text {
        x: 36px;
        y: (parent.height - self.height) / 2;
        text: "dd/mm/yyyy";
        color: Theme.text-placeholder;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }

    date-input := TextInput {
        x: 36px;
        y: (parent.height - self.height) / 2;
        width: parent.width / 2 - 44px;
        text <=> root.date-text;
        color: Theme.text-primary;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }

    // Divider
    Rectangle {
        x: parent.width / 2 - 1px;
        y: 8px;
        width: 1px;
        height: 24px;
        background: Theme.border-base;
    }

    Rectangle {
        x: parent.width / 2 + 4px;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        border-radius: Theme.radius-sm;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: "◷";
            color: Theme.text-tertiary;
            font-size: 14px;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { root.clock-clicked(); }
        }
    }

    TouchArea {
        x: parent.width / 2 + 32px;
        width: parent.width / 2 - 32px;
        clicked => { time-input.focus(); }
    }

    if root.time-text == "" && !time-input.has-focus: Text {
        x: parent.width / 2 + 32px;
        y: (parent.height - self.height) / 2;
        text: "hh:mm";
        color: Theme.text-placeholder;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }

    time-input := TextInput {
        x: parent.width / 2 + 32px;
        y: (parent.height - self.height) / 2;
        width: parent.width / 2 - 40px;
        text <=> root.time-text;
        color: Theme.text-primary;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }
}
