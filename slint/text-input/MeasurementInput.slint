import { Theme } from "../core/Theme.slint";

export component MeasurementInput inherits Rectangle {
    in-out property <string> text;
    in-out property <string> unit: "px";
    in-out property <string> placeholder: "0";
    in-out property <bool> has-focus: false;

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;


    Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: root.text == "" ? root.placeholder : root.text;
        color: root.text == "" ? Theme.text-placeholder : Theme.text-primary;
        font-family: Theme.font-mono;
        font-size: 14px;
        vertical-alignment: center;
    }

    // Unit badge
    Rectangle {
        x: parent.width - 44px;
        y: (parent.height - 26px) / 2;
        width: 36px;
        height: 26px;
        border-radius: Theme.radius-sm;
        background: Theme.bg-raised;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: root.unit;
            color: Theme.text-secondary;
            font-family: Theme.font-mono;
            font-size: 11px;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        TouchArea {
            clicked => { }
        }
    }

    TouchArea {
        clicked => { root.has-focus = true; }
    }
}
