import { Theme } from "../core/Theme.slint";

// Real typing, using this project's own established pattern for
// per-character fields (SLINT-GOTCHAS-DISCOVERED.md: strings have no
// length/indexing/slicing, so a single string can't be split into boxes
// — use separate statically-named per-digit properties instead). Each
// box is written out explicitly rather than generated by a `for` loop:
// a `for` over an array like `[d0, d1, ...]` would iterate over *copies*
// of those values, not live references back to the named properties, so
// `text <=> box` inside such a loop could never actually write back to
// `d0`/`d1`/etc. Auto-advance-to-next-box-on-digit-typed and
// paste-splitting aren't implemented — both would need string length/
// substring operations Slint doesn't provide; the person can Tab or
// click between boxes.
export component OtpInput inherits Rectangle {
    in-out property <string> d0: "";
    in-out property <string> d1: "";
    in-out property <string> d2: "";
    in-out property <string> d3: "";
    in-out property <string> d4: "";
    in-out property <string> d5: "";
    out property <string> code: d0 + d1 + d2 + d3 + d4 + d5;

    callback completed(string);

    horizontal-stretch: 1;
    height: 56px;

    HorizontalLayout {
        spacing: 8px;
        alignment: center;

        Rectangle {
            width: 48px; height: 52px;
            border-radius: Theme.radius-md;
            background: Theme.bg-surface;
            border-width: 2px;
            border-color: in0.has-focus ? Theme.accent : Theme.border-base;
            vertical-stretch: 0;
            TouchArea { clicked => { in0.focus(); } }
            in0 := TextInput {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24px;
                text <=> root.d0;
                color: Theme.text-primary;
                font-family: Theme.font-mono;
                font-size: 24px;
                font-weight: Theme.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 48px; height: 52px;
            border-radius: Theme.radius-md;
            background: Theme.bg-surface;
            border-width: 2px;
            border-color: in1.has-focus ? Theme.accent : Theme.border-base;
            vertical-stretch: 0;
            TouchArea { clicked => { in1.focus(); } }
            in1 := TextInput {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24px;
                text <=> root.d1;
                color: Theme.text-primary;
                font-family: Theme.font-mono;
                font-size: 24px;
                font-weight: Theme.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 48px; height: 52px;
            border-radius: Theme.radius-md;
            background: Theme.bg-surface;
            border-width: 2px;
            border-color: in2.has-focus ? Theme.accent : Theme.border-base;
            vertical-stretch: 0;
            TouchArea { clicked => { in2.focus(); } }
            in2 := TextInput {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24px;
                text <=> root.d2;
                color: Theme.text-primary;
                font-family: Theme.font-mono;
                font-size: 24px;
                font-weight: Theme.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 48px; height: 52px;
            border-radius: Theme.radius-md;
            background: Theme.bg-surface;
            border-width: 2px;
            border-color: in3.has-focus ? Theme.accent : Theme.border-base;
            vertical-stretch: 0;
            TouchArea { clicked => { in3.focus(); } }
            in3 := TextInput {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24px;
                text <=> root.d3;
                color: Theme.text-primary;
                font-family: Theme.font-mono;
                font-size: 24px;
                font-weight: Theme.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 48px; height: 52px;
            border-radius: Theme.radius-md;
            background: Theme.bg-surface;
            border-width: 2px;
            border-color: in4.has-focus ? Theme.accent : Theme.border-base;
            vertical-stretch: 0;
            TouchArea { clicked => { in4.focus(); } }
            in4 := TextInput {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24px;
                text <=> root.d4;
                color: Theme.text-primary;
                font-family: Theme.font-mono;
                font-size: 24px;
                font-weight: Theme.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 48px; height: 52px;
            border-radius: Theme.radius-md;
            background: Theme.bg-surface;
            border-width: 2px;
            border-color: in5.has-focus ? Theme.accent : Theme.border-base;
            vertical-stretch: 0;
            TouchArea { clicked => { in5.focus(); } }
            in5 := TextInput {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24px;
                text <=> root.d5;
                color: Theme.text-primary;
                font-family: Theme.font-mono;
                font-size: 24px;
                font-weight: Theme.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    changed code => {
        if root.d0 != "" && root.d1 != "" && root.d2 != "" && root.d3 != "" && root.d4 != "" && root.d5 != "" {
            root.completed(root.code);
        }
    }
}
