import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component ComponentPlayground inherits Rectangle {
    background: Theme.bg-surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-default;
    clip: true;

    in property <string> component-name: "Button";

    callback copy-requested();

    VerticalLayout {
        Rectangle {
            height: 40px;
            border-radius: Theme.radius-lg;

            HorizontalLayout {
                padding-left: Theme.sp-3;
                padding-right: Theme.sp-3;

                Text {
                    text: component-name;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-semibold;
                    color: Theme.text-primary;
                    y: (parent.height - self.height) / 2;
                    vertical-stretch: 1;
                }

                copy-area := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.copy-requested(); }
                }

                HorizontalLayout {
                    spacing: Theme.sp-1;
                    y: (parent.height - self.height) / 2;

                    FaIcon {
                        source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/copy.svg");
                        fa-size: 12px;
                        fa-color: copy-area.has-hover ? Theme.accent-dim : Theme.accent;
                    }

                    Text {
                        text: "Copy";
                        font-size: Theme.text-xs;
                        color: copy-area.has-hover ? Theme.accent-dim : Theme.accent;
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border-default; }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-base;

            VerticalLayout {
                padding: Theme.sp-4;
                @children
            }
        }

        Rectangle { height: 1px; background: Theme.border-default; }

        Rectangle {
            height: 60px;
            background: Theme.bg-overlay;

            VerticalLayout {
                padding: Theme.sp-2;

                Text {
                    text: "Props panel";
                    font-size: Theme.text-xs;
                    color: Theme.text-tertiary;
                }
            }
        }
    }
}
