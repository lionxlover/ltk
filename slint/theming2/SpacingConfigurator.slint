import { Theme } from "../core/Theme.slint";

export component SpacingConfigurator inherits Rectangle {
    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-default;
    clip: true;

    in property <[string]> scales: ["xs (4)", "sm (8)", "md (12)", "lg (16)", "xl (24)", "2xl (32)"];
    in property <[length]> values: [4px, 8px, 12px, 16px, 24px, 32px];

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-3;

        Text {
            text: "Spacing Scale";
            font-size: Theme.text-sm;
            font-weight: Theme.weight-semibold;
            color: Theme.text-primary;
        }

        for scale[idx] in scales: HorizontalLayout {
            spacing: Theme.sp-2;
            height: 24px;

            Text {
                text: scale;
                font-size: Theme.text-xs;
                color: Theme.text-secondary;
                width: 60px;
                y: 4px;
            }

            Rectangle {
                height: 16px;
                width: idx == 0 ? 4px : idx == 1 ? 8px : idx == 2 ? 12px : idx == 3 ? 16px : idx == 4 ? 24px : 32px;
                border-radius: 3px;
                background: Theme.accent-subtle;
                y: 4px;
            }
        }
    }
}
