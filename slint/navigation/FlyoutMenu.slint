import { Theme } from "../core/Theme.slint";

export component FlyoutMenuItem inherits Rectangle {
    // Post-delivery fix: `icon` was rendered as plain text, and even the
    // "safe" BMP symbols used for its demo values (▤▥✕) render as broken
    // tofu glyphs in this environment (confirmed via a live screenshot).
    // Switched to a real image, matching the same fix applied to
    // Dock/Taskbar/NavItem/NavBadge in this category.
    in property <image> icon-source: @image-url("");
    in property <bool> has-icon: false;
    in property <string> label: "";
    in property <string> shortcut: "";
    in property <bool> show-separator: false;
    in property <bool> danger: false;

    // Bug: the TouchArea below had an empty body — no `clicked =>`
    // handler and no callback exposed — so tapping a menu item did
    // nothing observable. Exposed a real `clicked` callback, and added
    // hover feedback (per polish.md's guidance for any custom
    // interactive element), matching the has-hover/pressed convention
    // already used elsewhere in this category (e.g. NavItem).
    // Post-delivery fix: the TouchArea (id `ta`) was originally wrapped
    // in `if !show-separator:`, but `background:` above references
    // `ta.pressed`/`ta.has-hover` — a real compile error ("Cannot access
    // id 'ta'"), since an id declared inside a conditional element isn't
    // in scope for bindings outside that conditional. Made the
    // TouchArea unconditional and used `enabled: !show-separator;`
    // instead, so it's always in scope but inert for separator rows.
    callback clicked();

    height: show-separator ? 20px : 32px;
    border-radius: 6px;
    background: show-separator ? transparent
        : ta.pressed ? Theme.surface-pressed
        : ta.has-hover ? Theme.surface-hover
        : transparent;
    animate background { duration: Theme.dur-fast; }

    if show-separator: HorizontalLayout {
        padding-left: Theme.sp-2;
        padding-right: Theme.sp-2;
        Rectangle {
            y: 9px;
            height: 1px;
            background: Theme.border-default;
        }
    }

    if !show-separator: HorizontalLayout {
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-3;
        spacing: Theme.sp-3;
        alignment: stretch;

        if has-icon: Image {
            source: icon-source;
            width: 14px;
            height: 14px;
            colorize: danger ? Theme.error : Theme.text-secondary;
            y: (parent.height - self.height) / 2;
            horizontal-alignment: center;
        }

        Text {
            text: label;
            font-size: Theme.text-sm;
            color: danger ? Theme.error : Theme.text-primary;
            y: (parent.height - self.height) / 2;
            vertical-stretch: 1;
            overflow: elide;
        }

        if shortcut != "": Text {
            text: shortcut;
            font-size: Theme.text-xs;
            color: Theme.text-tertiary;
            y: (parent.height - self.height) / 2;
        }
    }

    ta := TouchArea {
        enabled: !root.show-separator;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Bug: FlyoutMenu had no `@children` at all — per Slint's own container
// docs, elements nested inside a component without `@children` become
// direct children of that component's root, NOT arranged by any layout.
// Every `FlyoutMenuItem` placed inside `FlyoutMenu { ... }` would default
// to filling/centering in the same space and overlap each other instead
// of stacking into a proper menu list. (test.slint's demo never actually
// caught this because it bypassed FlyoutMenu entirely, building its own
// VerticalLayout of FlyoutMenuItems instead of using this component.)
// Also: `padding: Theme.sp-1;` was set directly on this Rectangle — this
// project's own gotchas.md already documents that padding only has an
// effect on layout elements, so it was silently doing nothing. Both
// fixed by moving the padding onto a real VerticalLayout wrapping
// `@children`.
export component FlyoutMenu inherits Rectangle {
    background: Theme.bg-elevated;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-default;
    width: 220px;
    clip: true;

    // `show-icons`/`show-shortcuts` are informational for the caller —
    // `@children` can't reach into injected children's properties, so
    // FlyoutMenu can't force its FlyoutMenuItems to hide their icon/
    // shortcut columns itself. Read these when building the menu's
    // children and pass `icon: ""` / `shortcut: ""` accordingly.
    in property <bool> show-icons: true;
    in property <bool> show-shortcuts: true;

    VerticalLayout {
        padding: Theme.sp-1;
        spacing: 0px;
        @children
    }
}

