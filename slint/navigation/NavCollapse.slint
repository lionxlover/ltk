import { Theme } from "../core/Theme.slint";

export component NavCollapse inherits Rectangle {
    in property <string> label: "";
    in property <bool> expanded: false;

    callback toggled();

    background: transparent;

    VerticalLayout {
        header-row := Rectangle {
            height: 36px;
            background: ta.pressed ? Theme.surface-pressed
                : ta.has-hover ? Theme.surface-hover
                : transparent;
            border-radius: Theme.radius-sm;

            animate background { duration: Theme.dur-fast; }

            HorizontalLayout {
                padding-left: Theme.sp-3;
                padding-right: Theme.sp-3;
                spacing: Theme.sp-2;

                Text {
                    text: root.label;
                    color: Theme.text-primary;
                    font-family: Theme.font-ui;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-medium;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Text {
                    text: root.expanded ? "\u{25BC}" : "\u{25B6}";
                    color: Theme.text-tertiary;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }

            ta := TouchArea {
                clicked => { root.toggled(); }
            }
        }

        // Bug fix note: an earlier pass here tried `if expanded:
        // VerticalLayout { @children }` — but `@children` inside a
        // conditional element is a confirmed, currently-open Slint
        // limitation (this project's own gotchas.md documents the exact
        // "The @children placeholder..." compiler error). Using the
        // established workaround instead: keep the wrapper
        // unconditional and animate its height to 0 when collapsed, so
        // `@children` sits in an always-present element.
        content-clip := Rectangle {
            clip: true;
            height: root.expanded ? content-inner.preferred-height : 0px;
            animate height { duration: Theme.dur-normal; easing: Theme.ease-standard; }

            content-inner := VerticalLayout {
                padding-left: Theme.sp-4;
                padding-top: Theme.sp-1;
                padding-bottom: Theme.sp-1;
                spacing: Theme.sp-1;
                @children
            }
        }
    }
}
