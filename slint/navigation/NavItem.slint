import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

// Bug: `source: @image-url("");` was a hardcoded empty path — `icon-name`
// was declared and accepted but never actually used to choose an icon,
// so NavItem's icon never showed anything regardless of what was passed.
// The deeper issue: `@image-url(...)` needs a compile-time string
// literal to embed the asset, so it can never resolve a *runtime*
// `icon-name` string to a path anyway — that's an architectural
// mismatch, not something fixable by just filling in the binding.
// Switched to this project's own established pattern for a
// per-instance-selectable icon (already used in
// `overlays/FloatingActionPanel.slint` and `feedback/AboutDialog.slint`):
// expose `in property <image> icon-source;` and let the *caller* supply
// a literal `@image-url(...)` when instantiating NavItem.
export component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <image> icon-source: @image-url("");
    in property <bool> has-icon: false;

    callback clicked();

    height: 36px;
    background: active ? Theme.accent-subtle
        : ta.pressed ? Theme.surface-pressed
        : ta.has-hover ? Theme.surface-hover
        : #00000000;
    border-radius: Theme.radius-sm;

    animate background { duration: Theme.dur-fast; }

    HorizontalLayout {
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-3;
        spacing: Theme.sp-2;
        alignment: stretch;

        if root.has-icon: FaIcon {
            source: root.icon-source;
            fa-size: Theme.icon-md;
            fa-color: active ? Theme.accent : Theme.text-tertiary;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }

        Text {
            text: root.label;
            color: active ? Theme.accent : Theme.text-primary;
            font-family: Theme.font-ui;
            font-size: Theme.text-sm;
            font-weight: active ? Theme.weight-medium : Theme.weight-regular;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}
