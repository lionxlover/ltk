import { Theme } from "../core/Theme.slint";

export component LazyImage inherits Rectangle {
    in property <string> alt: "";
    in property <bool> loaded: false;

    width: 200px;
    height: 160px;
    background: loaded ? Theme.bg-overlay : Theme.bg-raised;
    border-radius: Theme.radius-md;
    clip: true;

    if !loaded: VerticalLayout {
        alignment: center;

        Rectangle {
            width: 40px;
            height: 40px;
            background: Theme.bg-overlay;
            border-radius: Theme.radius-full;

            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: "...";
                color: Theme.text-tertiary;
                font-size: 14px;
                vertical-alignment: center;
            }
        }

        if root.alt != "": Text {
            text: root.alt;
            color: Theme.text-tertiary;
            font-size: Theme.text-xs;
            horizontal-alignment: center;
        }
    }
}
