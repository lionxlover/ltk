import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component SvgIllustration inherits Rectangle {
    in property <string> label: "Illustration";

    width: 200px;
    height: 160px;
    background: Theme.bg-overlay;
    border-radius: Theme.radius-md;

    VerticalLayout {
        alignment: center;
        spacing: Theme.sp-2;

        FaIcon {
            source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/palette.svg");
            fa-size: 28px;
            fa-color: Theme.text-tertiary;
            x: (parent.width - self.width) / 2;
        }

        if root.label != "": Text {
            text: root.label;
            color: Theme.text-tertiary;
            font-size: Theme.text-xs;
            horizontal-alignment: center;
        }
    }
}
