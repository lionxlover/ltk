import { Theme } from "../core/Theme.slint";

export component PodcastPlayer inherits Rectangle {
    in property <string> title: "Episode Title";
    in property <string> podcast: "Podcast Name";
    in property <int> progress: 35;

    background: Theme.bg-surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-base;

    VerticalLayout {
        padding: Theme.sp-4;
        spacing: Theme.sp-3;

        HorizontalLayout {
            spacing: Theme.sp-3;

            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: Theme.radius-md;
                background: Theme.accent-subtle;

                Text {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    text: "🎙";
                    font-size: 24px;
                    vertical-alignment: center;
                }
            }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;

                Text {
                    text: root.title;
                    color: Theme.text-primary;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-semibold;
                    wrap: word-wrap;
                }

                Text {
                    text: root.podcast;
                    color: Theme.accent;
                    font-size: Theme.text-xs;
                }
            }
        }

        Rectangle {
            height: 4px;

            Rectangle {
                height: 4px;
                width: parent.width * root.progress / 100;
                background: Theme.accent;
                border-radius: 2px;
            }

            Rectangle {
                height: 4px;
                width: parent.width;
                background: Theme.border-subtle;
                border-radius: 2px;
            }
        }

        HorizontalLayout {
            spacing: Theme.sp-4;

            Text { text: "00:00"; color: Theme.text-tertiary; font-size: Theme.text-xs; }

            Rectangle { horizontal-stretch: 1; }

            Text { text: "45:00"; color: Theme.text-tertiary; font-size: Theme.text-xs; }
        }
    }
}
