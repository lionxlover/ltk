import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component VideoPlayer inherits Rectangle {
    in property <string> title: "Video";
    in-out property <bool> playing: false;

    callback play-toggle();

    background: Theme.dark-mode ? #0D1117 : #1a1a2e;
    border-radius: Theme.radius-md;
    clip: true;

    VerticalLayout {
        Rectangle {
            vertical-stretch: 1;

            FaIcon {
                source: root.playing
                    ? @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/pause.svg")
                    : @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/play.svg");
                fa-size: 44px;
                fa-color: #ffffff;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Rectangle {
            height: 48px;
            background: #00000080;

            HorizontalLayout {
                padding-left: Theme.sp-3;
                padding-right: Theme.sp-3;
                spacing: Theme.sp-3;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: Theme.radius-full;
                    background: Theme.accent;

                    FaIcon {
                        source: root.playing
                            ? @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/pause.svg")
                            : @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/play.svg");
                        fa-size: 14px;
                        fa-color: #ffffff;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    play-ta := TouchArea {
                        clicked => {
                            root.playing = !root.playing;
                            root.play-toggle();
                        }
                    }
                }

                Rectangle {
                    height: 4px;
                    vertical-stretch: 0;

                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 4px;
                        width: parent.width * 0.35;
                        background: Theme.accent;
                        border-radius: 2px;
                    }

                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        height: 4px;
                        width: parent.width;
                        background: #ffffff30;
                        border-radius: 2px;
                    }
                }

                Text {
                    text: root.title;
                    color: #ffffffcc;
                    font-size: Theme.text-xs;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
