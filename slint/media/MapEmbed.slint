import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component MapEmbed inherits Rectangle {
    in property <string> label: "Map";
    in property <bool> interactive: false;

    width: 300px;
    height: 200px;
    background: Theme.dark-mode ? #1a2332 : #e8f0fe;
    border-radius: Theme.radius-md;
    clip: true;

    VerticalLayout {
        alignment: center;
        spacing: Theme.sp-2;

        FaIcon {
            source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/map.svg");
            fa-size: 28px;
            fa-color: Theme.text-secondary;
            x: (parent.width - self.width) / 2;
        }

        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.text-sm;
            horizontal-alignment: center;
        }

        if root.interactive: Text {
            text: "Interactive";
            color: Theme.accent;
            font-size: Theme.text-xs;
            horizontal-alignment: center;
        }
    }
}
