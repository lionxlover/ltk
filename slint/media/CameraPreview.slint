import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component CameraPreview inherits Rectangle {
    in property <bool> active: false;

    width: 300px;
    height: 240px;
    background: #000000;
    border-radius: Theme.radius-md;
    clip: true;

    VerticalLayout {
        alignment: center;
        spacing: Theme.sp-3;

        FaIcon {
            source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/camera.svg");
            fa-size: 40px;
            fa-color: #ffffff;
            x: (parent.width - self.width) / 2;
        }

        Text {
            text: root.active ? "Camera Active" : "Camera Off";
            color: root.active ? Theme.state-success : Theme.text-tertiary;
            font-size: Theme.text-sm;
            horizontal-alignment: center;
        }
    }

    Rectangle {
        x: parent.width - 24px;
        y: 8px;
        width: 16px;
        height: 16px;
        border-radius: Theme.radius-full;
        background: root.active ? Theme.state-error : Theme.text-tertiary;
    }
}
