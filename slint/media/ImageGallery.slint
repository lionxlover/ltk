import { Theme } from "../core/Theme.slint";

export component ImageGallery inherits Rectangle {
    in property <int> columns: 3;
    in property <int> count: 6;

    background: transparent;

    GridLayout {
        spacing: Theme.sp-2;

        for item[i] in root.count: Rectangle {
            row: Math.floor(i / root.columns);
            col: Math.mod(i, root.columns);
            min-height: 60px;
            background: Theme.bg-overlay;
            border-radius: Theme.radius-md;
            clip: true;

            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: "\{i + 1}";
                color: Theme.text-tertiary;
                font-size: Theme.text-sm;
                vertical-alignment: center;
            }
        }
    }
}
