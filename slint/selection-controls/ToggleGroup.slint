import { Theme } from "../core/Theme.slint";
import { ToggleSwitch } from "ToggleSwitch.slint";

export component ToggleGroup inherits Rectangle {
    in-out property <[string]> labels: ["Wi-Fi", "Bluetooth", "Airplane"];
    in-out property <[bool]> checked: [true, false, false];
    callback item-toggled(int, bool);

    horizontal-stretch: 1;

    VerticalLayout {
        spacing: 8px;
        for lbl[idx] in root.labels: HorizontalLayout {
            spacing: 12px;
            height: 32px;

            Text {
                text: lbl;
                color: Theme.text-primary;
                font-size: 14px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            ToggleSwitch {
                checked: idx < root.checked.length && root.checked[idx];
                toggled(new-state) => { root.item-toggled(idx, new-state); }
            }
        }
    }
}
