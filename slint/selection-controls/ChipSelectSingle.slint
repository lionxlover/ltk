import { Theme } from "../core/Theme.slint";

export component ChipSelectSingle inherits Rectangle {
    in-out property <[string]> items: ["Small", "Medium", "Large", "XL"];
    in-out property <int> selected-index: 1;

    horizontal-stretch: 1;

    HorizontalLayout {
        spacing: 6px;

        for itm[idx] in root.items: Rectangle {
            height: 32px;
            border-radius: 16px;
            background: idx == root.selected-index ? Theme.accent : Theme.bg-surface;
            border-width: 1px;
            border-color: idx == root.selected-index ? Theme.accent : Theme.border-base;

            Text {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                text: itm;
                color: idx == root.selected-index ? #ffffff : Theme.text-secondary;
                font-size: 13px;
                font-weight: Theme.weight-medium;
                vertical-alignment: center;
                horizontal-alignment: center;
            }

            TouchArea {
                clicked => { root.selected-index = idx; }
            }
        }
    }
}
