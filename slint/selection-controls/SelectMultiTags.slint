import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component SelectMultiTags inherits Rectangle {
    // Was hardcoded static "React"/"Slint" tags with no backing
    // property at all — could never actually show a caller's real
    // selection. Rebuilt on a real tags array, rendered via for-loop,
    // each with a working remove button.
    in-out property <[string]> tags: ["React", "Slint"];
    in-out property <bool> has-focus: false;
    callback tag-removed(int);

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;
    clip: true;

    // Declared before the tag pills, so their own remove buttons
    // (rendered later / on top) take priority over this catch-all when
    // their bounds overlap.
    TouchArea {
        clicked => { root.has-focus = !root.has-focus; }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 32px;
        spacing: 4px;

        for tag[idx] in root.tags: Rectangle {
            height: 26px;
            border-radius: 13px;
            background: Theme.accent-subtle;
            vertical-stretch: 0;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 6px;
                spacing: 4px;
                alignment: center;

                Text {
                    text: tag;
                    color: Theme.accent;
                    font-size: 11px;
                    font-weight: Theme.weight-medium;
                    vertical-alignment: center;
                }

                remove-ta := TouchArea {
                    width: 14px;
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.tag-removed(idx); }

                    Text {
                        text: "\u{00D7}";
                        color: Theme.accent;
                        font-size: 12px;
                        font-weight: Theme.weight-bold;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    FaIcon {
        x: parent.width - 24px;
        y: (parent.height - self.height) / 2;
        fa-size: 10px;
        fa-color: Theme.text-tertiary;
        source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/chevron-down.svg");
    }
}
