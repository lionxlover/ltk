import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component CascadingSelect inherits Rectangle {
    in-out property <string> text: "Select category...";
    in-out property <bool> has-focus: false;

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;

    Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        color: Theme.text-primary;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }

    FaIcon {
        x: parent.width - 24px;
        y: (parent.height - self.height) / 2;
        fa-size: 10px;
        fa-color: Theme.text-tertiary;
        source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/chevron-down.svg");
    }

    TouchArea {
        clicked => { root.has-focus = !root.has-focus; }
    }
}
