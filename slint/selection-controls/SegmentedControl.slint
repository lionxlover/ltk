import { Theme } from "../core/Theme.slint";

export component SegmentedControl inherits Rectangle {
    in-out property <[string]> items: ["Day", "Week", "Month", "Year"];
    in-out property <int> selected-index: 0;

    background: Theme.bg-raised;
    border-radius: Theme.radius-md;
    height: 36px;
    horizontal-stretch: 1;

    for itm[idx] in root.items: Rectangle {
        x: idx * (parent.width / 4);
        width: parent.width / 4;
        height: parent.height;
        border-radius: Theme.radius-md;
        background: idx == root.selected-index ? Theme.bg-surface : transparent;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: itm;
            color: idx == root.selected-index ? Theme.text-primary : Theme.text-secondary;
            font-size: 13px;
            font-weight: idx == root.selected-index ? Theme.weight-semibold : Theme.weight-regular;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        TouchArea {
            clicked => { root.selected-index = idx; }
        }
    }
}
