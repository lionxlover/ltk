import { Theme } from "../core/Theme.slint";

export component TimezonePicker inherits Rectangle {
    in-out property <string> text: "UTC-05:00 (EST)";
    in-out property <bool> has-focus: false;

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;

    Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: "\u{1F30D}";
        font-size: 14px;
        vertical-alignment: center;
    }

    Text {
        x: 34px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        color: Theme.text-primary;
        font-family: Theme.font-mono;
        font-size: 14px;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 24px;
        y: (parent.height - self.height) / 2;
        text: "\u{25BE}";
        color: Theme.text-tertiary;
        font-size: 12px;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.has-focus = true; }
    }
}
