import { Theme } from "../core/Theme.slint";
import { Checkbox } from "Checkbox.slint";

export component CheckboxGroup inherits Rectangle {
    in-out property <[string]> labels: ["Option A", "Option B", "Option C"];
    in-out property <[bool]> checked: [true, false, false];
    // Arrays can't be index-assigned from inside a component (confirmed
    // gotcha) — report which index changed and let the host reassign
    // the whole `checked` array with the new value applied.
    callback item-toggled(int, bool);

    horizontal-stretch: 1;

    VerticalLayout {
        spacing: 4px;
        for lbl[idx] in root.labels: Checkbox {
            label: lbl;
            checked: idx < root.checked.length && root.checked[idx];
            toggled(new-state) => { root.item-toggled(idx, new-state); }
        }
    }
}
