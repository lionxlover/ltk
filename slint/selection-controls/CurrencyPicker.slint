import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component CurrencyPicker inherits Rectangle {
    in-out property <string> text: "USD";
    in-out property <string> symbol: "$";
    in-out property <bool> has-focus: false;

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;

    Rectangle {
        x: 8px;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        border-radius: Theme.radius-sm;
        background: Theme.bg-raised;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: root.symbol;
            color: Theme.accent;
            font-size: 13px;
            font-weight: Theme.weight-bold;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    Text {
        x: 40px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        color: Theme.text-primary;
        font-family: Theme.font-mono;
        font-size: 14px;
        vertical-alignment: center;
    }

    FaIcon {
        x: parent.width - 24px;
        y: (parent.height - self.height) / 2;
        fa-size: 10px;
        fa-color: Theme.text-tertiary;
        source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/chevron-down.svg");
    }

    TouchArea {
        clicked => { root.has-focus = !root.has-focus; }
    }
}
