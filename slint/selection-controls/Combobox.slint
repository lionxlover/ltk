import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component Combobox inherits Rectangle {
    // input.text is the source of truth, mirrored out to this property
    // one-way (child → parent) via `changed text`. Binding this property
    // directly INTO input.text would fight the user's own typing, the
    // same way an explicit parent binding fights a group item's
    // internal toggle elsewhere in this category.
    in-out property <string> text: "";
    in-out property <string> placeholder: "Type to search...";
    in-out property <bool> has-focus: false;
    callback text-edited(string);

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;
    clip: true;

    input := TextInput {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 36px;
        text: "";
        color: Theme.text-primary;
        font-family: Theme.font-ui;
        font-size: 14px;
        single-line: true;
        changed text => { root.text = self.text; root.text-edited(self.text); }
    }

    if input.text == "": Text {
        x: 12px;
        y: (parent.height - self.height) / 2;
        text: root.placeholder;
        color: Theme.text-placeholder;
        font-family: Theme.font-ui;
        font-size: 14px;
        vertical-alignment: center;
    }

    FaIcon {
        x: parent.width - 24px;
        y: (parent.height - self.height) / 2;
        fa-size: 10px;
        fa-color: Theme.text-tertiary;
        source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/chevron-down.svg");
    }

    TouchArea {
        clicked => { root.has-focus = !root.has-focus; input.focus(); }
    }
}
