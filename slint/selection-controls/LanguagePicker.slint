import { Theme } from "../core/Theme.slint";

export component LanguagePicker inherits Rectangle {
    in-out property <string> text: "English";
    in-out property <string> code: "en";
    in-out property <bool> has-focus: false;

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: has-focus ? Theme.accent : Theme.border-base;
    height: 40px;
    horizontal-stretch: 1;

    Rectangle {
        x: 8px;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        border-radius: Theme.radius-sm;
        background: Theme.bg-raised;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: root.code;
            color: Theme.text-secondary;
            font-size: 9px;
            font-weight: Theme.weight-bold;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    Text {
        x: 40px;
        y: (parent.height - self.height) / 2;
        text: root.text;
        color: Theme.text-primary;
        font-size: 14px;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 24px;
        y: (parent.height - self.height) / 2;
        text: "\u{25BE}";
        color: Theme.text-tertiary;
        font-size: 12px;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.has-focus = true; }
    }
}
