// Opacity scale
export global OpacityScale {
    out property <float> opacity-0: 0.0;
    out property <float> opacity-5: 0.05;
    out property <float> opacity-10: 0.10;
    out property <float> opacity-15: 0.15;
    out property <float> opacity-20: 0.20;
    out property <float> opacity-25: 0.25;
    out property <float> opacity-30: 0.30;
    out property <float> opacity-40: 0.40;
    out property <float> opacity-50: 0.50;
    out property <float> opacity-60: 0.60;
    out property <float> opacity-70: 0.70;
    out property <float> opacity-80: 0.80;
    out property <float> opacity-90: 0.90;
    out property <float> opacity-95: 0.95;
    out property <float> opacity-100: 1.0;

    // Named presets
    out property <float> disabled: 0.4;
    out property <float> hover: 0.92;
    out property <float> pressed: 0.85;
    out property <float> focused: 0.95;
    out property <float> ghost: 0.6;
    out property <float> hidden: 0.0;
    out property <float> visible: 1.0;
}
