// Grid Gutter token
export global GridGutter {
    out property <length> gutter-0: 0px;
    out property <length> gutter-xs: 4px;
    out property <length> gutter-sm: 8px;
    out property <length> gutter-md: 16px;
    out property <length> gutter-lg: 24px;
    out property <length> gutter-xl: 32px;
    out property <length> gutter-2xl: 48px;
    out property <length> gutter-3xl: 64px;
}
