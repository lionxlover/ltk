// Backdrop Blur tokens
export global BackdropBlur {
    out property <length> blur-none: 0px;
    out property <length> blur-sm: 4px;
    out property <length> blur-md: 8px;
    out property <length> blur-lg: 16px;
    out property <length> blur-xl: 24px;
    out property <length> blur-2xl: 40px;
    out property <length> blur-3xl: 64px;

    // Glass presets
    out property <length> glass-blur: 24px;
    out property <length> frosted-blur: 16px;
    out property <length> heavy-blur: 40px;
}
