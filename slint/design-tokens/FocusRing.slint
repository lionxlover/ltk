// Focus Ring width / offset
export global FocusRing {
    out property <length> width: 2px;
    out property <length> width-thick: 3px;
    out property <length> offset: 2px;
    out property <length> offset-sm: 1px;
    out property <length> offset-lg: 4px;
    out property <length> inset: -2px;

    out property <color> color: #5B9DFA40;
    out property <color> color-strong: #5B9DFA80;
    out property <color> color-error: #F28B8280;
    out property <color> color-success: #5EE29A80;

    out property <length> radius: 8px;
    out property <length> radius-sm: 4px;
    out property <length> radius-lg: 12px;
}
