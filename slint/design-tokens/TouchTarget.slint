// Touch Target minimum (44 × 44 px)
export global TouchTarget {
    out property <length> min-width: 44px;
    out property <length> min-height: 44px;
    out property <length> target-size: 44px;
    out property <length> target-padding: 10px;

    // Apple HIG minimum
    out property <length> apple-min: 44px;
    // Material minimum
    out property <length> material-min: 48px;
    // WCAG minimum
    out property <length> wcag-min: 44px;
}
