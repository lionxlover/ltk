// Spring Preset tokens
export global SpringPresets {
    out property <easing> spring-stiff: cubic-bezier(0.5, 2.0, 0.3, 1.0);
    out property <easing> spring-default: cubic-bezier(0.34, 1.56, 0.64, 1.0);
    out property <easing> spring-gentle: cubic-bezier(0.16, 1.0, 0.3, 1.0);
    out property <easing> spring-wobbly: cubic-bezier(0.68, -0.6, 0.32, 1.6);
    out property <easing> spring-bouncy: cubic-bezier(0.34, 1.8, 0.64, 1.0);

    out property <duration> spring-duration-fast: 200ms;
    out property <duration> spring-duration-normal: 400ms;
    out property <duration> spring-duration-slow: 600ms;
}
