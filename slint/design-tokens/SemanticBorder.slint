// Semantic — Border / Outline
export global SemanticBorder {
    out property <color> border-subtle: #ffffff0f;  // dark default
    out property <color> border-base: #ffffff1a;
    out property <color> border-strong: #ffffff2e;
    out property <color> border-focus: #5B9DFA;
    out property <color> border-error: #F28B82;
    out property <color> border-success: #5EE29A;
    out property <color> border-warning: #FBBF24;
    out property <color> border-info: #5B9DFA;
    out property <color> border-default: #ffffff14;
    out property <color> border-divider: #ffffff0f;

    out property <length> border-width-thin: 1px;
    out property <length> border-width-base: 1px;
    out property <length> border-width-thick: 2px;
    out property <length> border-width-emphasis: 2px;
}
