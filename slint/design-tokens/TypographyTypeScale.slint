// Typography — Type Scale (10 steps)
export global TypographyTypeScale {
    out property <string> font-ui: "Inter";

    out property <length> text-2xs: 10px;
    out property <length> text-xs: 11px;
    out property <length> text-sm: 12px;
    out property <length> text-base: 14px;
    out property <length> text-md: 15px;
    out property <length> text-lg: 16px;
    out property <length> text-xl: 18px;
    out property <length> text-2xl: 20px;
    out property <length> text-3xl: 24px;
    out property <length> text-4xl: 30px;
    out property <length> text-5xl: 36px;

    // Named sizes
    out property <length> size-display: 48px;
    out property <length> size-h1: 30px;
    out property <length> size-h2: 24px;
    out property <length> size-h3: 20px;
    out property <length> size-h4: 18px;
    out property <length> size-h5: 16px;
    out property <length> size-h6: 14px;
    out property <length> size-body-lg: 16px;
    out property <length> size-body: 14px;
    out property <length> size-body-sm: 12px;
    out property <length> size-caption: 11px;
    out property <length> size-overline: 10px;
}
