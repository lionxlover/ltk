// Alpha / Transparency tokens
export global AlphaTokens {
    // Opacity levels
    out property <float> alpha-0: 0.0;
    out property <float> alpha-5: 0.05;
    out property <float> alpha-10: 0.10;
    out property <float> alpha-15: 0.15;
    out property <float> alpha-20: 0.20;
    out property <float> alpha-25: 0.25;
    out property <float> alpha-30: 0.30;
    out property <float> alpha-40: 0.40;
    out property <float> alpha-50: 0.50;
    out property <float> alpha-60: 0.60;
    out property <float> alpha-70: 0.70;
    out property <float> alpha-80: 0.80;
    out property <float> alpha-90: 0.90;
    out property <float> alpha-95: 0.95;
    out property <float> alpha-100: 1.0;

    // Scrim / overlay presets
    out property <color> scrim-light: rgba(0,0,0,0.04);
    out property <color> scrim-medium: rgba(0,0,0,0.30);
    out property <color> scrim-heavy: rgba(0,0,0,0.55);
    out property <color> scrim-full: rgba(0,0,0,0.80);

    // Hover / press overlays
    out property <color> hover-overlay: rgba(255,255,255,0.06);
    out property <color> pressed-overlay: rgba(255,255,255,0.10);
    out property <color> focus-overlay: rgba(255,255,255,0.04);
}
