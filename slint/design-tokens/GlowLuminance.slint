// Glow / Luminance effect tokens
export global GlowLuminance {
    out property <color> glow-subtle: #5B9DFA15;
    out property <color> glow-default: #5B9DFA30;
    out property <color> glow-strong: #5B9DFA55;

    out property <color> glow-accent: #5B9DFA44;
    out property <color> glow-success: #5EE29A44;
    out property <color> glow-error: #F28B8244;
    out property <color> glow-warning: #FBBF2444;

    out property <length> glow-blur-sm: 8px;
    out property <length> glow-blur-md: 16px;
    out property <length> glow-blur-lg: 32px;
    out property <length> glow-blur-xl: 48px;

    // Luminance overlays
    out property <color> luminance-white: rgba(255,255,255,0.08);
    out property <color> luminance-white-strong: rgba(255,255,255,0.15);
    out property <color> luminance-black: rgba(0,0,0,0.12);
    out property <color> luminance-black-strong: rgba(0,0,0,0.25);
}
