// Breakpoints (xs / sm / md / lg / xl / 2xl)
export global Breakpoints {
    out property <length> bp-xs: 0px;
    out property <length> bp-sm: 640px;
    out property <length> bp-md: 768px;
    out property <length> bp-lg: 1024px;
    out property <length> bp-xl: 1280px;
    out property <length> bp-2xl: 1536px;
}
