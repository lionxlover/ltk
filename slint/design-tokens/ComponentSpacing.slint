// Component inner spacing (8px base)
export global ComponentSpacing {
    out property <length> inset-0: 0px;
    out property <length> inset-1: 4px;
    out property <length> inset-2: 8px;
    out property <length> inset-3: 12px;
    out property <length> inset-4: 16px;
    out property <length> inset-5: 20px;
    out property <length> inset-6: 24px;
    out property <length> inset-8: 32px;
    out property <length> inset-10: 40px;

    // Named presets
    out property <length> padding-xs: 4px;
    out property <length> padding-sm: 8px;
    out property <length> padding-md: 12px;
    out property <length> padding-lg: 16px;
    out property <length> padding-xl: 24px;
    out property <length> padding-2xl: 32px;

    out property <length> gutter-xs: 4px;
    out property <length> gutter-sm: 8px;
    out property <length> gutter-md: 12px;
    out property <length> gutter-lg: 16px;
    out property <length> gutter-xl: 24px;

    out property <length> section-sm: 16px;
    out property <length> section-md: 24px;
    out property <length> section-lg: 32px;
    out property <length> section-xl: 48px;
}
