// Spacing scale (4px base, 0–128)
export global SpacingScale {
    out property <length> space-0: 0px;
    out property <length> space-0-5: 2px;
    out property <length> space-1: 4px;
    out property <length> space-1-5: 6px;
    out property <length> space-2: 8px;
    out property <length> space-2-5: 10px;
    out property <length> space-3: 12px;
    out property <length> space-3-5: 14px;
    out property <length> space-4: 16px;
    out property <length> space-5: 20px;
    out property <length> space-6: 24px;
    out property <length> space-7: 28px;
    out property <length> space-8: 32px;
    out property <length> space-9: 36px;
    out property <length> space-10: 40px;
    out property <length> space-12: 48px;
    out property <length> space-14: 56px;
    out property <length> space-16: 64px;
    out property <length> space-20: 80px;
    out property <length> space-24: 96px;
    out property <length> space-28: 112px;
    out property <length> space-32: 128px;
}
