// Typography — Font Family
export global TypographyFontFamily {
    out property <string> font-sans: "Inter";
    out property <string> font-display: "Space Grotesk";
    out property <string> font-mono: "JetBrains Mono";
    out property <string> font-serif: "Georgia";
    out property <string> font-handwriting: "Caveat";

    // Stack fallbacks
    out property <string> font-sans-stack: "Inter, system-ui, -apple-system, sans-serif";
    out property <string> font-mono-stack: "JetBrains Mono, SFMono-Regular, Consolas, monospace";
    out property <string> font-display-stack: "Space Grotesk, Inter, system-ui, sans-serif";
}
