import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

// ═════════════════════════════════════════════════════════════════════════
// AccordionItem
// ═════════════════════════════════════════════════════════════════════════
//
// A single expandable/collapsible section — a header row that toggles a
// content area below it.
//
// Usage:
//   AccordionItem {
//       title: "Shipping details";
//       expanded: section-open;
//       toggle => { root.section-open = !root.section-open; }
//       Text { text: "Content goes here — anything placed inside the
//              AccordionItem instantiation block renders here."; wrap: word-wrap; }
//   }
//
// Fixed in this revision:
//  - SEVERE BUG, the most consequential in this file: the content area
//    was a named `content-layout := VerticalLayout { }` with no children
//    and no `@children` forwarding — this project's own SKILL.md
//    documents `@children` as exactly the mechanism for "forward
//    whatever the caller puts inside this component's instantiation
//    block." Without it, there was no way for any caller to ever put
//    anything inside the expandable area at all: the toggle and expand/
//    collapse animation both worked, but the content region was
//    permanently, unconditionally empty regardless of what a caller
//    tried to place inside `AccordionItem { ... }`. Added `@children`.
//  - No `enabled` property, and the header's TouchArea had no
//    `enabled:` binding.
//  - The expand/collapse chevron swapped between "▾"/"›" glyphs instead
//    of using this library's FaIcon convention with a single rotating
//    icon (matching Select.slint's/DropdownButton.slint's approach).
//  - No accessible role/expanded state (`accessible-expandable`/
//    `accessible-expanded`, the same confirmed-real properties used in
//    Select.slint) or keyboard activation on the header.
export component AccordionItem inherits Rectangle {
    in property <string> title: "";
    in property <bool> expanded: false;
    in property <bool> enabled: true;
    out property <bool> has-focus: header-fs.has-focus;

    callback toggle();

    background: transparent;

    VerticalLayout {
        // Header
        Rectangle {
            height: 44px;
            background: !enabled ? transparent
                : header-ta.pressed ? Theme.surface-pressed
                : header-ta.has-hover ? Theme.surface-hover
                : transparent;
            border-radius: Theme.radius-sm;
            opacity: enabled ? 1.0 : Theme.opacity-disabled;

            animate background { duration: Theme.dur-fast; easing: Theme.ease-standard; }

            accessible-role: AccessibleRole.button;
            accessible-label: root.title;
            accessible-enabled: root.enabled;
            accessible-expandable: true;
            accessible-expanded: root.expanded;

            HorizontalLayout {
                padding-left: Theme.sp-3;
                padding-right: Theme.sp-3;
                spacing: Theme.sp-2;
                alignment: stretch;

                Text {
                    text: root.title;
                    color: enabled ? Theme.text-primary : Theme.text-disabled;
                    font-family: Theme.font-ui;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-medium;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                FaIcon {
                    source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/chevron-right.svg");
                    fa-size: Theme.icon-sm;
                    fa-color: Theme.text-tertiary;
                    fa-disabled: !enabled;
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 0;
                    transform-rotation: root.expanded ? 90deg : 0deg;
                    animate transform-rotation { duration: Theme.dur-normal; easing: Theme.ease-standard; }
                }
            }

            header-ta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => { root.toggle(); }
            }

            header-fs := FocusScope {
                enabled: root.enabled;
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == " ") {
                        root.toggle();
                        accept
                    } else {
                        reject
                    }
                }
            }

            if header-fs.has-focus: Rectangle {
                x: -Theme.focus-ring-offset;
                y: -Theme.focus-ring-offset;
                width: parent.width + 2 * Theme.focus-ring-offset;
                height: parent.height + 2 * Theme.focus-ring-offset;
                border-radius: parent.border-radius + Theme.focus-ring-offset;
                border-width: Theme.focus-ring-width;
                border-color: Theme.focus-ring;
                background: transparent;
            }
        }

        // Content — @children forwards whatever the caller places inside
        // the AccordionItem instantiation block. This was entirely
        // missing before (see header note); without it, nothing a
        // caller wrote inside `AccordionItem { ... }` could ever appear.
        //
        // CORRECTION: an earlier revision wrapped this in `if expanded:
        // VerticalLayout { @children }` — the real compiler rejected it
        // ("The @children placeholder..."), and it turns out that's a
        // genuine, documented current limitation, not a mistake in how
        // I used it: slint-ui/slint issue #6354, "Support for
        // conditional children wrappers," is an open feature request
        // showing this exact pattern as unsupported. `@children` has to
        // live in an element that's unconditionally instantiated.
        // Fixed by keeping the wrapper always present and animating its
        // height to 0 when collapsed (clipped so the hidden content
        // doesn't render past that bound) instead of conditionally
        // mounting it — which, as a bonus, gives a real smooth expand/
        // collapse animation that the `if`-based version could never
        // have had anyway, since `if` mounts and unmounts instantly.
        content-clip := Rectangle {
            clip: true;
            height: root.expanded ? content-inner.preferred-height : 0px;
            background: transparent;
            animate height { duration: Theme.dur-normal; easing: Theme.ease-standard; }

            content-inner := VerticalLayout {
                padding-left: Theme.sp-3;
                padding-right: Theme.sp-3;
                padding-bottom: Theme.sp-3;
                spacing: Theme.sp-2;

                @children
            }
        }
    }
}
