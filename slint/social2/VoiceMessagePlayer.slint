import { Theme } from "../core/Theme.slint";

export component VoiceMessagePlayer inherits Rectangle {
    background: Theme.bg-overlay;
    border-radius: Theme.radius-xl;
    clip: true;

    in property <int> duration-seconds: 12;
    in property <bool> playing: false;
    in property <int> progress: 0;

    width: 240px;
    height: 48px;

    HorizontalLayout {
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-3;
        spacing: Theme.sp-2;

        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: Theme.accent;
            y: 8px;

            Text {
                text: playing ? "⏸" : "▶";
                font-size: 12px;
                color: #ffffff;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            y: 8px;

            HorizontalLayout {
                spacing: 2px;
                y: 12px;

                for bar[b] in 20: Rectangle {
                    width: 3px;
                    height: Math.mod(b * 3 + 5, 20) * 1px;
                    border-radius: 1px;
                    background: b < 10 ? Theme.accent : Theme.text-tertiary;
                    y: (20px - self.height) / 2;
                }
            }

            Text {
                text: "0:" + (progress < 10 ? "0" : "") + Math.mod(progress, 60) + " / 0:" + (duration_seconds < 10 ? "0" : "") + Math.mod(duration_seconds, 60);
                font-size: Theme.text-xs;
                color: Theme.text-tertiary;
                y: 28px;
            }
        }
    }
}
