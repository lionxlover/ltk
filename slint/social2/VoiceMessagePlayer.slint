import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component VoiceMessagePlayer inherits Rectangle {
    background: Theme.bg-overlay;
    border-radius: Theme.radius-xl;
    clip: true;

    in property <int> duration-seconds: 12;
    in-out property <bool> playing: false;
    in property <int> progress: 0;
    callback play-toggle();

    width: 240px;
    height: 48px;

    HorizontalLayout {
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-3;
        spacing: Theme.sp-2;

        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: Theme.accent;
            y: 8px;

            FaIcon {
                source: root.playing
                    ? @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/pause.svg")
                    : @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/play.svg");
                fa-size: 12px;
                fa-color: #ffffff;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            play-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.playing = !root.playing;
                    root.play-toggle();
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            y: 8px;

            HorizontalLayout {
                spacing: 2px;
                y: 12px;

                // Deliberately varying bar heights for a waveform look —
                // Math.mod here creates visual variety, unlike the
                // count/index-display bug this project has fixed
                // elsewhere; not the same shape at all.
                for bar[b] in 20: Rectangle {
                    width: 3px;
                    height: Math.mod(b * 3 + 5, 20) * 1px;
                    border-radius: 1px;
                    background: b < 10 ? Theme.accent : Theme.text-tertiary;
                    y: (20px - self.height) / 2;
                }
            }

            Text {
                text: Math.floor(root.progress / 60) + ":" + (Math.mod(root.progress, 60) < 10 ? "0" : "") + Math.mod(root.progress, 60)
                    + " / " + Math.floor(root.duration-seconds / 60) + ":" + (Math.mod(root.duration-seconds, 60) < 10 ? "0" : "") + Math.mod(root.duration-seconds, 60);
                font-size: Theme.text-xs;
                color: Theme.text-tertiary;
                y: 28px;
            }
        }
    }
}
