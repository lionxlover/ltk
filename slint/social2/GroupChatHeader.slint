import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component GroupChatHeader inherits Rectangle {
    background: Theme.bg-raised;
    height: 56px;
    clip: true;

    in property <string> group-name: "Team Chat";
    in property <int> member-count: 8;
    callback search-clicked();
    callback more-clicked();

    HorizontalLayout {
        padding-left: Theme.sp-4;
        padding-right: Theme.sp-4;
        spacing: Theme.sp-3;

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: Theme.accent-subtle;
            y: 8px;

            FaIcon {
                source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/users.svg");
                fa-size: 16px;
                fa-color: Theme.accent;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 2px;
            y: 10px;

            Text {
                text: group-name;
                font-size: Theme.text-base;
                font-weight: Theme.weight-semibold;
                color: Theme.text-primary;
            }

            Text {
                text: root.member-count + " members";
                font-size: Theme.text-xs;
                color: Theme.text-tertiary;
            }
        }

        Rectangle { vertical-stretch: 1; }

        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            y: 12px;
            background: search-ta.has-hover ? Theme.hover-overlay : transparent;

            FaIcon {
                source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/magnifying-glass.svg");
                fa-size: 13px;
                fa-color: Theme.text-secondary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            search-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.search-clicked(); }
            }
        }

        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            y: 12px;
            background: more-ta.has-hover ? Theme.hover-overlay : transparent;

            FaIcon {
                source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/ellipsis.svg");
                fa-size: 14px;
                fa-color: Theme.text-secondary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            more-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.more-clicked(); }
            }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border-default;
    }
}
