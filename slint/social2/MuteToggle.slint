import { Theme } from "../core/Theme.slint";

export component MuteToggle inherits Rectangle {
    background: transparent;

    in-out property <bool> muted: false;

    width: 40px;
    height: 40px;

    Rectangle {
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: muted ? Theme.bg-overlay : transparent;

        Text {
            text: muted ? "🔇" : "🔊";
            font-size: 16px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    TouchArea {
        clicked => { root.muted = !root.muted; }
    }
}
