import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component MuteToggle inherits Rectangle {
    background: transparent;

    in-out property <bool> muted: false;

    width: 40px;
    height: 40px;

    Rectangle {
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: muted ? Theme.bg-overlay : transparent;

        FaIcon {
            source: muted
                ? @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/volume-xmark.svg")
                : @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/volume-high.svg");
            fa-size: 16px;
            fa-color: Theme.text-primary;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    TouchArea {
        clicked => { root.muted = !root.muted; }
    }
}
