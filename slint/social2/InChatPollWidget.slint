import { Theme } from "../core/Theme.slint";

export component InChatPollWidget inherits Rectangle {
    background: Theme.bg-surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    in property <string> question: "What should we build next?";
    in property <[string]> options: ["Dashboard", "Mobile App", "API"];
    in property <[int]> votes: [12, 8, 5];
    in property <int> total-votes: 25;
    in property <bool> voted: false;

    VerticalLayout {
        padding: Theme.sp-4;
        spacing: Theme.sp-3;

        Text {
            text: question;
            font-size: Theme.text-base;
            font-weight: Theme.weight-semibold;
            color: Theme.text-primary;
        }

        for opt[idx] in options: Rectangle {
            height: 40px;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-default;
            clip: true;

            Rectangle {
                x: 0;
                width: total-votes > 0 ? parent.width * votes[idx] / total-votes : 0px;
                height: parent.height;
                background: Theme.accent-subtle;
                border-radius: Theme.radius-md;
            }

            HorizontalLayout {
                padding-left: Theme.sp-3;
                padding-right: Theme.sp-3;

                Text {
                    text: opt;
                    font-size: Theme.text-sm;
                    color: Theme.text-primary;
                    y: (parent.height - self.height) / 2;
                    vertical-stretch: 1;
                }

                Text {
                    text: total-votes > 0 ? Math.round(votes[idx] * 100 / total-votes) + "%" : "0%";
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-medium;
                    color: Theme.text-secondary;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        Text {
            text: total-votes + " votes";
            font-size: Theme.text-xs;
            color: Theme.text-tertiary;
        }
    }
}
