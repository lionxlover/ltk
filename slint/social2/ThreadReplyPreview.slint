import { Theme } from "../core/Theme.slint";

export component ThreadReplyPreview inherits Rectangle {
    background: Theme.bg-surface;
    border-radius: Theme.radius-sm;
    clip: true;
    in property <string> reply-to: "Alice";
    in property <string> preview-text: "That sounds great!";

    HorizontalLayout {
        // A left accent bar, not a uniform border — border-color alone
        // (with no border-width) never rendered anything at all. This
        // also matches the standard "replying to" quote-bar convention
        // more closely than a full border would.
        Rectangle {
            width: 3px;
            background: Theme.accent;
        }

        VerticalLayout {
            padding: Theme.sp-2;
            spacing: 2px;

            Text {
                text: "Replying to " + reply-to;
                font-size: Theme.text-xs;
                font-weight: Theme.weight-semibold;
                color: Theme.accent;
            }

            Text {
                text: preview-text;
                font-size: Theme.text-sm;
                color: Theme.text-secondary;
                overflow: elide;
            }
        }
    }
}
