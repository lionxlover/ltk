import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component DirectMessageHeader inherits Rectangle {
    background: Theme.bg-raised;
    height: 56px;
    clip: true;

    in property <string> user-name: "Alice";
    in property <string> status: "online";
    in property <string> avatar: "A";
    callback call-clicked();
    callback video-clicked();

    HorizontalLayout {
        padding-left: Theme.sp-4;
        padding-right: Theme.sp-4;
        spacing: Theme.sp-3;

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: Theme.accent-subtle;
            y: 8px;

            Text {
                text: avatar;
                font-size: Theme.text-sm;
                font-weight: Theme.weight-semibold;
                color: Theme.accent;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 2px;
            y: 10px;

            Text {
                text: user-name;
                font-size: Theme.text-base;
                font-weight: Theme.weight-semibold;
                color: Theme.text-primary;
            }

            HorizontalLayout {
                spacing: Theme.sp-1;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: status == "online" ? Theme.success : Theme.text-tertiary;
                    y: 2px;
                }

                Text {
                    text: status;
                    font-size: Theme.text-xs;
                    color: Theme.text-tertiary;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            y: 12px;
            background: call-ta.has-hover ? Theme.hover-overlay : transparent;

            FaIcon {
                source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/phone.svg");
                fa-size: 14px;
                fa-color: Theme.text-secondary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            call-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.call-clicked(); }
            }
        }

        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            y: 12px;
            background: video-ta.has-hover ? Theme.hover-overlay : transparent;

            FaIcon {
                source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/video-camera.svg");
                fa-size: 14px;
                fa-color: Theme.text-secondary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            video-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.video-clicked(); }
            }
        }
    }

    // Bottom separator — border-color with no border-width never
    // rendered anything at all; a real accent Rectangle instead of
    // guessing at an unconfirmed per-side border API.
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border-default;
    }
}
