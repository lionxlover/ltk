import { Theme } from "../core/Theme.slint";

export component DirectMessageHeader inherits Rectangle {
    background: Theme.bg-raised;
    border-color: Theme.border-default;
    height: 56px;

    in property <string> user-name: "Alice";
    in property <string> status: "online";
    in property <string> avatar: "A";

    HorizontalLayout {
        padding-left: Theme.sp-4;
        padding-right: Theme.sp-4;
        spacing: Theme.sp-3;

        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: Theme.accent-subtle;
            y: 8px;

            Text {
                text: avatar;
                font-size: Theme.text-sm;
                font-weight: Theme.weight-semibold;
                color: Theme.accent;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 2px;
            y: 10px;

            Text {
                text: user-name;
                font-size: Theme.text-base;
                font-weight: Theme.weight-semibold;
                color: Theme.text-primary;
            }

            HorizontalLayout {
                spacing: Theme.sp-1;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: status == "online" ? Theme.success : Theme.text-tertiary;
                    y: 2px;
                }

                Text {
                    text: status;
                    font-size: Theme.text-xs;
                    color: Theme.text-tertiary;
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            y: 12px;

            Text {
                text: "📞";
                font-size: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            y: 12px;

            Text {
                text: "📹";
                font-size: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}
