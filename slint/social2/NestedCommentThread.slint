import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component NestedCommentThread inherits Rectangle {
    background: transparent;

    in property <string> author: "Alice";
    in property <string> text: "Great work!";
    in property <int> depth: 0;
    in property <int> like-count: 2;
    in-out property <bool> liked: false;
    callback reply-clicked();

    HorizontalLayout {
        spacing: Theme.sp-2;

        if depth > 0: Rectangle {
            width: depth * 24px;
        }

        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;
            background: Theme.accent-subtle;
            y: 2px;

            Text {
                text: author;
                font-size: Theme.text-xs;
                font-weight: Theme.weight-semibold;
                color: Theme.accent;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 2px;

            HorizontalLayout {
                spacing: Theme.sp-2;

                Text {
                    text: author;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-semibold;
                    color: Theme.text-primary;
                    y: 1px;
                }

                Text {
                    text: "2h ago";
                    font-size: Theme.text-xs;
                    color: Theme.text-tertiary;
                    y: 2px;
                }
            }

            Text {
                text: text;
                font-size: Theme.text-sm;
                color: Theme.text-secondary;
            }

            HorizontalLayout {
                spacing: Theme.sp-3;
                height: 24px;

                like-ta := TouchArea {
                    clicked => { root.liked = !root.liked; }

                    HorizontalLayout {
                        spacing: 3px;
                        FaIcon {
                            source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/thumbs-up.svg");
                            fa-size: 10px;
                            fa-color: root.liked ? Theme.accent : Theme.text-tertiary;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: root.liked ? root.like-count + 1 : root.like-count;
                            font-size: Theme.text-xs;
                            color: root.liked ? Theme.accent : Theme.text-tertiary;
                            y: 1px;
                        }
                    }
                }

                reply-ta := TouchArea {
                    clicked => { root.reply-clicked(); }
                    Text {
                        text: "Reply";
                        font-size: Theme.text-xs;
                        color: Theme.accent;
                        y: 2px;
                    }
                }
            }
        }
    }
}
