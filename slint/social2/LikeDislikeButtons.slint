import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component LikeDislikeButtons inherits Rectangle {
    background: transparent;

    in-out property <bool> liked: false;
    in-out property <bool> disliked: false;
    in property <int> like-count: 42;
    in property <int> dislike-count: 3;

    HorizontalLayout {
        spacing: Theme.sp-2;

        Rectangle {
            height: 32px;
            border-radius: self.height / 2;
            background: liked ? Theme.accent-subtle : transparent;
            border-width: 1px;
            border-color: liked ? Theme.accent : Theme.border-default;

            HorizontalLayout {
                padding-left: Theme.sp-2;
                padding-right: Theme.sp-2;
                spacing: Theme.sp-1;

                FaIcon {
                    source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/thumbs-up.svg");
                    fa-size: 12px;
                    fa-color: liked ? Theme.accent : Theme.text-secondary;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: "\{root.like-count}";
                    font-size: Theme.text-xs;
                    font-weight: Theme.weight-medium;
                    color: liked ? Theme.accent : Theme.text-secondary;
                    y: (parent.height - self.height) / 2;
                }
            }

            TouchArea {
                clicked => { root.liked = !root.liked; if root.liked { root.disliked = false; } }
            }
        }

        Rectangle {
            height: 32px;
            border-radius: self.height / 2;
            background: disliked ? Theme.error : transparent;
            border-width: 1px;
            border-color: disliked ? Theme.error : Theme.border-default;

            HorizontalLayout {
                padding-left: Theme.sp-2;
                padding-right: Theme.sp-2;
                spacing: Theme.sp-1;

                FaIcon {
                    source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/thumbs-down.svg");
                    fa-size: 12px;
                    fa-color: disliked ? #ffffff : Theme.text-secondary;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: "\{root.dislike-count}";
                    font-size: Theme.text-xs;
                    font-weight: Theme.weight-medium;
                    color: disliked ? #ffffff : Theme.text-secondary;
                    y: (parent.height - self.height) / 2;
                }
            }

            TouchArea {
                clicked => { root.disliked = !root.disliked; if root.disliked { root.liked = false; } }
            }
        }
    }
}
