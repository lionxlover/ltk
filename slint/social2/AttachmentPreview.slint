import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component AttachmentPreview inherits Rectangle {
    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    in property <string> file-name: "document.pdf";
    in property <string> file-type: "pdf";
    in property <string> file-size: "2.4 MB";
    callback removed();

    width: 200px;
    height: 64px;

    HorizontalLayout {
        padding: Theme.sp-2;
        spacing: Theme.sp-2;

        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: Theme.radius-sm;
            background: Theme.bg-overlay;
            y: 4px;

            FaIcon {
                source: file-type == "pdf"
                    ? @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/file-pdf.svg")
                    : file-type == "image"
                        ? @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/image.svg")
                        : @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/paperclip.svg");
                fa-size: 18px;
                fa-color: Theme.text-secondary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 2px;
            y: 10px;

            Text {
                text: file-name;
                font-size: Theme.text-sm;
                font-weight: Theme.weight-medium;
                color: Theme.text-primary;
                overflow: elide;
            }

            Text {
                text: file-size;
                font-size: Theme.text-xs;
                color: Theme.text-tertiary;
            }
        }

        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 12px;
            y: 20px;
            background: remove-ta.has-hover ? Theme.hover-overlay : transparent;

            Text {
                text: "×";
                font-size: 12px;
                color: Theme.text-tertiary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            remove-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.removed(); }
            }
        }
    }
}
