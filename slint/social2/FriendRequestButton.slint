import { Theme } from "../core/Theme.slint";

export component FriendRequestButton inherits Rectangle {
    background: transparent;

    in property <string> state: "pending";
    callback add-friend-clicked();
    callback accept-clicked();
    callback decline-clicked();

    width: 120px;
    height: 36px;

    if state == "none": Rectangle {
        width: 120px;
        height: 36px;
        border-radius: self.height / 2;
        background: add-ta.has-hover ? Theme.accent-dim : Theme.accent;

        Text {
            text: "Add Friend";
            font-size: Theme.text-sm;
            font-weight: Theme.weight-semibold;
            color: #ffffff;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        add-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.add-friend-clicked(); }
        }
    }

    if state == "pending": Rectangle {
        width: 120px;
        height: 36px;
        border-radius: self.height / 2;
        border-width: 1px;
        border-color: Theme.border-default;

        Text {
            text: "Requested";
            font-size: Theme.text-sm;
            color: Theme.text-secondary;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    if state == "accept": HorizontalLayout {
        spacing: Theme.sp-2;

        Rectangle {
            width: 60px;
            height: 36px;
            border-radius: self.height / 2;
            background: accept-ta.has-hover ? Theme.accent-dim : Theme.accent;

            Text {
                text: "Accept";
                font-size: Theme.text-sm;
                font-weight: Theme.weight-semibold;
                color: #ffffff;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            accept-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.accept-clicked(); }
            }
        }

        Rectangle {
            width: 60px;
            height: 36px;
            border-radius: self.height / 2;
            border-width: 1px;
            border-color: Theme.border-default;
            background: decline-ta.has-hover ? Theme.hover-overlay : transparent;

            Text {
                text: "Decline";
                font-size: Theme.text-sm;
                color: Theme.text-secondary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            decline-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.decline-clicked(); }
            }
        }
    }
}
