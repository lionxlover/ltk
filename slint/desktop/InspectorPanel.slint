import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component InspectorPanel inherits Rectangle {
    in property <string> title: "Inspector";
    in-out property <string> obj-x: "0";
    in-out property <string> obj-y: "0";
    in-out property <string> obj-width: "100";
    in-out property <string> obj-height: "100";

    background: Theme.bg-sidebar;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        spacing: 0px;

        // Header
        Rectangle {
            background: Theme.bg-headerbar;
            height: 40px;
            border-radius: Theme.radius-md;

            HorizontalLayout {
                padding-left: Theme.sp-3;
                padding-right: Theme.sp-3;
                spacing: Theme.sp-2;

                FaIcon {
                    source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/eye.svg");
                    fa-size: 14px;
                    fa-color: Theme.accent;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.title;
                    color: Theme.text-primary;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                }
            }
        }

        // Content
        Rectangle {
            background: Theme.bg-sidebar;

            VerticalLayout {
                padding: Theme.sp-3;
                spacing: Theme.sp-2;

                // Placeholder property rows
                HorizontalLayout {
                    spacing: Theme.sp-2;
                    height: 28px;

                    Text {
                        text: "X";
                        color: Theme.text-tertiary;
                        font-size: Theme.text-xs;
                        font-weight: Theme.weight-medium;
                        vertical-alignment: center;
                        width: 40px;
                    }

                    Rectangle {
                        background: Theme.bg-raised;
                        border-radius: Theme.radius-xs;
                        border-width: 1px;
                        border-color: x-input.has-focus ? Theme.accent : Theme.border-subtle;
                        height: 26px;

                        x-input := TextInput {
                            text <=> root.obj-x;
                            input-type: InputType.decimal;
                            color: Theme.text-primary;
                            font-size: Theme.text-xs;
                            font-family: Theme.font-mono;
                            x: Theme.sp-2;
                            width: parent.width - Theme.sp-2 * 2;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.sp-2;
                    height: 28px;

                    Text {
                        text: "Y";
                        color: Theme.text-tertiary;
                        font-size: Theme.text-xs;
                        font-weight: Theme.weight-medium;
                        vertical-alignment: center;
                        width: 40px;
                    }

                    Rectangle {
                        background: Theme.bg-raised;
                        border-radius: Theme.radius-xs;
                        border-width: 1px;
                        border-color: y-input.has-focus ? Theme.accent : Theme.border-subtle;
                        height: 26px;

                        y-input := TextInput {
                            text <=> root.obj-y;
                            input-type: InputType.decimal;
                            color: Theme.text-primary;
                            font-size: Theme.text-xs;
                            font-family: Theme.font-mono;
                            x: Theme.sp-2;
                            width: parent.width - Theme.sp-2 * 2;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.sp-2;
                    height: 28px;

                    Text {
                        text: "W";
                        color: Theme.text-tertiary;
                        font-size: Theme.text-xs;
                        font-weight: Theme.weight-medium;
                        vertical-alignment: center;
                        width: 40px;
                    }

                    Rectangle {
                        background: Theme.bg-raised;
                        border-radius: Theme.radius-xs;
                        border-width: 1px;
                        border-color: w-input.has-focus ? Theme.accent : Theme.border-subtle;
                        height: 26px;

                        w-input := TextInput {
                            text <=> root.obj-width;
                            input-type: InputType.decimal;
                            color: Theme.text-primary;
                            font-size: Theme.text-xs;
                            font-family: Theme.font-mono;
                            x: Theme.sp-2;
                            width: parent.width - Theme.sp-2 * 2;
                            vertical-alignment: center;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.sp-2;
                    height: 28px;

                    Text {
                        text: "H";
                        color: Theme.text-tertiary;
                        font-size: Theme.text-xs;
                        font-weight: Theme.weight-medium;
                        vertical-alignment: center;
                        width: 40px;
                    }

                    Rectangle {
                        background: Theme.bg-raised;
                        border-radius: Theme.radius-xs;
                        border-width: 1px;
                        border-color: h-input.has-focus ? Theme.accent : Theme.border-subtle;
                        height: 26px;

                        h-input := TextInput {
                            text <=> root.obj-height;
                            input-type: InputType.decimal;
                            color: Theme.text-primary;
                            font-size: Theme.text-xs;
                            font-family: Theme.font-mono;
                            x: Theme.sp-2;
                            width: parent.width - Theme.sp-2 * 2;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
