import { Theme } from "../core/Theme.slint";

export component NumericBadge inherits Rectangle {
    in property <int> count: 0;
    in property <int> max-count: 99;

    min-width: 20px;
    height: 20px;
    background: Theme.state-error;
    border-radius: Theme.radius-full;
    horizontal-stretch: 0;

    label := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: count > root.max-count ? (root.max-count > 9 ? "99+" : "+" + root.max-count) : "" + count;
        color: #ffffff;
        font-family: Theme.font-ui;
        font-size: Theme.text-xs;
        font-weight: Theme.weight-semibold;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}
