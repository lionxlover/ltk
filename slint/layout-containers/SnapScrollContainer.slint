import { Theme } from "../core/Theme.slint";

// Same constraint as FlexContainer: @children must be unconditional and
// can only appear once, so a single instance can't swap between a
// HorizontalLayout and a VerticalLayout based on `horizontal`. This
// commits to vertical snapping (matching the default) — for horizontal
// snap-scrolling, wrap content in a HorizontalLayout yourself before
// passing it in, or request a dedicated HorizontalSnapScrollContainer.
export component SnapScrollContainer inherits Rectangle {
    background: transparent;
    clip: true;

    in property <int> snap-count: 4;
    in property <int> current-snap: 0;
    in property <bool> show-dots: true;

    Flickable {
        viewport-height: snap-count * parent.height;

        VerticalLayout {
            @children
        }
    }

    if show-dots: Rectangle {
        x: (parent.width - snap-count * 12px) / 2;
        y: parent.height - 20px;
        width: snap-count * 12px;
        height: 12px;

        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            for dot[idx] in snap-count: Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: idx == current-snap ? Theme.accent : Theme.text-tertiary;
            }
        }
    }
}
