import { Theme } from "../core/Theme.slint";

// Same limitation as MasonryGrid: true waterfall/masonry packing needs
// each item's rendered height up front to balance columns, which Slint
// can't get from opaque @children. This falls back to a uniform
// GridLayout (regular rows/columns) rather than faking uneven packing.
export component WaterfallLayout inherits Rectangle {
    background: transparent;
    clip: true;

    in property <int> columns: 3;
    in property <length> gap: 12px;

    Flickable {
        GridLayout {
            spacing: gap;
            @children
        }
    }
}
