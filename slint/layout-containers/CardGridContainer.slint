import { Theme } from "../core/Theme.slint";

export component CardGridContainer inherits Rectangle {
    background: transparent;

    in property <int> columns: 3;
    in property <length> gap: 16px;
    in property <length> min-card-width: 280px;

    // Uniform grid: children fill in row-major order via `row`/`col`, or
    // simply omit them and let GridLayout auto-flow left-to-right/top-down.
    Flickable {
        GridLayout {
            spacing: gap;
            @children
        }
    }
}
