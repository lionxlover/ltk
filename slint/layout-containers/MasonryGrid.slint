import { Theme } from "../core/Theme.slint";

// True masonry packing needs each item's rendered height to balance
// columns, and Slint gives no way to introspect the size of opaque
// @children up front. This falls back to a uniform GridLayout — regular
// rows/columns, not uneven-height packing — which is an honest reduced
// version rather than a fake masonry effect.
export component MasonryGrid inherits Rectangle {
    background: transparent;
    clip: true;

    in property <int> columns: 3;
    in property <length> gap: 12px;
    in property <length> item-min-height: 120px;

    Flickable {
        GridLayout {
            spacing: gap;
            @children
        }
    }
}
