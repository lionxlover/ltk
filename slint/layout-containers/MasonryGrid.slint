import { Theme } from "../core/Theme.slint";

export component MasonryGrid inherits Rectangle {
    background: transparent;
    clip: true;

    in property <int> columns: 3;
    in property <length> gap: 12px;
    in property <length> item-min-height: 120px;

    // Simulated masonry using fixed column layout
    HorizontalLayout {
        spacing: gap;

        for col_idx[ci] in columns: VerticalLayout {
            vertical-stretch: 1;
            spacing: gap;
            width: parent.width / columns - gap;
        }
    }
}
