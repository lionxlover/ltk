import { Theme } from "../core/Theme.slint";

export component SpacerBox inherits Rectangle {
    background: transparent;

    in property <length> size: 16px;
    in property <bool> horizontal: false;

    if horizontal: Rectangle {
        width: root.size;
        height: 100%;
    }

    if !horizontal: Rectangle {
        width: 100%;
        height: root.size;
    }
}
