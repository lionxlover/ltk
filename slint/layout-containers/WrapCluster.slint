import { Theme } from "../core/Theme.slint";

// Slint's box layouts have no CSS-style flex-wrap, so this is a single-row
// scrollable cluster rather than a true wrapping one — see FlexContainer
// for the same limitation spelled out in more detail.
export component WrapCluster inherits Rectangle {
    background: transparent;
    clip: true;

    in property <length> gap: 8px;
    in property <string> alignment: "start";

    Flickable {
        HorizontalLayout {
            spacing: gap;
            @children
        }
    }
}
