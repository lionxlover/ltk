import { Theme } from "../core/Theme.slint";

export component InfiniteScrollWrapper inherits Rectangle {
    background: transparent;

    in property <bool> loading: false;
    in property <bool> has-more: true;

    // Fires when the scroll position nears the bottom, so the host can
    // fetch the next page. Whether `changed <child>.<property>` is valid
    // for a property on a *nested* element (vs. one on `root` itself) is
    // unconfirmed in this project's own notes, so this deliberately
    // doesn't guess at wiring an automatic scroll-position trigger — the
    // host should call `load-more` itself when it detects the Flickable
    // nearing its viewport end (e.g. from its own scroll-position binding).
    callback load-more();

    Flickable {
        vertical-stretch: 1;

        VerticalLayout {
            spacing: Theme.sp-4;
            @children
        }
    }

    if loading: Rectangle {
        y: parent.height - 48px;
        height: 48px;
        background: Theme.bg-surface;

        Text {
            text: "Loading...";
            font-size: Theme.text-sm;
            color: Theme.text-tertiary;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}
