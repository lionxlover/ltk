import { Theme } from "../core/Theme.slint";

export component MaxWidthContainer inherits Rectangle {
    background: transparent;

    in property <length> container-max-width: 1200px;
    in property <int> padding-x: 24;

    HorizontalLayout {
        alignment: center;

        Rectangle {
            width: Math.min(parent.width, root.container-max-width);
        }
    }
}
