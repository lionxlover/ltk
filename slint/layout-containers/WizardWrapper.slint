import { Theme } from "../core/Theme.slint";

// Per-step content has the same fundamental limitation as any multi-slot
// component: a single @children placeholder can't be routed to a
// different pane per step index. This exposes ONE content region that
// always shows whatever was passed in; switching steps changes
// `current-step` for the host to react to (e.g. via a `for`/`if` over its
// own model keyed on `current-step`), but doesn't by itself swap the
// displayed content.
export component WizardWrapper inherits Rectangle {
    background: transparent;

    in property <int> total-steps: 4;
    in-out property <int> current-step: 0;
    in property <[string]> step-labels: [];

    in property <bool> show-back: true;
    in property <bool> show-next: true;
    in property <bool> show-finish: false;

    callback step-changed(int);
    callback finished();

    VerticalLayout {
        spacing: Theme.sp-4;

        // Progress
        HorizontalLayout {
            spacing: Theme.sp-2;
            height: 4px;

            for step_idx[idx] in total-steps: Rectangle {
                horizontal-stretch: 1;
                height: 4px;
                border-radius: 2px;
                background: idx <= current-step ? Theme.accent : Theme.border-default;
            }
        }

        // Step labels
        if step-labels.length > 0: HorizontalLayout {
            spacing: Theme.sp-4;
            height: 24px;

            for label[idx] in step-labels: Text {
                text: label;
                font-size: Theme.text-xs;
                color: idx == current-step ? Theme.accent : Theme.text-tertiary;
                font-weight: idx == current-step ? Theme.weight-semibold : Theme.weight-regular;
            }
        }

        // Content area
        Rectangle {
            vertical-stretch: 1;
            @children
        }

        // Navigation buttons
        HorizontalLayout {
            spacing: Theme.sp-3;
            height: 40px;
            alignment: end;

            if show-back: Rectangle {
                width: 80px;
                height: 36px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;

                Text {
                    text: "Back";
                    font-size: Theme.text-sm;
                    color: Theme.text-primary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                TouchArea {
                    enabled: current-step > 0;
                    clicked => {
                        if current-step > 0 {
                            current-step -= 1;
                            root.step-changed(current-step);
                        }
                    }
                }
            }

            if show-next: Rectangle {
                width: 80px;
                height: 36px;
                border-radius: Theme.radius-md;
                background: Theme.accent;

                Text {
                    text: "Next";
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-medium;
                    color: #ffffff;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                TouchArea {
                    enabled: current-step < total-steps - 1;
                    clicked => {
                        if current-step < total-steps - 1 {
                            current-step += 1;
                            root.step-changed(current-step);
                        }
                    }
                }
            }

            if show-finish: Rectangle {
                width: 80px;
                height: 36px;
                border-radius: Theme.radius-md;
                background: Theme.success;

                Text {
                    text: "Finish";
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-medium;
                    color: #ffffff;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                TouchArea {
                    clicked => { root.finished(); }
                }
            }
        }
    }
}
