import { Theme } from "../core/Theme.slint";

export component MasterDetailSplit inherits Rectangle {
    background: transparent;
    clip: true;

    in property <length> master-width: 320px;
    in property <length> split-position: 4px;

    // Only one @children slot is possible per component — the detail
    // (right) pane carries the content; the master pane is chrome-only.
    // Compose both panes directly in the host if the master list also
    // needs custom content.
    HorizontalLayout {
        Rectangle {
            width: master-width;
            background: Theme.bg-surface;
        }

        Rectangle {
            width: split-position;
            background: Theme.border-default;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg-base;
            @children
        }
    }
}
