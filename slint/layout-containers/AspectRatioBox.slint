import { Theme } from "../core/Theme.slint";

export component AspectRatioBox inherits Rectangle {
    background: transparent;
    clip: true;

    in property <int> ratio-numerator: 16;
    in property <int> ratio-denominator: 9;
    in property <bool> use-width: true;
    // Used only for the unimplemented `use-width: false` branch below.
    // `parent.height` was tried as a fallback, but `parent` doesn't exist
    // when this component is the top-level/root element (e.g. previewed
    // standalone in Slint Preview, or used directly as a window's
    // content) — "Cannot access id 'parent'" is a real error there, not
    // just a missing-parent edge case. An explicit `in property` has no
    // such requirement and can never be self-referential either.
    in property <length> fallback-height: 200px;

    // Only `height` is ever bound here — never `width` too. Having both
    // `width` and `height` reciprocally reference each other (even inside
    // mutually-exclusive ternary branches) creates a real binding-loop
    // error, because Slint's dependency graph is built per-property from
    // the textual bindings, not per-branch at runtime (see
    // debugging-and-mcp.md's "Binding loops" note). So this only supports
    // the width-driven direction: given a width (explicit, or from a
    // parent layout), it derives height. The `use-width: false` case is a
    // known, documented gap rather than a guess — if the host needs a
    // height-driven box, compute the width externally
    // (`height / ratio_denominator * ratio_numerator`) and set it directly
    // on the instance instead of relying on this component to infer it.
    //
    // The `height` binding must never read `self.height` either — that's
    // the exact same binding-loop shape (a property depending on itself),
    // just self-referential instead of cross-referential with `width`.
    height: use-width ? (self.width / 1px * ratio-denominator / ratio-numerator) * 1px : fallback-height;

    @children
}
