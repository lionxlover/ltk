import { Theme } from "../core/Theme.slint";

export component AccordionGroup inherits Rectangle {
    background: transparent;
    clip: true;

    in property <bool> allow-multiple: false;

    VerticalLayout {
        spacing: 2px;
    }
}

export component AccordionItem inherits Rectangle {
    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    in property <string> title: "";
    in-out property <bool> expanded: false;

    height: expanded ? 160px : 40px;

    Rectangle {
        height: 40px;
        border-radius: Theme.radius-md;

        HorizontalLayout {
            padding-left: Theme.sp-4;
            padding-right: Theme.sp-4;

            Text {
                text: title;
                font-size: Theme.text-sm;
                font-weight: Theme.weight-medium;
                color: Theme.text-primary;
                y: (parent.height - self.height) / 2;
                vertical-stretch: 1;
            }

            Text {
                text: expanded ? "▾" : "▸";
                font-size: 12px;
                color: Theme.text-tertiary;
                y: (parent.height - self.height) / 2;
            }
        }

        TouchArea {
            clicked => { root.expanded = !root.expanded; }
        }
    }
}
