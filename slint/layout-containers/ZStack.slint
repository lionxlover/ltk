import { Theme } from "../core/Theme.slint";

export component ZStack inherits Rectangle {
    background: transparent;
    clip: true;

    in property <string> alignment: "center";

    // Children are stacked on top of each other (later siblings render on
    // top, per Slint's normal z-order); each child should set x/y (or
    // width:100%/height:100% to fill) for absolute positioning within
    // this Rectangle.
    @children
}
