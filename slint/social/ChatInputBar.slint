import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component ChatInputBar inherits Rectangle {
    in property <string> placeholder: "";

    callback message-sent(string);

    width: 100%;
    height: 48px;
    background: Theme.bg-surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-2;
        spacing: Theme.sp-2;
        alignment: stretch;

        chat-input := TextInput {
            text: "";
            color: Theme.text-primary;
            font-family: Theme.font-ui;
            font-size: Theme.text-base;
            vertical-alignment: center;
            horizontal-stretch: 1;
            accepted => {
                if (self.text != "") {
                    root.message-sent(self.text);
                    self.text = "";
                }
            }

            Text {
                x: 0;
                y: (parent.height - self.height) / 2;
                text: root.placeholder;
                color: Theme.text-placeholder;
                font-family: Theme.font-ui;
                font-size: Theme.text-base;
                vertical-alignment: center;
                visible: parent.text == "";
            }
        }

        Rectangle {
            width: 36px;
            height: 36px;
            y: (parent.height - self.height) / 2;
            background: send-area.has-hover ? Theme.accent-dim : Theme.accent;
            border-radius: Theme.radius-full;
            horizontal-stretch: 0;

            FaIcon {
                source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/paper-plane.svg");
                fa-size: 14px;
                fa-color: Theme.on-accent;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            send-area := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    if (chat-input.text != "") {
                        root.message-sent(chat-input.text);
                        chat-input.text = "";
                    }
                }
            }
        }
    }
}
