import { Theme } from "../core/Theme.slint";

export component TypingIndicator inherits Rectangle {
    width: self.preferred-width;
    height: 36px;
    background: Theme.bg-overlay;
    border-radius: Theme.radius-lg;

    // The dots pulse in sequence, one at a time, driven by this counter —
    // an `animate` on opacity does nothing unless something actually
    // changes the value it's watching (SLINT-GOTCHAS-DISCOVERED.md:
    // "Infinite animation loop needs a nudge, not a static binding").
    private property <int> active-dot: 0;

    Timer {
        interval: 300ms;
        running: true;
        triggered => {
            root.active-dot = Math.mod(root.active-dot + 1, 3);
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-3;

        Rectangle {
            width: 7px;
            height: 7px;
            background: Theme.text-tertiary;
            border-radius: Theme.radius-full;
            y: (parent.height - self.height) / 2;
            opacity: root.active-dot == 0 ? 1.0 : 0.3;
            animate opacity { duration: 200ms; easing: Theme.ease-in-out; }
        }

        Rectangle {
            width: 7px;
            height: 7px;
            background: Theme.text-tertiary;
            border-radius: Theme.radius-full;
            y: (parent.height - self.height) / 2;
            opacity: root.active-dot == 1 ? 1.0 : 0.3;
            animate opacity { duration: 200ms; easing: Theme.ease-in-out; }
        }

        Rectangle {
            width: 7px;
            height: 7px;
            background: Theme.text-tertiary;
            border-radius: Theme.radius-full;
            y: (parent.height - self.height) / 2;
            opacity: root.active-dot == 2 ? 1.0 : 0.3;
            animate opacity { duration: 200ms; easing: Theme.ease-in-out; }
        }
    }
}
