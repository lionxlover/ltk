import { Theme } from "../core/Theme.slint";

export component ChatBubbleSent inherits Rectangle {
    in property <string> message: "";
    in property <string> time: "";

    width: 100%;
    horizontal-stretch: 1;

    HorizontalLayout {
        alignment: end;
        spacing: Theme.sp-1;

        VerticalLayout {
            alignment: end;
            spacing: Theme.sp-1;
            horizontal-stretch: 1;
            max-width: parent.width * 0.75;

            Rectangle {
                background: Theme.accent;
                border-radius: Theme.radius-md;
                horizontal-stretch: 1;
                vertical-stretch: 0;
                min-height: self.preferred-height;

                VerticalLayout {
                    padding: Theme.sp-3;

                    Text {
                        text: root.message;
                        color: Theme.on-accent;
                        font-family: Theme.font-ui;
                        font-size: Theme.text-base;
                        wrap: word-wrap;
                        width: 100%;
                    }
                }
            }

            Text {
                text: root.time;
                color: Theme.text-tertiary;
                font-family: Theme.font-ui;
                font-size: Theme.text-xs;
                horizontal-alignment: right;
            }
        }
    }
}
