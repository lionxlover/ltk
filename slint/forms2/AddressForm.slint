import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component AddressForm inherits Rectangle {
    background: Theme.bg-surface;
    border-radius: Theme.radius-xl;
    border-width: 1px;
    border-color: Theme.border-default;
    width: 400px;

    callback cancelled();
    callback saved(string, string, string, string, string, string);
    callback country-clicked();

    VerticalLayout {
        padding: Theme.sp-6;
        spacing: Theme.sp-4;

        Text { text: "Address"; font-size: Theme.text-xl; font-weight: Theme.weight-bold; color: Theme.text-primary; }

        VerticalLayout { spacing: Theme.sp-1;
            Text { text: "Street Address"; font-size: Theme.text-sm; font-weight: Theme.weight-medium; color: Theme.text-primary; }
            Rectangle { height: 40px; border-radius: Theme.radius-md; border-width: 1px; border-color: street-input.has-focus ? Theme.border-focus : Theme.border-default; clip: true;
                street-input := TextInput { text: "123 Main St"; font-size: Theme.text-sm; color: Theme.text-primary; x: Theme.sp-3; width: parent.width - Theme.sp-3 * 2; y: (parent.height - self.height) / 2; single-line: true; }
            }
        }

        VerticalLayout { spacing: Theme.sp-1;
            Text { text: "Apt / Suite"; font-size: Theme.text-sm; font-weight: Theme.weight-medium; color: Theme.text-primary; }
            Rectangle { height: 40px; border-radius: Theme.radius-md; border-width: 1px; border-color: apt-input.has-focus ? Theme.border-focus : Theme.border-default; clip: true;
                apt-input := TextInput { text: ""; font-size: Theme.text-sm; color: Theme.text-primary; x: Theme.sp-3; width: parent.width - Theme.sp-3 * 2; y: (parent.height - self.height) / 2; single-line: true; }
                if apt-input.text == "": Text { text: "Apt 4B"; font-size: Theme.text-sm; color: Theme.text-tertiary; x: Theme.sp-3; y: (parent.height - self.height) / 2; }
            }
        }

        HorizontalLayout { spacing: Theme.sp-3;
            VerticalLayout { spacing: Theme.sp-1; horizontal-stretch: 1;
                Text { text: "City"; font-size: Theme.text-sm; font-weight: Theme.weight-medium; color: Theme.text-primary; }
                Rectangle { height: 40px; border-radius: Theme.radius-md; border-width: 1px; border-color: city-input.has-focus ? Theme.border-focus : Theme.border-default; clip: true;
                    city-input := TextInput { text: "New York"; font-size: Theme.text-sm; color: Theme.text-primary; x: Theme.sp-3; width: parent.width - Theme.sp-3 * 2; y: (parent.height - self.height) / 2; single-line: true; }
                }
            }
            VerticalLayout { spacing: Theme.sp-1; horizontal-stretch: 1;
                Text { text: "State"; font-size: Theme.text-sm; font-weight: Theme.weight-medium; color: Theme.text-primary; }
                Rectangle { height: 40px; border-radius: Theme.radius-md; border-width: 1px; border-color: state-input.has-focus ? Theme.border-focus : Theme.border-default; clip: true;
                    state-input := TextInput { text: "NY"; font-size: Theme.text-sm; color: Theme.text-primary; x: Theme.sp-3; width: parent.width - Theme.sp-3 * 2; y: (parent.height - self.height) / 2; single-line: true; }
                }
            }
        }

        HorizontalLayout { spacing: Theme.sp-3;
            VerticalLayout { spacing: Theme.sp-1; horizontal-stretch: 1;
                Text { text: "ZIP Code"; font-size: Theme.text-sm; font-weight: Theme.weight-medium; color: Theme.text-primary; }
                Rectangle { height: 40px; border-radius: Theme.radius-md; border-width: 1px; border-color: zip-input.has-focus ? Theme.border-focus : Theme.border-default; clip: true;
                    zip-input := TextInput { text: "10001"; font-size: Theme.text-sm; color: Theme.text-primary; x: Theme.sp-3; width: parent.width - Theme.sp-3 * 2; y: (parent.height - self.height) / 2; single-line: true; }
                }
            }
            VerticalLayout { spacing: Theme.sp-1; horizontal-stretch: 1;
                Text { text: "Country"; font-size: Theme.text-sm; font-weight: Theme.weight-medium; color: Theme.text-primary; }
                Rectangle { height: 40px; border-radius: Theme.radius-md; border-width: 1px; border-color: Theme.border-default; background: country-ta.has-hover ? Theme.hover-overlay : transparent;
                    Text { text: "United States"; font-size: Theme.text-sm; color: Theme.text-primary; x: Theme.sp-3; y: (parent.height - self.height) / 2; }
                    FaIcon { source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/chevron-down.svg"); fa-size: 10px; fa-color: Theme.text-tertiary; x: parent.width - self.width - Theme.sp-3; y: (parent.height - self.height) / 2; }
                    country-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.country-clicked(); } }
                }
            }
        }

        HorizontalLayout { spacing: Theme.sp-3; alignment: end;
            Rectangle { width: 80px; height: 36px; border-radius: Theme.radius-md; border-width: 1px; border-color: Theme.border-default; background: cancel-ta.has-hover ? Theme.hover-overlay : transparent;
                Text { text: "Cancel"; font-size: Theme.text-sm; color: Theme.text-primary; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                cancel-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.cancelled(); } }
            }
            Rectangle { width: 80px; height: 36px; border-radius: Theme.radius-md; background: save-ta.has-hover ? Theme.accent-dim : Theme.accent;
                Text { text: "Save"; font-size: Theme.text-sm; font-weight: Theme.weight-medium; color: #ffffff; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                save-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.saved(street-input.text, apt-input.text, city-input.text, state-input.text, zip-input.text, "United States"); }
                }
            }
        }
    }
}
