import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component PasswordResetForm inherits Rectangle {
    background: Theme.bg-surface;
    border-radius: Theme.radius-xl;
    border-width: 1px;
    border-color: Theme.border-default;
    width: 360px;

    callback reset-requested(string);
    callback back-to-sign-in-clicked();

    VerticalLayout {
        padding: Theme.sp-6;
        spacing: Theme.sp-4;
        alignment: center;

        FaIcon {
            source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/key.svg");
            fa-size: 28px;
            fa-color: Theme.accent;
            x: (parent.width - self.width) / 2;
        }

        VerticalLayout { spacing: Theme.sp-1; alignment: center;
            Text { text: "Reset Password"; font-size: Theme.text-2xl; font-weight: Theme.weight-bold; color: Theme.text-primary; horizontal-alignment: center; }
            Text { text: "Enter your email to receive a reset link"; font-size: Theme.text-sm; color: Theme.text-tertiary; horizontal-alignment: center; }
        }

        VerticalLayout { spacing: Theme.sp-1;
            Text { text: "Email"; font-size: Theme.text-sm; font-weight: Theme.weight-medium; color: Theme.text-primary; }
            Rectangle { height: 40px; border-radius: Theme.radius-md; border-width: 1px; border-color: email-input.has-focus ? Theme.border-focus : Theme.border-default; clip: true;
                email-input := TextInput { text: ""; font-size: Theme.text-sm; color: Theme.text-primary; x: Theme.sp-3; width: parent.width - Theme.sp-3 * 2; y: (parent.height - self.height) / 2; single-line: true;
                    accepted => { root.reset-requested(self.text); } }
                if email-input.text == "": Text { text: "you@example.com"; font-size: Theme.text-sm; color: Theme.text-tertiary; x: Theme.sp-3; y: (parent.height - self.height) / 2; }
            }
        }

        Rectangle { height: 40px; border-radius: Theme.radius-md; background: send-ta.has-hover ? Theme.accent-dim : Theme.accent;
            Text { text: "Send Reset Link"; font-size: Theme.text-sm; font-weight: Theme.weight-semibold; color: #ffffff; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            send-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.reset-requested(email-input.text); }
            }
        }

        HorizontalLayout { alignment: center;
            back-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.back-to-sign-in-clicked(); }
                Text { text: "Back to sign in"; font-size: Theme.text-sm; color: Theme.accent; }
            }
        }
    }
}
