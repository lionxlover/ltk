import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component SearchFilterForm inherits Rectangle {
    background: Theme.bg-surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-default;
    padding: Theme.sp-4;

    callback searched(string);
    callback type-filter-clicked();
    callback date-filter-clicked();
    callback sort-filter-clicked();

    VerticalLayout {
        spacing: Theme.sp-4;

        HorizontalLayout {
            spacing: Theme.sp-3;

            Rectangle {
                height: 36px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: search-input.has-focus ? Theme.border-focus : Theme.border-default;
                horizontal-stretch: 1;
                clip: true;

                HorizontalLayout {
                    padding-left: Theme.sp-3;
                    padding-right: Theme.sp-3;
                    spacing: Theme.sp-2;

                    FaIcon { source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/magnifying-glass.svg"); fa-size: 12px; fa-color: Theme.text-tertiary; y: (parent.height - self.height) / 2; }

                    Rectangle {
                        horizontal-stretch: 1;
                        search-input := TextInput {
                            text: "";
                            font-size: Theme.text-sm;
                            color: Theme.text-primary;
                            y: (parent.height - self.height) / 2;
                            single-line: true;
                            accepted => { root.searched(self.text); }
                        }
                        if search-input.text == "": Text { text: "Search..."; font-size: Theme.text-sm; color: Theme.text-tertiary; y: (parent.height - self.height) / 2; }
                    }
                }
            }

            Rectangle {
                width: 80px;
                height: 36px;
                border-radius: Theme.radius-md;
                background: search-ta.has-hover ? Theme.accent-dim : Theme.accent;

                Text {
                    text: "Search";
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-medium;
                    color: #ffffff;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                search-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.searched(search-input.text); }
                }
            }
        }

        HorizontalLayout {
            spacing: Theme.sp-3;

            Rectangle {
                height: 32px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                horizontal-stretch: 1;
                background: type-ta.has-hover ? Theme.hover-overlay : transparent;
                clip: true;

                HorizontalLayout {
                    padding-left: Theme.sp-3;
                    padding-right: Theme.sp-2;
                    spacing: Theme.sp-1;
                    Text { text: "All Types"; font-size: Theme.text-sm; color: Theme.text-secondary; y: (parent.height - self.height) / 2; horizontal-stretch: 1; }
                    FaIcon { source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/chevron-down.svg"); fa-size: 9px; fa-color: Theme.text-tertiary; y: (parent.height - self.height) / 2; }
                }
                type-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.type-filter-clicked(); } }
            }

            Rectangle {
                height: 32px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                horizontal-stretch: 1;
                background: date-ta.has-hover ? Theme.hover-overlay : transparent;
                clip: true;

                HorizontalLayout {
                    padding-left: Theme.sp-3;
                    padding-right: Theme.sp-2;
                    spacing: Theme.sp-1;
                    Text { text: "Any Date"; font-size: Theme.text-sm; color: Theme.text-secondary; y: (parent.height - self.height) / 2; horizontal-stretch: 1; }
                    FaIcon { source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/chevron-down.svg"); fa-size: 9px; fa-color: Theme.text-tertiary; y: (parent.height - self.height) / 2; }
                }
                date-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.date-filter-clicked(); } }
            }

            Rectangle {
                height: 32px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;
                horizontal-stretch: 1;
                background: sort-ta.has-hover ? Theme.hover-overlay : transparent;
                clip: true;

                HorizontalLayout {
                    padding-left: Theme.sp-3;
                    padding-right: Theme.sp-2;
                    spacing: Theme.sp-1;
                    Text { text: "Sort: Relevance"; font-size: Theme.text-sm; color: Theme.text-secondary; y: (parent.height - self.height) / 2; horizontal-stretch: 1; }
                    FaIcon { source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/chevron-down.svg"); fa-size: 9px; fa-color: Theme.text-tertiary; y: (parent.height - self.height) / 2; }
                }
                sort-ta := TouchArea { mouse-cursor: MouseCursor.pointer; clicked => { root.sort-filter-clicked(); } }
            }
        }
    }
}
