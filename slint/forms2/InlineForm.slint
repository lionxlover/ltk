import { Theme } from "../core/Theme.slint";

export component InlineForm inherits Rectangle {
    background: transparent;

    in property <length> gap: 8px;
    in property <bool> compact: true;
    callback searched(string);

    HorizontalLayout {
        spacing: gap;
        alignment: start;

        Rectangle {
            height: 32px;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: search-input.has-focus ? Theme.border-focus : Theme.border-default;
            horizontal-stretch: 1;
            clip: true;

            search-input := TextInput {
                text: "";
                font-size: Theme.text-sm;
                color: Theme.text-primary;
                x: Theme.sp-3;
                width: parent.width - Theme.sp-3 * 2;
                y: (parent.height - self.height) / 2;
                single-line: true;
                accepted => { root.searched(self.text); }
            }

            if search-input.text == "": Text {
                text: "Search...";
                font-size: Theme.text-sm;
                color: Theme.text-tertiary;
                x: Theme.sp-3;
                y: (parent.height - self.height) / 2;
            }
        }

        Rectangle {
            width: 64px;
            height: 32px;
            border-radius: Theme.radius-md;
            background: go-ta.has-hover ? Theme.accent-dim : Theme.accent;

            Text {
                text: "Go";
                font-size: Theme.text-sm;
                font-weight: Theme.weight-medium;
                color: #ffffff;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            go-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.searched(search-input.text); }
            }
        }
    }
}
