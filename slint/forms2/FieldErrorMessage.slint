import { Theme } from "../core/Theme.slint";

export component FieldErrorMessage inherits Rectangle {
    background: transparent;

    in property <string> text: "";

    height: text != "" ? 16px : 0px;

    if text != "": Text {
        text: root.text;
        font-size: Theme.text-xs;
        color: Theme.error;
        overflow: elide;
    }
}
