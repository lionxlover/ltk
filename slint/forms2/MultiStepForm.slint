import { Theme } from "../core/Theme.slint";

export component MultiStepForm inherits Rectangle {
    background: transparent;

    in property <int> total-steps: 3;
    in property <bool> show-next: true;
    in property <bool> show-back: true;
    in-out property <int> current-step: 0;
    in property <[string]> step-titles: ["Step 1", "Step 2", "Step 3"];

    VerticalLayout {
        spacing: Theme.sp-4;

        HorizontalLayout {
            spacing: Theme.sp-2;
            height: 4px;

            for step_idx[idx] in total-steps: Rectangle {
                horizontal-stretch: 1;
                height: 4px;
                border-radius: 2px;
                background: idx <= current-step ? Theme.accent : Theme.border-default;
            }
        }

        if step-titles.length > 0: HorizontalLayout {
            spacing: Theme.sp-4;
            height: 20px;

            for label[idx] in step-titles: Text {
                text: label;
                font-size: Theme.text-xs;
                color: idx == current-step ? Theme.accent : Theme.text-tertiary;
                font-weight: idx == current-step ? Theme.weight-semibold : Theme.weight-regular;
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        HorizontalLayout {
            spacing: Theme.sp-3;
            height: 40px;
            alignment: end;

            if show-back && current-step > 0: Rectangle {
                width: 80px;
                height: 36px;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-default;

                Text {
                    text: "Back";
                    font-size: Theme.text-sm;
                    color: Theme.text-primary;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                TouchArea {
                    clicked => { if current-step > 0 { current-step -= 1; } }
                }
            }

            if show-next: Rectangle {
                width: 100px;
                height: 36px;
                border-radius: Theme.radius-md;
                background: Theme.accent;

                Text {
                    text: current-step == total-steps - 1 ? "Finish" : "Next";
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-medium;
                    color: #ffffff;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }

                TouchArea {
                    clicked => { if current-step < total-steps - 1 { current-step += 1; } }
                }
            }
        }
    }
}
