import { Theme } from "../core/Theme.slint";

export component ClipboardManager inherits Rectangle {
    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-default;
    clip: true;

    in property <string> clipboard-text: "";
    in property <bool> copied: false;

    callback copy-requested();

    height: 40px;

    HorizontalLayout {
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-3;
        spacing: Theme.sp-2;

        Text {
            text: clipboard-text != "" ? clipboard-text : "No content";
            font-size: Theme.text-sm;
            font-family: Theme.font-mono;
            color: Theme.text-secondary;
            y: (parent.height - self.height) / 2;
            vertical-stretch: 1;
            overflow: elide;
        }

        Rectangle {
            width: 60px;
            border-radius: Theme.radius-sm;
            background: copy-area.has-hover ? Theme.accent-dim : (copied ? Theme.success : Theme.accent);

            Text {
                text: copied ? "Copied!" : "Copy";
                font-size: Theme.text-xs;
                font-weight: Theme.weight-semibold;
                color: #ffffff;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            copy-area := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.copy-requested(); }
            }
        }
    }
}
