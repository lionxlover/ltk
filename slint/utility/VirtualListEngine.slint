import { Theme } from "../core/Theme.slint";

export component VirtualListEngine inherits Rectangle {
    background: transparent;

    in property <int> total-items: 0;
    in property <int> visible-start: 0;
    in property <int> visible-count: 10;
    in property <length> item-height: 40px;
    in property <length> scroll-offset: 0px;

    out property <length> total-height: total-items * item-height;
    out property <int> visible-end: Math.min(visible-start + visible-count, total-items);

    function clamp-start(val: int, count: int, total: int) -> int {
        return Math.max(0, Math.min(val, total - count));
    }
}
