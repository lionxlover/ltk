import { Theme } from "../core/Theme.slint";

export component ActionSheetDestructive inherits Rectangle {
    background: Theme.bg-scrim;
    clip: true;

    in property <string> title: "Are you sure?";
    in property <[string]> actions: ["Delete", "Move to Trash"];
    in property <int> destructive-index: 0;
    callback action-selected(int);
    callback cancelled();

    VerticalLayout {
        alignment: end;

        Rectangle {
            background: Theme.bg-elevated;
            border-radius: Theme.radius-xl;
            border-bottom-left-radius: 0;
            border-bottom-right-radius: 0;

            VerticalLayout {
                padding: Theme.sp-2;

                if title != "": Rectangle {
                    height: 40px;
                    border-radius: Theme.radius-md;

                    Text {
                        text: title;
                        font-size: Theme.text-sm;
                        font-weight: Theme.weight-semibold;
                        color: Theme.text-tertiary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                for action[idx] in actions: Rectangle {
                    height: 50px;
                    border-radius: Theme.radius-md;
                    background: row-ta.has-hover ? Theme.hover-overlay : transparent;

                    Text {
                        text: action;
                        font-size: Theme.text-base;
                        font-weight: idx == destructive-index ? Theme.weight-semibold : Theme.weight-regular;
                        color: idx == destructive-index ? Theme.error : Theme.text-primary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    row-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.action-selected(idx); }
                    }
                }

                Rectangle { height: 8px; }

                Rectangle {
                    height: 50px;
                    border-radius: Theme.radius-md;
                    background: cancel-ta.has-hover ? Theme.hover-overlay : Theme.bg-surface;

                    Text {
                        text: "Cancel";
                        font-size: Theme.text-base;
                        font-weight: Theme.weight-semibold;
                        color: Theme.accent;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    cancel-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.cancelled(); }
                    }
                }
            }
        }
    }
}
