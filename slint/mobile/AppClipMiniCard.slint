import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component AppClipMiniCard inherits Rectangle {
    background: Theme.bg-elevated;
    border-radius: Theme.radius-xl;
    border-width: 1px;
    border-color: Theme.border-default;
    clip: true;

    in property <image> icon-source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/link.svg");
    in property <string> title: "App Clip";
    in property <string> subtitle: "Open in app";
    callback opened();

    width: 260px;
    height: 80px;

    HorizontalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-3;

        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: Theme.radius-md;
            background: Theme.bg-overlay;
            y: 4px;

            FaIcon {
                source: root.icon-source;
                fa-size: 20px;
                fa-color: Theme.text-secondary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            spacing: 2px;
            y: 12px;

            Text {
                text: title;
                font-size: Theme.text-base;
                font-weight: Theme.weight-semibold;
                color: Theme.text-primary;
            }

            Text {
                text: subtitle;
                font-size: Theme.text-xs;
                color: Theme.text-tertiary;
            }
        }

        Rectangle {
            width: 60px;
            height: 32px;
            border-radius: self.height / 2;
            background: open-ta.has-hover ? Theme.accent-dim : Theme.accent;
            y: 24px;

            Text {
                text: "Open";
                font-size: Theme.text-xs;
                font-weight: Theme.weight-semibold;
                color: #ffffff;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            open-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.opened(); }
            }
        }
    }
}
