import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component StatusBarOverlay inherits Rectangle {
    background: transparent;
    in property <length> bar-height: 44px;
    height: bar-height;

    HorizontalLayout {
        padding-left: Theme.sp-4;
        padding-right: Theme.sp-4;

        Text {
            text: "9:41";
            font-size: Theme.text-sm;
            font-weight: Theme.weight-semibold;
            color: Theme.text-primary;
            vertical-alignment: center;
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            spacing: Theme.sp-1;

            FaIcon { source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/signal.svg"); fa-size: 12px; fa-color: Theme.text-primary; y: (parent.height - self.height) / 2; }
            FaIcon { source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/battery-full.svg"); fa-size: 14px; fa-color: Theme.text-primary; y: (parent.height - self.height) / 2; }
        }
    }
}
