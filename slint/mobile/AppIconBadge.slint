import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component AppIconBadge inherits Rectangle {
    background: transparent;

    in property <image> icon-source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/mobile.svg");
    in property <int> badge-count: 0;
    in property <length> icon-size: 60px;

    width: icon-size + 16px;
    height: icon-size + 16px;

    Rectangle {
        width: icon-size;
        height: icon-size;
        border-radius: icon-size * 0.22;
        background: Theme.bg-overlay;
        x: 8px;
        y: 8px;

        FaIcon {
            source: root.icon-source;
            fa-size: icon-size * 0.5;
            fa-color: Theme.text-primary;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    if badge-count > 0: Rectangle {
        x: parent.width - 20px;
        y: 2px;
        height: 20px;
        border-radius: 10px;
        background: Theme.error;

        Text {
            text: root.badge-count > 99 ? "99+" : "\{root.badge-count}";
            font-size: Theme.text-xs;
            font-weight: Theme.weight-bold;
            color: #ffffff;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}
