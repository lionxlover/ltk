import { Theme } from "../core/Theme.slint";

export component DynamicIslandSlot inherits Rectangle {
    // Was Theme.text-primary — that token is near-white in dark mode
    // (it's meant for text readable on a dark background), so this
    // rendered as a blank white pill instead of the Dynamic Island's
    // signature black. The island itself is a physical hardware cutout,
    // not app-themed, so it stays fixed-dark regardless of light/dark mode.
    background: #0a0a0c;
    border-radius: self.height / 2;

    in property <bool> expanded: false;
    in property <string> content: "";

    width: expanded ? 280px : 120px;
    height: expanded ? 80px : 36px;
    animate width, height { duration: 300ms; easing: Theme.ease-spring; }

    if expanded && content != "": Text {
        text: content;
        font-size: Theme.text-sm;
        color: #ffffff;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}
