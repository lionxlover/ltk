import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component PullToRefresh inherits Rectangle {
    background: transparent;

    in property <bool> refreshing: false;
    in property <int> pull-distance: 60;
    in property <string> label: "Pull to refresh";

    height: 60px;

    // Nudge-and-repeat spin, same confirmed technique as media/AnimatedIcon:
    // `spin-angle` is bumped once via init, giving `animate` an actual value
    // change to replay forever.
    private property <float> spin-angle: 0;
    animate spin-angle {
        duration: 900ms;
        easing: linear;
        iteration-count: -1;
    }
    init => { spin-angle = 360; }

    VerticalLayout {
        alignment: center;
        spacing: Theme.sp-2;

        if !refreshing: HorizontalLayout {
            alignment: center;
            spacing: Theme.sp-1;

            FaIcon {
                source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/chevron-down.svg");
                fa-size: 12px;
                fa-color: Theme.text-tertiary;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: label;
                font-size: Theme.text-sm;
                color: Theme.text-tertiary;
            }
        }

        if refreshing: FaIcon {
            source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/arrows-rotate.svg");
            fa-size: 20px;
            fa-color: Theme.accent;
            x: (parent.width - self.width) / 2;
            transform-rotation: root.spin-angle * 1deg;
        }
    }
}
