import { Theme } from "../core/Theme.slint";

export component FloatingIslandPill inherits Rectangle {
    background: #0a0a0c;
    border-radius: self.height / 2;


    in property <bool> expanded: false;
    in property <string> content: "";

    width: expanded ? 200px : 120px;
    height: expanded ? 56px : 36px;
    animate width, height { duration: 300ms; easing: Theme.ease-spring; }

    if expanded && content != "": Text {
        text: content;
        font-size: Theme.text-sm;
        color: #ffffff;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}
