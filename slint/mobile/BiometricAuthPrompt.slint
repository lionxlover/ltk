import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component BiometricAuthPrompt inherits Rectangle {
    background: Theme.bg-scrim;
    clip: true;

    in property <string> auth-type: "face-id";
    in property <string> title: "Authenticate";
    in property <string> subtitle: "Use Face ID to continue";
    callback cancelled();

    Rectangle {
        width: 300px;
        height: 240px;
        background: Theme.bg-elevated;
        border-radius: Theme.radius-xl;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        VerticalLayout {
            alignment: center;
            spacing: Theme.sp-4;

            FaIcon {
                source: auth-type == "face-id"
                    ? @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/face-smile.svg")
                    : @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/fingerprint.svg");
                fa-size: 44px;
                fa-color: Theme.accent;
                x: (parent.width - self.width) / 2;
            }

            Text {
                text: title;
                font-size: Theme.text-lg;
                font-weight: Theme.weight-semibold;
                color: Theme.text-primary;
                horizontal-alignment: center;
            }

            Text {
                text: subtitle;
                font-size: Theme.text-sm;
                color: Theme.text-tertiary;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 120px;
                    height: 36px;
                    border-radius: Theme.radius-full;
                    border-width: 1px;
                    border-color: Theme.border-default;
                    background: cancel-ta.has-hover ? Theme.hover-overlay : transparent;

                    Text {
                        text: "Cancel";
                        font-size: Theme.text-sm;
                        color: Theme.text-primary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    cancel-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.cancelled(); }
                    }
                }
            }
        }
    }
}
