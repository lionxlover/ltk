import { Theme } from "../core/Theme.slint";

export component PhotoMediaPicker inherits Rectangle {
    background: Theme.bg-elevated;
    border-radius: Theme.radius-xl;
    clip: true;

    in property <int> grid-columns: 4;
    in property <int> grid-rows: 4;
    in property <int> spacing: 2;
    callback cancelled();
    callback confirmed();
    callback photo-selected(int);

    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: 48px;

            HorizontalLayout {
                padding-left: Theme.sp-4;
                padding-right: Theme.sp-4;

                Text {
                    text: "Cancel";
                    font-size: Theme.text-base;
                    color: Theme.accent;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;

                    Text {
                        text: "Photo Library";
                        font-size: Theme.text-base;
                        font-weight: Theme.weight-semibold;
                        color: Theme.text-primary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Text {
                    text: "Done";
                    font-size: Theme.text-base;
                    font-weight: Theme.weight-semibold;
                    color: Theme.accent;
                    vertical-alignment: center;
                }
            }

            cancel-ta := TouchArea {
                x: 0px;
                width: 80px;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.cancelled(); }
            }

            done-ta := TouchArea {
                x: parent.width - 80px;
                width: 80px;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.confirmed(); }
            }
        }

        Rectangle { height: 1px; background: Theme.border-default; }

        // grid-columns/grid-rows/spacing were declared but never actually
        // used anywhere — the body was just one blank placeholder
        // Rectangle regardless of what was passed in. Rebuilt on a real
        // GridLayout that actually reads all three.
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-base;
            clip: true;

            GridLayout {
                padding: root.spacing * 1px;
                spacing: root.spacing * 1px;

                for cell[i] in root.grid-columns * root.grid-rows: Rectangle {
                    row: Math.floor(i / root.grid-columns);
                    col: Math.mod(i, root.grid-columns);
                    background: cell-ta.has-hover ? Theme.hover-overlay : Theme.bg-overlay;

                    cell-ta := TouchArea {
                        clicked => { root.photo-selected(i); }
                    }
                }
            }
        }
    }
}
