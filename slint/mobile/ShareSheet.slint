import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

export component ShareSheet inherits Rectangle {
    background: Theme.bg-scrim;
    clip: true;

    in property <[string]> apps: ["AirDrop", "Messages", "Mail", "Notes", "Reminders"];
    in property <[image]> app-icon-sources: [
        @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/satellite-dish.svg"),
        @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/message.svg"),
        @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/envelope.svg"),
        @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/note-sticky.svg"),
        @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/clock.svg")
    ];
    in property <[string]> actions: ["Copy Link", "Save to Files", "More Actions..."];
    callback app-selected(int);
    callback action-selected(int);
    callback cancelled();

    VerticalLayout {
        alignment: end;

        Rectangle {
            background: Theme.bg-elevated;
            border-radius: Theme.radius-xl;
            border-bottom-left-radius: 0;
            border-bottom-right-radius: 0;

            VerticalLayout {
                padding: Theme.sp-4;
                spacing: Theme.sp-2;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.text-tertiary;
                    }
                }

                HorizontalLayout {
                    height: 80px;
                    spacing: Theme.sp-4;
                    padding-left: Theme.sp-3;

                    for app[idx] in apps: VerticalLayout {
                        spacing: Theme.sp-1;
                        width: 64px;
                        alignment: center;

                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 48px;
                                height: 48px;
                                border-radius: Theme.radius-md;
                                background: app-ta.has-hover ? Theme.hover-overlay : Theme.bg-overlay;

                                FaIcon {
                                    source: idx < root.app-icon-sources.length ? root.app-icon-sources[idx] : @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/box.svg");
                                    fa-size: 20px;
                                    fa-color: Theme.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                app-ta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.app-selected(idx); }
                                }
                            }
                        }

                        Text {
                            text: app;
                            font-size: Theme.text-xs;
                            color: Theme.text-secondary;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-default; }

                for action[a] in actions: Rectangle {
                    height: 48px;
                    background: action-ta.has-hover ? Theme.hover-overlay : transparent;

                    HorizontalLayout {
                        padding-left: Theme.sp-4;
                        Text {
                            text: action;
                            font-size: Theme.text-base;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }

                    action-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.action-selected(a); }
                    }

                    Rectangle { height: 1px; x: Theme.sp-4; background: Theme.border-subtle; }
                }

                Rectangle { height: 8px; }

                Rectangle {
                    height: 50px;
                    border-radius: Theme.radius-md;
                    background: cancel-ta.has-hover ? Theme.hover-overlay : Theme.bg-surface;

                    Text {
                        text: "Cancel";
                        font-size: Theme.text-base;
                        font-weight: Theme.weight-semibold;
                        color: Theme.accent;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    cancel-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.cancelled(); }
                    }
                }
            }
        }
    }
}
