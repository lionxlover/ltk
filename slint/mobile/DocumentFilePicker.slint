import { Theme } from "../core/Theme.slint";

export component DocumentFilePicker inherits Rectangle {
    background: Theme.bg-elevated;
    border-radius: Theme.radius-xl;
    border-width: 1px;
    border-color: Theme.border-default;
    clip: true;

    in property <[string]> file-types: ["Documents", "Images", "Videos", "Audio"];
    callback type-selected(int);

    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: 48px;

            // `padding-left` on a bare Text outside a layout has no effect
            // (padding only works on layout elements) — wrapped in a
            // HorizontalLayout so the inset is actually applied.
            HorizontalLayout {
                padding-left: Theme.sp-4;

                Text {
                    text: "Select File";
                    font-size: Theme.text-base;
                    font-weight: Theme.weight-semibold;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.border-default; }

        for type[idx] in file-types: Rectangle {
            height: 48px;
            background: row-ta.has-hover ? Theme.hover-overlay : transparent;

            HorizontalLayout {
                padding-left: Theme.sp-4;
                padding-right: Theme.sp-4;

                Text {
                    text: type;
                    font-size: Theme.text-base;
                    color: Theme.text-primary;
                    y: (parent.height - self.height) / 2;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "›";
                    font-size: Theme.text-lg;
                    color: Theme.text-tertiary;
                    y: (parent.height - self.height) / 2;
                }
            }

            row-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.type-selected(idx); }
            }

            Rectangle { height: 1px; x: Theme.sp-4; background: Theme.border-subtle; }
        }
    }
}
