import { Theme } from "../core/Theme.slint";

export component SwipeToArchive inherits Rectangle {
    background: Theme.bg-surface;
    clip: true;
    height: 64px;

    in property <string> label: "Swipe to archive";
    callback archived();

    private property <length> drag-offset: 0px;
    private property <length> press-start-mouse-x: 0px;
    private property <length> press-start-offset: 0px;

    Rectangle {
        background: Theme.accent;
        x: parent.width - 80px;
        width: 80px;
        height: parent.height;

        Text {
            text: "Archive";
            font-size: Theme.text-sm;
            font-weight: Theme.weight-medium;
            color: #ffffff;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    front := Rectangle {
        x: root.drag-offset;
        background: Theme.bg-surface;
        height: parent.height;

        HorizontalLayout {
            padding-left: Theme.sp-4;
            padding-right: Theme.sp-4;

            Text {
                text: label;
                font-size: Theme.text-base;
                color: Theme.text-primary;
                y: (parent.height - self.height) / 2;
                vertical-stretch: 1;
            }
        }
    }

    drag-ta := TouchArea {
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.press-start-mouse-x = self.mouse-x;
                root.press-start-offset = root.drag-offset;
            }
            if (ev.kind == PointerEventKind.up) {
                if (root.drag-offset < -40px) {
                    root.archived();
                }
                root.drag-offset = 0px;
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-offset = (root.press-start-offset + (self.mouse-x - root.press-start-mouse-x)).clamp(-80px, 0px);
            }
        }
    }
}
