import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

// ═════════════════════════════════════════════════════════════════════════
// FabMini
// ═════════════════════════════════════════════════════════════════════════
//
// A smaller Fab used for secondary actions clustered around a main Fab —
// the classic "speed dial" pattern (tap the main Fab, 2-4 FabMinis fan out
// above it for related actions like attach/photo/edit).
//
// Usage:
//   FabMini {
//       icon: @image-url("camera.svg");
//       label: "Take photo";
//       clicked => { root.take-photo(); }
//   }
//
// Fixed in this revision:
//  - `icon` was a `string` matched against a hardcoded ladder of exactly
//    four names ("pen", "paperclip", "camera", else plus) — passing
//    anything else (including a typo of one of those four) silently fell
//    back to the plus icon with no warning. Replaced with a proper
//    `image` property, matching every other icon-accepting button in
//    this library, so any FontAwesome asset works and a typo in a call
//    site is caught as a normal "file not found" instead of silently
//    swapped for the wrong icon.
//  - Raw `Image` + hardcoded `#ffffff` replaced with `FaIcon` +
//    `Theme.text-on-accent`.
//  - No accessible label — added `label` + `accessible-role`.
//  - Added: loading state, keyboard activation, focus ring, pointer
//    cursor.
export component FabMini inherits Rectangle {
    in property <image> icon: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/plus.svg");
    in property <string> label: "";

    in-out property <bool> enabled: true;
    in property <bool> loading: false;
    out property <bool> is-interactive: enabled && !loading;
    out property <bool> has-focus: fs.has-focus;

    callback clicked();

    property <length> fab-radius: 12px;

    width: 40px;
    height: 40px;
    // Fixed size by design — see Fab.slint's identical note.
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: fab-radius;

    background: !is-interactive
        ? Theme.btn-disabled-bg
        : ta.pressed ? Theme.btn-primary-bg-pressed
        : ta.has-hover ? Theme.btn-primary-bg-hover
        : Theme.accent;

    opacity: loading ? Theme.opacity-hover : 1.0;

    drop-shadow-color: is-interactive ? Theme.shadow-sm : transparent;
    drop-shadow-blur: is-interactive ? (ta.has-hover ? Theme.elevation-2-blur : Theme.elevation-1-blur) : 0px;
    drop-shadow-offset-y: is-interactive ? (ta.has-hover ? Theme.elevation-2-y : Theme.elevation-1-y) : 0px;

    animate background { duration: Theme.dur-fast; easing: Theme.ease-standard; }
    animate opacity { duration: Theme.dur-fast; easing: Theme.ease-standard; }
    animate drop-shadow-blur { duration: Theme.dur-normal; easing: Theme.ease-soft; }

    accessible-role: AccessibleRole.button;
    accessible-label: root.label;

    if !loading: FaIcon {
        source: root.icon;
        fa-size: Theme.icon-md;
        fa-color: Theme.text-on-accent;
        fa-disabled: !is-interactive;
    }

    if loading: Rectangle {
        width: Theme.icon-md;
        height: Theme.icon-md;
        border-radius: Theme.radius-full;
        border-width: Theme.border-width-medium;
        border-color: Theme.text-on-accent;
        background: transparent;
    }

    ta := TouchArea {
        enabled: root.is-interactive;
        mouse-cursor: root.is-interactive ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    fs := FocusScope {
        enabled: root.is-interactive;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                accept
            } else {
                reject
            }
        }
    }

    if fs.has-focus: Rectangle {
        x: -Theme.focus-ring-offset;
        y: -Theme.focus-ring-offset;
        width: parent.width + 2 * Theme.focus-ring-offset;
        height: parent.height + 2 * Theme.focus-ring-offset;
        border-radius: parent.fab-radius + Theme.focus-ring-offset;
        border-width: Theme.focus-ring-width;
        border-color: Theme.focus-ring;
        background: transparent;
    }
}
