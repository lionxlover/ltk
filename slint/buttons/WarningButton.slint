import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";
import { ProgressSpinner } from "../progress/ProgressSpinner.slint";

// ═════════════════════════════════════════════════════════════════════════
// WarningButton
// ═════════════════════════════════════════════════════════════════════════
//
// A solid, warning-colored (amber) button for actions that need caution
// but aren't fully destructive (e.g. "Proceed anyway", "Override").
//
// Usage:
//   WarningButton { text: "Proceed anyway"; clicked => { root.proceed(); } }
//
// Fixed in this revision (same defects as every sibling in buttons/, see
// PrimaryButton.slint for the full write-up):
//  - Removed the manual `y:` icon-alignment override.
//  - Replaced `height: 40px` with Theme.button-height-*.
//  - The original hardcoded `#000000` text/icon color is actually the
//    *correct* choice on an amber background (white text fails WCAG
//    contrast here) — but it was a raw literal with no semantic meaning
//    and no easy way to retune it consistently. Replaced with the new
//    `Theme.text-on-warning` token, which resolves to a near-black
//    (#1a1400) rather than pure black for a very slightly warmer, less
//    harsh pairing with the amber fill.
//  - Added size variants, optional icon, loading state, keyboard
//    activation, focus ring, accessible role/label, pointer cursor, and a
//    min-width floor.
export component WarningButton inherits Rectangle {
    in-out property <string> text: "Warning";
    in property <bool> show-icon: true;
    in property <image> icon: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/triangle-exclamation.svg");
    in property <string> size: "md"; // "xs" | "sm" | "md" | "lg"

    in-out property <bool> enabled: true;
    in property <bool> loading: false;
    out property <bool> is-interactive: enabled && !loading;
    out property <bool> has-focus: fs.has-focus;

    callback clicked();

    pure function height-for(s: string) -> length {
        s == "xs" ? Theme.button-height-xs :
        s == "sm" ? Theme.button-height-sm :
        s == "lg" ? Theme.button-height-lg :
        Theme.button-height-md
    }
    pure function icon-size-for(s: string) -> length {
        s == "xs" ? Theme.icon-sm : s == "sm" ? Theme.icon-sm : s == "lg" ? Theme.icon-lg : Theme.icon-md
    }
    pure function font-size-for(s: string) -> length {
        s == "xs" ? Theme.text-xs : s == "sm" ? Theme.text-sm : s == "lg" ? Theme.text-lg : Theme.text-base
    }
    pure function padding-x-for(s: string) -> length {
        s == "xs" ? Theme.sp-2 : s == "sm" ? Theme.sp-3 : s == "lg" ? Theme.sp-5 : Theme.button-padding-x
    }

    height: height-for(size);
    // NOTE: an earlier revision also set min-height/max-height here
    // to the same expression as height, meaning to guard against a
    // cramped parent compressing this button shorter than its size
    // variant intends. That's not how Slint works: `height` is itself
    // an alias that sets min-height AND max-height internally
    // (confirmed against slint-ui/slint discussion #6287), so binding
    // them again on top of it is two bindings for the same underlying
    // constraint — a real "Cannot specify both 'height' and
    // 'min-height'" compile error, not redundancy. `height` alone
    // already fully locks the value against being shrunk.
    min-width: Theme.button-min-width;
    max-width: Theme.button-max-width;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: Theme.radius-md;

    background: !is-interactive
        ? Theme.btn-disabled-bg
        : ta.pressed ? Theme.warning.with-alpha(0.8)
        : ta.has-hover ? Theme.warning.with-alpha(0.9)
        : Theme.warning;

    opacity: loading ? Theme.opacity-hover : 1.0;

    drop-shadow-color: is-interactive && ta.has-hover ? Theme.warning.with-alpha(0.35) : transparent;
    drop-shadow-blur: is-interactive && ta.has-hover ? Theme.elevation-2-blur : 0px;
    drop-shadow-offset-y: is-interactive && ta.has-hover ? Theme.elevation-1-y : 0px;

    animate background { duration: Theme.dur-fast; easing: Theme.ease-standard; }
    animate opacity { duration: Theme.dur-fast; easing: Theme.ease-standard; }
    animate drop-shadow-blur { duration: Theme.dur-normal; easing: Theme.ease-soft; }
    animate drop-shadow-color { duration: Theme.dur-normal; easing: Theme.ease-soft; }

    accessible-role: AccessibleRole.button;
    accessible-label: root.text;

    HorizontalLayout {
        alignment: center;
        spacing: Theme.sp-2;
        padding-left: padding-x-for(root.size);
        padding-right: padding-x-for(root.size);

        if show-icon && !loading: FaIcon {
            source: root.icon;
            fa-size: icon-size-for(root.size);
            fa-color: is-interactive ? Theme.text-on-warning : Theme.btn-disabled-text;
            // See PrimaryButton.slint's header: HorizontalLayout does
            // not auto-center an Image-derived child, only Text.
            y: (parent.height - self.height) / 2;
        }

        if loading: ProgressSpinner {
            spinner-size: icon-size-for(root.size);
            stroke-width: 2px;
            spinner-color: Theme.text-on-warning;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: is-interactive ? Theme.text-on-warning : Theme.btn-disabled-text;
            font-size: font-size-for(root.size);
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        enabled: root.is-interactive;
        mouse-cursor: root.is-interactive ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    fs := FocusScope {
        enabled: root.is-interactive;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                accept
            } else {
                reject
            }
        }
    }

    if fs.has-focus: Rectangle {
        x: -Theme.focus-ring-offset;
        y: -Theme.focus-ring-offset;
        width: parent.width + 2 * Theme.focus-ring-offset;
        height: parent.height + 2 * Theme.focus-ring-offset;
        border-radius: parent.border-radius + Theme.focus-ring-offset;
        border-width: Theme.focus-ring-width;
        border-color: Theme.warning;
        background: transparent;
    }
}
