import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

// ═════════════════════════════════════════════════════════════════════════
// ScrollAnchorButton
// ═════════════════════════════════════════════════════════════════════════
//
// A table-of-contents style link that jumps the view to a named section
// — a sidebar outline, a "jump to" list above a long document.
//
// Usage:
//   ScrollAnchorButton { text: "Section 1"; clicked => { root.scroll-to("section-1"); } }
//
// Fixed in this revision:
//  - STRUCTURAL BUG: no callback was declared, and the TouchArea's
//    handler was empty (`clicked => { }`) — this control could never
//    actually scroll anything; it only ever looked like a link.
//  - No `enabled` state, no hover feedback at all.
//  - No accessible role/label, keyboard activation, or focus ring.
//  - No `mouse-cursor: pointer`.
//  - Bare `8px`/`10px`/`13px` literals replaced with Theme's spacing/
//    icon/text tokens.
export component ScrollAnchorButton inherits Rectangle {
    in-out property <string> text: "Section 1";
    in-out property <bool> enabled: true;
    out property <bool> has-focus: fs.has-focus;

    callback clicked();

    background: !enabled
        ? transparent
        : ta.pressed ? Theme.surface-pressed
        : ta.has-hover ? Theme.surface-hover
        : transparent;
    border-radius: Theme.radius-sm;
    height: 32px;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    animate background { duration: Theme.dur-fast; easing: Theme.ease-standard; }

    accessible-role: AccessibleRole.button;
    accessible-label: "Jump to " + root.text;
    accessible-enabled: root.enabled;

    HorizontalLayout {
        padding-left: Theme.sp-2;
        padding-right: Theme.sp-2;
        spacing: Theme.sp-2;

        FaIcon {
            source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/chevron-right.svg");
            fa-size: 10px;
            fa-color: enabled ? Theme.text-link : Theme.btn-disabled-text;
            fa-disabled: !enabled;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: enabled ? Theme.text-link : Theme.btn-disabled-text;
            font-size: Theme.text-sm;
            font-weight: Theme.weight-medium;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                accept
            } else {
                reject
            }
        }
    }

    if fs.has-focus: Rectangle {
        x: -Theme.focus-ring-offset;
        y: -Theme.focus-ring-offset;
        width: parent.width + 2 * Theme.focus-ring-offset;
        height: parent.height + 2 * Theme.focus-ring-offset;
        border-radius: parent.border-radius + Theme.focus-ring-offset;
        border-width: Theme.focus-ring-width;
        border-color: Theme.focus-ring;
        background: transparent;
    }
}
