import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";
import { ProgressSpinner } from "../progress/ProgressSpinner.slint";

// ═════════════════════════════════════════════════════════════════════════
// SubmitButton
// ═════════════════════════════════════════════════════════════════════════
//
// A form's primary submit action, with a built-in loading state for the
// round-trip a real submit almost always involves.
//
// Usage:
//   SubmitButton { text: "Create Account"; loading: signup-in-flight; clicked => { root.submit(); } }
//
// Fixed in this revision:
//  - The loading indicator was a static (non-rotating) `spinner.svg`
//    image — see ProgressSpinner.slint's header for the connected fix:
//    that shared component didn't animate at all until this revision.
//    Switched from the static image to ProgressSpinner, which now
//    genuinely spins.
//  - Hardcoded `#ffffff` replaced with `Theme.text-on-accent`.
//  - No accessible role/label, keyboard activation, or focus ring.
//  - No `mouse-cursor: pointer`.
//  - No min/max width/height lock.
//  - Bare `8px`/`14px` literals replaced with Theme's spacing/icon
//    tokens.
export component SubmitButton inherits Rectangle {
    in-out property <string> text: "Submit";
    in-out property <bool> loading: false;
    in-out property <bool> enabled: true;
    out property <bool> is-interactive: enabled && !loading;
    out property <bool> has-focus: fs.has-focus;

    callback clicked();

    height: Theme.button-height-md;
    min-height: Theme.button-height-md;
    max-height: Theme.button-height-md;
    min-width: Theme.button-min-width;
    max-width: Theme.button-max-width;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: Theme.radius-md;

    background: !enabled
        ? Theme.btn-disabled-bg
        : ta.pressed ? Theme.btn-primary-bg-pressed
        : ta.has-hover ? Theme.btn-primary-bg-hover
        : Theme.accent;

    opacity: loading ? Theme.opacity-hover : 1.0;

    animate background { duration: Theme.dur-fast; easing: Theme.ease-standard; }
    animate opacity { duration: Theme.dur-fast; easing: Theme.ease-standard; }

    accessible-role: AccessibleRole.button;
    accessible-label: root.loading ? "Submitting " + root.text : root.text;
    accessible-enabled: root.is-interactive;

    HorizontalLayout {
        alignment: center;
        spacing: Theme.sp-2;
        padding-left: Theme.button-padding-x;
        padding-right: Theme.button-padding-x;

        if !loading: FaIcon {
            source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/paper-plane.svg");
            fa-size: Theme.icon-sm;
            fa-color: enabled ? Theme.text-on-accent : Theme.btn-disabled-text;
            fa-disabled: !enabled;
            y: (parent.height - self.height) / 2;
        }

        if loading: ProgressSpinner {
            spinner-size: Theme.icon-sm;
            stroke-width: 2px;
            spinner-color: Theme.text-on-accent;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: enabled ? Theme.text-on-accent : Theme.btn-disabled-text;
            font-size: Theme.text-base;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        enabled: root.is-interactive;
        mouse-cursor: root.is-interactive ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    fs := FocusScope {
        enabled: root.is-interactive;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                accept
            } else {
                reject
            }
        }
    }

    if fs.has-focus: Rectangle {
        x: -Theme.focus-ring-offset;
        y: -Theme.focus-ring-offset;
        width: parent.width + 2 * Theme.focus-ring-offset;
        height: parent.height + 2 * Theme.focus-ring-offset;
        border-radius: parent.border-radius + Theme.focus-ring-offset;
        border-width: Theme.focus-ring-width;
        border-color: Theme.focus-ring;
        background: transparent;
    }
}
