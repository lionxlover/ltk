import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";
import { ProgressSpinner } from "../progress/ProgressSpinner.slint";

// ═════════════════════════════════════════════════════════════════════════
// GhostButton
// ═════════════════════════════════════════════════════════════════════════
//
// The lowest-emphasis button in the family: no fill, no border, until
// hovered. Use for tertiary actions (e.g. "Learn more") that need to sit
// in a toolbar or dense row without competing visually with the primary
// and secondary actions next to them.
//
// Usage:
//   GhostButton { text: "Skip"; clicked => { root.skip(); } }
//
// Fixed in this revision (same defects as every sibling in buttons/, see
// PrimaryButton.slint for the full write-up):
//  - Removed the manual `y:` override on the icon that fought with the
//    HorizontalLayout's own vertical centering of the adjacent Text.
//  - Replaced the off-scale `height: 40px` with Theme.button-height-*.
//  - Added size variants, optional icon, loading state, keyboard
//    activation, focus ring, accessible role/label, pointer cursor, and a
//    min-width floor.
export component GhostButton inherits Rectangle {
    in-out property <string> text: "Ghost";
    in property <bool> show-icon: true;
    in property <image> icon: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/ghost.svg");
    in property <string> size: "md"; // "xs" | "sm" | "md" | "lg"

    in-out property <bool> enabled: true;
    in property <bool> loading: false;
    out property <bool> is-interactive: enabled && !loading;
    out property <bool> has-focus: fs.has-focus;

    callback clicked();

    pure function height-for(s: string) -> length {
        s == "xs" ? Theme.button-height-xs :
        s == "sm" ? Theme.button-height-sm :
        s == "lg" ? Theme.button-height-lg :
        Theme.button-height-md
    }
    pure function icon-size-for(s: string) -> length {
        s == "xs" ? Theme.icon-sm : s == "sm" ? Theme.icon-sm : s == "lg" ? Theme.icon-lg : Theme.icon-md
    }
    pure function font-size-for(s: string) -> length {
        s == "xs" ? Theme.text-xs : s == "sm" ? Theme.text-sm : s == "lg" ? Theme.text-lg : Theme.text-base
    }
    pure function padding-x-for(s: string) -> length {
        s == "xs" ? Theme.sp-2 : s == "sm" ? Theme.sp-3 : s == "lg" ? Theme.sp-5 : Theme.button-padding-x
    }

    height: height-for(size);
    min-width: Theme.button-min-width;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: Theme.radius-md;

    background: !is-interactive
        ? transparent
        : ta.pressed ? Theme.surface-pressed
        : ta.has-hover ? Theme.surface-hover
        : transparent;

    opacity: loading ? Theme.opacity-hover : 1.0;

    animate background { duration: Theme.dur-fast; easing: Theme.ease-standard; }
    animate opacity { duration: Theme.dur-fast; easing: Theme.ease-standard; }

    accessible-role: AccessibleRole.button;
    accessible-label: root.text;

    HorizontalLayout {
        alignment: center;
        spacing: Theme.sp-2;
        padding-left: padding-x-for(root.size);
        padding-right: padding-x-for(root.size);

        if show-icon && !loading: FaIcon {
            source: root.icon;
            fa-size: icon-size-for(root.size);
            fa-color: is-interactive ? Theme.text-secondary : Theme.btn-disabled-text;
            // See PrimaryButton.slint's header: HorizontalLayout does
            // not auto-center an Image-derived child, only Text.
            y: (parent.height - self.height) / 2;
        }

        if loading: ProgressSpinner {
            spinner-size: icon-size-for(root.size);
            stroke-width: 2px;
            spinner-color: Theme.text-secondary;
            y: (parent.height - self.height) / 2;
        }

        Text {
            text: root.text;
            color: is-interactive ? Theme.text-secondary : Theme.btn-disabled-text;
            font-size: font-size-for(root.size);
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    ta := TouchArea {
        enabled: root.is-interactive;
        mouse-cursor: root.is-interactive ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }

    fs := FocusScope {
        enabled: root.is-interactive;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                accept
            } else {
                reject
            }
        }
    }

    if fs.has-focus: Rectangle {
        x: -Theme.focus-ring-offset;
        y: -Theme.focus-ring-offset;
        width: parent.width + 2 * Theme.focus-ring-offset;
        height: parent.height + 2 * Theme.focus-ring-offset;
        border-radius: parent.border-radius + Theme.focus-ring-offset;
        border-width: Theme.focus-ring-width;
        border-color: Theme.focus-ring;
        background: transparent;
    }
}
