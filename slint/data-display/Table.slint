import { Theme } from "../core/Theme.slint";

// GridLayout instead of one independent HorizontalLayout per row: a
// single shared grid guarantees every row's columns land at identical
// x/width, which N separate HorizontalLayouts don't structurally
// guarantee (see PriceComparisonTable's fix history for why this matters).
export component Table inherits Rectangle {
    in property <[string]> columns: [];
    in property <int> row-count: 0;
    in property <bool> striped: false;
    in property <bool> bordered: false;
    in property <bool> header-visible: true;

    callback row-clicked(int);

    background: Theme.bg-surface;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border-base;
    clip: true;

    property <int> total-cols: max(1, root.columns.length);
    property <int> total-rows: 1 + root.row-count;

    GridLayout {
        spacing: 0px;

        for cell-idx in root.total-cols * root.total-rows: Rectangle {
            property <int> grid-row: Math.floor(cell-idx / root.total-cols);
            property <int> grid-col: mod(cell-idx, root.total-cols);
            property <bool> is-header: grid-row == 0;
            property <int> rowidx: grid-row - 1;

            row: grid-row;
            col: grid-col;
            height: is-header ? (root.header-visible ? 36px : 0px) : 40px;

            background: is-header ? Theme.bg-overlay
                : row-ta.pressed ? Theme.surface-pressed
                : row-ta.has-hover ? Theme.surface-hover
                : root.striped && mod(rowidx, 2) == 1 ? Theme.bg-overlay
                : transparent;

            animate background { duration: Theme.dur-fast; }

            if is-header && root.header-visible: Text {
                x: Theme.sp-3;
                y: (parent.height - self.height) / 2;
                text: grid-col < root.columns.length ? root.columns[grid-col] : "";
                color: Theme.text-secondary;
                font-family: Theme.font-ui;
                font-size: Theme.text-xs;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
            }

            if !is-header: Rectangle {
                height: 1px;
                y: parent.height - 1px;
                background: root.bordered ? Theme.border-subtle : transparent;
            }

            if !is-header: Text {
                x: Theme.sp-3;
                y: (parent.height - self.height) / 2;
                text: grid-col < root.columns.length ? "Row \{rowidx + 1} — \{root.columns[grid-col]}" : "";
                color: Theme.text-primary;
                font-family: Theme.font-ui;
                font-size: Theme.text-sm;
                vertical-alignment: center;
            }

            row-ta := TouchArea {
                enabled: !is-header;
                clicked => { root.row-clicked(rowidx); }
            }
        }
    }
}
