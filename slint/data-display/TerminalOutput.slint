import { Theme } from "../core/Theme.slint";

export component TerminalOutput inherits Rectangle {
    in property <string> prompt-text: "$";

    // Each command is followed by its output line, indexed 1:1.
    in property <[string]> demo-commands: ["ls -la", "cargo build"];
    in property <[string]> demo-outputs: ["total 48", "Finished dev profile [unoptimized + debuginfo]"];

    background: Theme.dark-mode ? #0D1117 : #1a1a2e;
    border-radius: Theme.radius-card;
    clip: true;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-1;

        // Title bar
        Rectangle {
            height: 24px;

            HorizontalLayout {
                spacing: Theme.sp-1-5;
                alignment: start;

                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: Theme.radius-full;
                    background: Theme.red-500;
                }

                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: Theme.radius-full;
                    background: Theme.amber-500;
                }

                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: Theme.radius-full;
                    background: Theme.green-500;
                }
            }
        }

        // Terminal lines
        Rectangle {
            clip: true;

            VerticalLayout {
                padding: 0;
                spacing: Theme.sp-0-5;

                for cmd[idx] in root.demo-commands: VerticalLayout {
                    spacing: Theme.sp-0-5;

                    HorizontalLayout {
                        spacing: Theme.sp-2;
                        // Missing here (same bug already fixed in
                        // JsonTreeViewer): without this, the prompt and
                        // command Text children spread apart instead of
                        // packing left, since this is a for-loop-generated
                        // row with no alignment set.
                        alignment: start;

                        Text {
                            text: root.prompt-text;
                            font-family: Theme.font-mono;
                            font-size: Theme.text-sm;
                            color: Theme.green-500;
                            vertical-alignment: center;
                        }

                        Text {
                            text: cmd;
                            font-family: Theme.font-mono;
                            font-size: Theme.text-sm;
                            color: #F1F2F5;
                            vertical-alignment: center;
                        }
                    }

                    if idx < root.demo-outputs.length: HorizontalLayout {
                        spacing: Theme.sp-2;
                        alignment: start;

                        Text {
                            text: "      ";
                            font-family: Theme.font-mono;
                            font-size: Theme.text-sm;
                            vertical-alignment: center;
                        }

                        Text {
                            text: root.demo-outputs[idx];
                            font-family: Theme.font-mono;
                            font-size: Theme.text-sm;
                            color: #9CA3AF;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
