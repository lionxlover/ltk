import { Theme } from "../core/Theme.slint";

export component OrgChart inherits Rectangle {
    // Fixed 3-node CEO/VP-Eng/VP-Design topology, not a general org-chart
    // renderer — `item-count`/`demo-levels` don't add or remove nodes;
    // laying out an arbitrary N-node tree is real algorithmic work
    // outside the scope of this component. `demo-titles`/`demo-colors`
    // are wired to the 3 fixed node positions below.
    in property <int> item-count: 3;

    background: Theme.bg-surface;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border-base;

    in property <[string]> demo-titles: ["CEO", "VP Eng", "VP Design"];
    in property <[int]> demo-levels: [0, 1, 1];
    in property <[color]> demo-colors: [Theme.accent, Theme.green_500, #CD7F32];

    // CEO Node
    Rectangle {
        x: (parent.width - 100px) / 2;
        y: 20px;
        width: 100px;
        height: 40px;
        border-radius: Theme.radius-md;
        background: root.demo-colors.length > 0 ? root.demo-colors[0] : Theme.accent;
        border-width: 1px;
        border-color: root.demo-colors.length > 0 ? root.demo-colors[0] : Theme.accent;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: root.demo-titles.length > 0 ? root.demo-titles[0] : "CEO";
            color: #ffffff;
            font-family: Theme.font-ui;
            font-size: Theme.text-sm;
            font-weight: Theme.weight-bold;
            vertical-alignment: center;
        }
    }

    // Vertical line from CEO
    Rectangle {
        x: (parent.width) / 2 - 1px;
        y: 60px;
        width: 2px;
        height: 20px;
        background: Theme.border-subtle;
    }

    // Horizontal connector line
    Rectangle {
        x: (parent.width - 140px) / 2;
        y: 78px;
        width: 140px;
        height: 2px;
        background: Theme.border-subtle;
    }

    // VP Eng Node
    Rectangle {
        // Was `(parent.width - 140px) / 2` — that's the connector line's
        // own half-width, not accounting for this box's own 100px width,
        // so it sat 50px too far right and overlapped VP Design by 10px
        // (confirmed by the person's Slint Preview screenshot showing the
        // two boxes touching/overlapping with no gap).
        x: (parent.width - 240px) / 2;
        y: 80px;
        width: 100px;
        height: 40px;
        border-radius: Theme.radius-md;
        background: Theme.bg-surface;
        border-width: 1px;
        border-color: root.demo-colors.length > 1 ? root.demo-colors[1] : Theme.green_500;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: root.demo-titles.length > 1 ? root.demo-titles[1] : "VP Eng";
            color: root.demo-colors.length > 1 ? root.demo-colors[1] : Theme.green_500;
            font-family: Theme.font-ui;
            font-size: Theme.text-sm;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }

    // VP Design Node
    Rectangle {
        x: (parent.width + 40px) / 2;
        y: 80px;
        width: 100px;
        height: 40px;
        border-radius: Theme.radius-md;
        background: Theme.bg-surface;
        border-width: 1px;
        border-color: root.demo-colors.length > 2 ? root.demo-colors[2] : #CD7F32;

        Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: root.demo-titles.length > 2 ? root.demo-titles[2] : "VP Design";
            color: root.demo-colors.length > 2 ? root.demo-colors[2] : #CD7F32;
            font-family: Theme.font-ui;
            font-size: Theme.text-sm;
            font-weight: Theme.weight-semibold;
            vertical-alignment: center;
        }
    }
}
