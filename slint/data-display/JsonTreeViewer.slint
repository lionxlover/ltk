import { Theme } from "../core/Theme.slint";

export component JsonTreeViewer inherits Rectangle {
    // Previously declared but never consulted anywhere in the body — the
    // tree was 4 fully hardcoded rows regardless of this property's value.
    in property <int> item-count: 4;
    in property <[string]> demo-keys: ["name", "version", "debug", "tags"];
    in property <[string]> demo-values: ["\"LTK\"", "1.0", "false", "[…]"];
    in property <[brush]> demo-value-colors: [Theme.green-600, Theme.amber-600, Theme.red-600, Theme.text-tertiary];
    // Marks a row as a collapsed array/object (shows a "▶" disclosure
    // triangle before the key instead of the usual blank gutter).
    in property <[bool]> demo-collapsed: [false, false, false, true];

    background: Theme.bg-surface;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    VerticalLayout {
        padding: 0;

        // Header
        Rectangle {
            background: Theme.bg-overlay;
            height: 32px;

            HorizontalLayout {
                padding-left: Theme.sp-3;
                padding-right: Theme.sp-3;
                alignment: start;

                Text {
                    text: "JSON Tree";
                    font-family: Theme.font-ui;
                    font-size: Theme.text-sm;
                    font-weight: Theme.weight-semibold;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }

        // Tree content
        Rectangle {
            clip: true;

            VerticalLayout {
                padding: Theme.sp-3;
                spacing: 0;

                // Root opening brace
                HorizontalLayout {
                    spacing: 0;
                    alignment: start;

                    Text {
                        text: "▼ ";
                        font-family: Theme.font-mono;
                        font-size: Theme.text-sm;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "{";
                        font-family: Theme.font-mono;
                        font-size: Theme.text-sm;
                        font-weight: Theme.weight-semibold;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }

                for key[idx] in root.item-count: HorizontalLayout {
                    padding-left: Theme.sp-5;
                    spacing: 0;
                    // Without this, the row's Text children spread apart
                    // across the full row width instead of packing
                    // tightly like inline JSON syntax (confirmed via the
                    // person's Slint Preview screenshot — key/colon/value
                    // rendered far apart from each other in every row).
                    alignment: start;

                    Text {
                        text: idx < root.demo-collapsed.length && root.demo-collapsed[idx] ? "▶ " : "";
                        font-family: Theme.font-mono;
                        font-size: Theme.text-sm;
                        color: Theme.text-tertiary;
                        vertical-alignment: center;
                    }

                    Text {
                        text: idx < root.demo-keys.length ? "\"\{root.demo-keys[idx]}\"" : "";
                        font-family: Theme.font-mono;
                        font-size: Theme.text-sm;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }

                    Text {
                        text: ": ";
                        font-family: Theme.font-mono;
                        font-size: Theme.text-sm;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }

                    Text {
                        text: idx < root.demo-values.length ? root.demo-values[idx] : "";
                        font-family: Theme.font-mono;
                        font-size: Theme.text-sm;
                        color: idx < root.demo-value-colors.length ? root.demo-value-colors[idx] : Theme.text-primary;
                        vertical-alignment: center;
                    }
                }

                // Root closing brace
                HorizontalLayout {
                    spacing: 0;
                    alignment: start;

                    Text {
                        text: "}";
                        font-family: Theme.font-mono;
                        font-size: Theme.text-sm;
                        font-weight: Theme.weight-semibold;
                        color: Theme.text-primary;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
