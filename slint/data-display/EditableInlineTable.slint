import { Theme } from "../core/Theme.slint";

// Header + rows on a single GridLayout instead of independent
// HorizontalLayouts — see PriceComparisonTable's fix history for why
// this matters for column alignment across rows.
export component EditableInlineTable inherits Rectangle {
    in property <[string]> columns: [];
    in property <int> row-count: 0;
    // Flat, row-major: cell-values[row * columns.length + col] — same
    // indexing scheme already used by FeatureComparisonMatrix/
    // PriceComparisonTable in this batch for their `matrix` property.
    in property <[string]> cell-values: [];

    callback cell-edited(int, int, string);
    callback row-clicked(int);

    background: Theme.bg-surface;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border-base;
    clip: true;

    property <int> total-cols: max(1, root.columns.length);
    property <int> total-rows: 1 + root.row-count;

    GridLayout {
        spacing: 0px;

        for cell-idx in root.total-cols * root.total-rows: Rectangle {
            property <int> grid-row: Math.floor(cell-idx / root.total-cols);
            property <int> grid-col: mod(cell-idx, root.total-cols);
            property <bool> is-header: grid-row == 0;
            property <int> rowidx: grid-row - 1;

            row: grid-row;
            col: grid-col;
            height: is-header ? (root.columns.length > 0 ? 40px : 0px) : 40px;

            background: is-header ? Theme.bg-overlay
                : row-ta.pressed ? Theme.surface-pressed
                : row-ta.has-hover ? Theme.surface-hover
                : transparent;

            animate background { duration: Theme.dur-fast; }

            if is-header: Text {
                x: Theme.sp-3;
                y: (parent.height - self.height) / 2;
                text: grid-col < root.columns.length ? root.columns[grid-col] : "";
                color: Theme.text-secondary;
                font-family: Theme.font-ui;
                font-size: Theme.text-xs;
                font-weight: Theme.weight-semibold;
                vertical-alignment: center;
            }

            if !is-header: Rectangle {
                x: Theme.sp-2;
                y: 6px;
                width: parent.width - Theme.sp-4;
                height: 28px;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: cell-input.has-focus ? Theme.accent : transparent;

                animate border-color { duration: Theme.dur-fast; }

                cell-input := TextInput {
                    x: Theme.sp-2;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - Theme.sp-4;
                    text: (rowidx * root.columns.length + grid-col) < root.cell-values.length
                        ? root.cell-values[rowidx * root.columns.length + grid-col]
                        : "";
                    color: Theme.text-primary;
                    font-family: Theme.font-ui;
                    font-size: Theme.text-sm;
                    edited => {
                        root.cell-edited(rowidx, grid-col, self.text);
                    }
                }
            }

            row-ta := TouchArea {
                enabled: !is-header;
                clicked => { root.row-clicked(rowidx); }
            }
        }
    }
}
