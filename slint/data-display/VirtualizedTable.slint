import { Theme } from "../core/Theme.slint";

// Header + rows on a single GridLayout instead of independent
// HorizontalLayouts — see PriceComparisonTable's fix history for why
// this matters for column alignment across rows.
export component VirtualizedTable inherits Rectangle {
    in property <[string]> columns: [];
    in property <int> total-rows: 100;
    in property <int> visible-start: 0;
    in property <int> visible-count: 20;

    callback row-clicked(int);

    background: Theme.bg-surface;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border-base;
    clip: true;

    property <int> total-cols: max(1, root.columns.length);
    property <int> grid-total-rows: 1 + root.visible-count;

    VerticalLayout {
        Rectangle {
            height: 32px;
            background: Theme.bg-overlay;

            HorizontalLayout {
                padding-left: Theme.sp-3;
                padding-right: Theme.sp-3;

                Text {
                    text: "Showing \{root.visible-start + 1}–\{root.visible-start + root.visible-count} of \{root.total-rows} rows";
                    color: Theme.text-tertiary;
                    font-family: Theme.font-ui;
                    font-size: Theme.text-xs;
                    vertical-alignment: center;
                }
            }
        }

        GridLayout {
            spacing: 0px;

            for cell-idx in root.total-cols * root.grid-total-rows: Rectangle {
                property <int> grid-row: Math.floor(cell-idx / root.total-cols);
                property <int> grid-col: mod(cell-idx, root.total-cols);
                property <bool> is-header: grid-row == 0;
                property <int> rowidx: grid-row - 1;

                row: grid-row;
                col: grid-col;
                height: is-header ? (root.columns.length > 0 ? 36px : 0px) : 36px;

                background: is-header ? Theme.bg-overlay
                    : row-ta.pressed ? Theme.surface-pressed
                    : row-ta.has-hover ? Theme.surface-hover
                    : transparent;

                animate background { duration: Theme.dur-fast; }

                Text {
                    x: Theme.sp-3;
                    y: (parent.height - self.height) / 2;
                    text: grid-col >= root.columns.length ? ""
                        : is-header ? root.columns[grid-col]
                        : "Row \{root.visible-start + rowidx + 1} — \{root.columns[grid-col]}";
                    color: is-header ? Theme.text-secondary : Theme.text-primary;
                    font-family: Theme.font-ui;
                    font-size: is-header ? Theme.text-xs : Theme.text-sm;
                    font-weight: is-header ? Theme.weight-semibold : Theme.weight-regular;
                    vertical-alignment: center;
                }

                row-ta := TouchArea {
                    enabled: !is-header;
                    clicked => { root.row-clicked(root.visible-start + rowidx); }
                }
            }
        }
    }
}
