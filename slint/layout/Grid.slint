import { Theme } from "../core/Theme.slint";

// A thin wrapper around the built-in GridLayout: inheriting it directly (rather
// than nesting one inside a Rectangle) means children placed at the usage site
// (`Grid { Foo { row: 0; col: 0; } Bar { row: 0; col: 1; } }`) become direct
// children of the layout and are positioned automatically — no @children
// forwarding needed, and none possible here anyway, since @children can only
// appear once per component and this component has no single fixed slot to
// put it in.
export component Grid inherits GridLayout {
    in property <length> gap: Theme.sp-3;

    spacing: root.gap;
}
