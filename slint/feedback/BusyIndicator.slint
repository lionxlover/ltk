import { Theme } from "../core/Theme.slint";

// Two issues:
// 1. `opacity: running ? 1.0 : 0.3;` was dead code — the root already
//    has `visible: running;`, so nothing renders at all when
//    `running` is false regardless of what this opacity was set to.
// 2. No rotation at all — a "busy indicator" using a refresh-icon glyph
//    that never actually spins doesn't communicate "in progress."
//    Added continuous rotation using this project's own confirmed
//    pattern for infinite loops (a static binding never animates;
//    `init =>` needs to nudge the value once — see
//    SLINT-GOTCHAS-DISCOVERED.md).
export component BusyIndicator inherits Rectangle {
    in property <bool> running: true;

    visible: running;

    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: parent.height;
        source: @image-url("../../src/images/refresh.svg");
        image-fit: contain;
        colorize: Theme.text-tertiary;

        property <float> spin-angle: 0;
        transform-rotation: spin-angle * 1deg;
        animate spin-angle { duration: 900ms; easing: Theme.ease-in-out; iteration-count: -1; }
        init => { spin-angle = 360; }
    }
}

