import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

// Bug: `callback action();` was declared but nothing in the component
// could ever trigger it — no button, no TouchArea referencing it
// anywhere. Any host listening for this callback would never receive
// it no matter what the user did. Added an actual action button
// (following the same pattern as ErrorState's "Retry"), shown only
// when the host supplies a label — so a host that genuinely doesn't
// want a call-to-action can still leave it out.
export component EmptyState inherits Rectangle {
    in property <string> title: "Nothing here";
    in property <string> description: "No data to display yet.";
    in property <string> action-label: "";

    callback action();

    background: Theme.bg-base;
    horizontal-stretch: 1;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Rectangle {
            width: 64px;
            height: 64px;
            background: Theme.bg-overlay;
            border-radius: 32px;

            FaIcon {
                source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/inbox.svg");
                fa-size: 28px;
                fa-color: Theme.text-tertiary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: 16px;
            font-weight: Theme.weight-semibold;
            horizontal-alignment: center;
        }

        Text {
            text: root.description;
            color: Theme.text-secondary;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.action-label != "": Rectangle {
            height: 36px;
            background: Theme.accent;
            border-radius: Theme.radius-md;
            horizontal-stretch: 0;

            HorizontalLayout {
                padding-left: Theme.sp-4;
                padding-right: Theme.sp-4;

                Text {
                    text: root.action-label;
                    color: #ffffff;
                    font-size: 13px;
                    font-weight: Theme.weight-semibold;
                    vertical-alignment: center;
                }
            }

            TouchArea { clicked => { root.action(); } }
        }
    }
}

