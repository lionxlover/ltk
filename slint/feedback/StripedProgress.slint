import { Theme } from "../core/Theme.slint";

export component StripedProgress inherits Rectangle {
    in property <float> value: 0;
    in property <float> max: 100;

    in property <color> bar-color: Theme.accent;
    in property <color> track-color: Theme.bg-overlay;

    height: 10px;
    background: transparent;

    track-bg := Rectangle {
        border-radius: Theme.radius-full;
        background: track-color;
    }

    fill-rect := Rectangle {
        x: 0;
        y: 0;
        width: parent.width * Math.min(value, max) / max;
        height: parent.height;
        border-radius: Theme.radius-full;
        background: bar-color;
        clip: true;

        stripe1 := Rectangle {
            x: -16px;
            y: 0;
            width: 6px;
            height: parent.height;
            background: rgba(255, 255, 255, 0.2);
            animate x { duration: 800ms; iteration-count: -1; }
        }

        stripe2 := Rectangle {
            x: 4px;
            y: 0;
            width: 6px;
            height: parent.height;
            background: rgba(255, 255, 255, 0.2);
            animate x { duration: 800ms; iteration-count: -1; }
        }

        stripe3 := Rectangle {
            x: 24px;
            y: 0;
            width: 6px;
            height: parent.height;
            background: rgba(255, 255, 255, 0.2);
            animate x { duration: 800ms; iteration-count: -1; }
        }

        stripe4 := Rectangle {
            x: 44px;
            y: 0;
            width: 6px;
            height: parent.height;
            background: rgba(255, 255, 255, 0.2);
            animate x { duration: 800ms; iteration-count: -1; }
        }

        stripe5 := Rectangle {
            x: 64px;
            y: 0;
            width: 6px;
            height: parent.height;
            background: rgba(255, 255, 255, 0.2);
            animate x { duration: 800ms; iteration-count: -1; }
        }
    }
}
