import { Theme } from "../core/Theme.slint";
import { SkeletonHeading } from "./SkeletonHeading.slint";
import { SkeletonText } from "./SkeletonText.slint";

export component SkeletonCard inherits Rectangle {
    background: Theme.bg-surface;
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-base;

    VerticalLayout {
        Rectangle {
            height: 120px;
            background: Theme.bg-overlay;
            border-radius: Theme.radius-lg;

            // Gap: no animation (see SkeletonImage.slint) — this
            // duplicates that component's pattern inline rather than
            // reusing it, so it needed the same fix applied separately.
            property <float> pulse: 1.0;
            opacity: pulse;
            animate pulse { duration: 900ms; easing: Theme.ease-in-out; iteration-count: -1; direction: alternate; }
            init => { pulse = 0.5; }
        }

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            SkeletonHeading { skeleton-width: parent.width * 0.6; }

            SkeletonText { skeleton-width: parent.width; }
            SkeletonText { skeleton-width: parent.width * 0.8; }
        }
    }
}
