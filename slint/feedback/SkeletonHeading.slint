import { Theme } from "../core/Theme.slint";

// Gap: no animation at all (see SkeletonImage.slint for the full
// rationale — same fix applied to every skeleton primitive in this
// category).
export component SkeletonHeading inherits Rectangle {
    in property <length> skeleton-width: 180px;

    width: skeleton-width;
    height: 24px;
    background: Theme.bg-overlay;
    border-radius: 4px;

    property <float> pulse: 1.0;
    opacity: pulse;
    animate pulse { duration: 900ms; easing: Theme.ease-in-out; iteration-count: -1; direction: alternate; }
    init => { pulse = 0.5; }
}

