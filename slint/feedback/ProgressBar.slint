import { Theme } from "../core/Theme.slint";

export component ProgressBar inherits Rectangle {
    in property <float> value: 0;
    in property <float> maximum: 100;
    in property <bool> indeterminate: false;
    in property <color> progress-color: Theme.accent;
    in property <color> track-color: Theme.bg-overlay;

    height: 6px;
    background: transparent;

    track := Rectangle {
        border-radius: Theme.radius-full;
        background: track-color;
    }

    fill := Rectangle {
        x: 0;
        y: 0;
        width: indeterminate ? parent.width * 0.4 : (parent.width * Math.min(value, maximum) / maximum);
        height: parent.height;
        border-radius: Theme.radius-full;
        background: progress-color;
        visible: !indeterminate;
    }

    indeterminate-rect := Rectangle {
        // Bug: `x` was bound to a static conditional value
        // (`indeterminate ? parent.width * 0.3 : 0px`) — it only ever
        // changes once, at the moment `indeterminate` itself toggles,
        // so the attached `animate x` played a single 1200ms transition
        // and then sat still forever after. Same "static binding never
        // truly loops" issue as PulseLoader/IndeterminateProgress in
        // this category. Fixed with the same confirmed nudge + repeat
        // technique used in IndeterminateProgress.slint: an internal
        // `sweep` property drives `x` across the full track and repeats.
        property <float> sweep: 0;
        x: indeterminate ? (sweep * 1.4 - 0.4) * parent.width : 0px;
        y: 0;
        width: parent.width * 0.4;
        height: parent.height;
        border-radius: Theme.radius-full;
        background: progress-color;
        visible: indeterminate;
        opacity: indeterminate ? 0.6 : 0;
        animate sweep { duration: 1200ms; easing: Theme.ease-in-out; iteration-count: -1; }
        animate opacity { duration: 300ms; }
        init => { sweep = 1; }
    }
}
