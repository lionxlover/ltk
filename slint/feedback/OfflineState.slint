import { Theme } from "../core/Theme.slint";
import { FaIcon } from "../core/FaIcon.slint";

// Bug: referenced `wifi-slash.svg`, which doesn't exist in this
// project's bundled FontAwesome set (confirmed by checking the actual
// file listing) — an `@image-url()` pointing at a missing file. Swapped
// for `plug-circle-xmark`, a real icon conveying the same "disconnected"
// meaning.
export component OfflineState inherits Rectangle {
    in property <string> message: "No internet connection";

    background: Theme.bg-base;
    horizontal-stretch: 1;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Rectangle {
            width: 64px;
            height: 64px;
            background: Theme.bg-overlay;
            border-radius: 32px;

            FaIcon {
                source: @image-url("../../fontawesome-free-7.3.0-desktop/svgs/solid/plug-circle-xmark.svg");
                fa-size: 28px;
                fa-color: Theme.text-tertiary;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: "Offline";
            color: Theme.text-primary;
            font-size: 16px;
            font-weight: Theme.weight-semibold;
            horizontal-alignment: center;
        }

        Text {
            text: root.message;
            color: Theme.text-secondary;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
