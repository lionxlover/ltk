import { Theme } from "../core/Theme.slint";

// Bug: three static bars at fixed heights with no animation at all — a
// "wave loader" that never moves reads as decoration, not a loading
// indicator. Used `animation-tick()` (Slint's sanctioned mechanism for
// continuously-running animations, confirmed via docs: "for permanently
// running animations, see animation-tick()") to drive each bar's height
// through a staggered sine-like cycle, the same idiom this project's
// own DotsLoader already uses correctly for its blink cycle.
export component WaveLoader inherits Rectangle {
    in property <length> size: 32px;

    width: size * 1.5;
    height: size;
    background: #00000000;

    Rectangle {
        width: 4px;
        height: parent.height * (0.35 + 0.35 * Math.abs(sin(Math.mod(animation-tick() + 0ms, 900ms) / 900ms * 360deg)));
        x: parent.width * 0.2;
        y: (parent.height - self.height) / 2;
        background: Theme.accent;
        border-radius: 2px;
    }

    Rectangle {
        width: 4px;
        height: parent.height * (0.35 + 0.35 * Math.abs(sin(Math.mod(animation-tick() + 300ms, 900ms) / 900ms * 360deg)));
        x: parent.width * 0.45;
        y: (parent.height - self.height) / 2;
        background: Theme.accent;
        border-radius: 2px;
    }

    Rectangle {
        width: 4px;
        height: parent.height * (0.35 + 0.35 * Math.abs(sin(Math.mod(animation-tick() + 600ms, 900ms) / 900ms * 360deg)));
        x: parent.width * 0.7;
        y: (parent.height - self.height) / 2;
        background: Theme.accent;
        border-radius: 2px;
    }
}

