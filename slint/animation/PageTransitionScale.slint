import { Theme } from "../core/Theme.slint";

export component PageTransitionScale inherits Rectangle {
    background: transparent;
    clip: true;

    in property <bool> scale-visible: false;

    opacity: scale-visible ? 1 : 0;
    // Was only fading opacity — a component literally named "Scale"
    // never actually scaled anything. transform-scale is the confirmed
    // real property for this.
    transform-scale: scale-visible ? 1.0 : 0.92;
    animate opacity, transform-scale { duration: Theme.dur-normal; easing: Theme.ease-spring; }

    @children
}
