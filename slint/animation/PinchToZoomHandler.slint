import { Theme } from "../core/Theme.slint";

export component PinchToZoomHandler inherits Rectangle {
    background: transparent;
    clip: true;

    in property <float> scale: 1.0;
    in property <float> min-scale: 0.5;
    in property <float> max-scale: 3.0;

    // `scale` was driving opacity, which has nothing to do with zoom —
    // transform-scale is the confirmed real property for this, and the
    // declared min/max-scale were never used to clamp anything.
    transform-scale: scale.clamp(min-scale, max-scale);

    @children
}
