import { Theme } from "../core/Theme.slint";

// Same fixed-8-point technique as LineChart (see its header comment for
// why: Path can't loop over a dynamic-length array). The fill closes back
// down to the baseline (y=100) to form a real area shape instead of the
// per-segment rectangles the original used, which left the last segment
// clipped off entirely (`x: i * width/(n-1)` puts the final point's
// rectangle fully past the right edge).
export component AreaChart inherits Rectangle {
    in property <[float]> data: [0.2, 0.5, 0.3, 0.8, 0.6, 0.9, 0.7];
    in property <string> label: "Area Chart";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    property <int> len: root.data.length;
    property <int> denom: max(1, len - 1);
    property <int> idx0: 0;
    property <int> idx1: 1 < len ? 1 : (len > 0 ? len - 1 : 0);
    property <int> idx2: 2 < len ? 2 : (len > 0 ? len - 1 : 0);
    property <int> idx3: 3 < len ? 3 : (len > 0 ? len - 1 : 0);
    property <int> idx4: 4 < len ? 4 : (len > 0 ? len - 1 : 0);
    property <int> idx5: 5 < len ? 5 : (len > 0 ? len - 1 : 0);
    property <int> idx6: 6 < len ? 6 : (len > 0 ? len - 1 : 0);
    property <int> idx7: 7 < len ? 7 : (len > 0 ? len - 1 : 0);
    property <float> v0: len > 0 ? root.data[idx0] : 0;
    property <float> v1: len > 0 ? root.data[idx1] : 0;
    property <float> v2: len > 0 ? root.data[idx2] : 0;
    property <float> v3: len > 0 ? root.data[idx3] : 0;
    property <float> v4: len > 0 ? root.data[idx4] : 0;
    property <float> v5: len > 0 ? root.data[idx5] : 0;
    property <float> v6: len > 0 ? root.data[idx6] : 0;
    property <float> v7: len > 0 ? root.data[idx7] : 0;
    property <float> x0: idx0 / denom * 100;
    property <float> x1: idx1 / denom * 100;
    property <float> x2: idx2 / denom * 100;
    property <float> x3: idx3 / denom * 100;
    property <float> x4: idx4 / denom * 100;
    property <float> x5: idx5 / denom * 100;
    property <float> x6: idx6 / denom * 100;
    property <float> x7: idx7 / denom * 100;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        Rectangle { vertical-stretch: 1; clip: true;
            Path {
                width: parent.width; height: parent.height;
                viewbox-width: 100; viewbox-height: 100;
                fill: Theme.accent-subtle;
                MoveTo { x: x0; y: 100; }
                LineTo { x: x0; y: (1 - v0) * 100; }
                LineTo { x: x1; y: (1 - v1) * 100; }
                LineTo { x: x2; y: (1 - v2) * 100; }
                LineTo { x: x3; y: (1 - v3) * 100; }
                LineTo { x: x4; y: (1 - v4) * 100; }
                LineTo { x: x5; y: (1 - v5) * 100; }
                LineTo { x: x6; y: (1 - v6) * 100; }
                LineTo { x: x7; y: (1 - v7) * 100; }
                LineTo { x: x7; y: 100; }
                Close { }
            }
            Path {
                width: parent.width; height: parent.height;
                viewbox-width: 100; viewbox-height: 100;
                stroke: Theme.accent;
                stroke-width: 2px;
                MoveTo { x: x0; y: (1 - v0) * 100; }
                LineTo { x: x1; y: (1 - v1) * 100; }
                LineTo { x: x2; y: (1 - v2) * 100; }
                LineTo { x: x3; y: (1 - v3) * 100; }
                LineTo { x: x4; y: (1 - v4) * 100; }
                LineTo { x: x5; y: (1 - v5) * 100; }
                LineTo { x: x6; y: (1 - v6) * 100; }
                LineTo { x: x7; y: (1 - v7) * 100; }
            }

            for pt[i] in root.data: Rectangle {
                x: i * (parent.width / (root.data.length > 1 ? root.data.length - 1 : 1)) - self.width / 2;
                y: parent.height - pt * parent.height - self.height / 2;
                width: 6px; height: 6px;
                border-radius: Theme.radius-full;
                background: Theme.accent;
                border-width: 2px;
                border-color: Theme.bg-surface;
            }
        }
    }
}
