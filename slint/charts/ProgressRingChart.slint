import { Theme } from "../core/Theme.slint";

export component ProgressRingChart inherits Rectangle {
    in property <int> progress: 72;
    in property <string> label: "Progress";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        if label != "": Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        Rectangle { vertical-stretch: 1;
            Rectangle {
                width: 80px; height: 80px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-full;
                border-width: 6px;
                border-color: Theme.bg-overlay;
                background: transparent;
            }
            Rectangle {
                width: 80px; height: 80px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-full;
                border-width: 6px;
                border-color: Theme.accent;
                background: transparent;
            }
            Text {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                text: "\{root.progress}%";
                color: Theme.text-primary;
                font-size: Theme.text-sm;
                font-weight: Theme.weight-bold;
                vertical-alignment: center;
            }
        }
    }
}
