import { Theme } from "../core/Theme.slint";

// Same bug as GaugeChart: `progress` was declared but the ring was always
// drawn as a full circle in one fixed color. Fixed with a conic-gradient
// arc sized to `progress`/100.
export component ProgressRingChart inherits Rectangle {
    in property <int> progress: 72;
    in property <string> label: "Progress";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    property <float> fraction: max(0.0, min(1.0, root.progress / 100));

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        if label != "": Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        Rectangle { vertical-stretch: 1;
            Rectangle {
                width: 80px; height: 80px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-full;
                background: @conic-gradient(from 0deg,
                    Theme.accent 0deg, Theme.accent root.fraction * 360deg,
                    Theme.bg-overlay root.fraction * 360deg, Theme.bg-overlay 360deg);
            }
            Rectangle {
                width: 68px; height: 68px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-full;
                background: Theme.bg-surface;
            }
            Text {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                text: "\{root.progress}%";
                color: Theme.text-primary;
                font-size: Theme.text-sm;
                font-weight: Theme.weight-bold;
                vertical-alignment: center;
            }
        }
    }
}
