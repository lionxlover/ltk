import { Theme } from "../core/Theme.slint";

export component Histogram inherits Rectangle {
    in property <[int]> bins: [3, 7, 12, 9, 5, 2];
    in property <string> label: "Histogram";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        HorizontalLayout { vertical-stretch: 1; spacing: 2px; alignment: end;
            for bin[i] in root.bins: Rectangle { horizontal-stretch: 1;
                VerticalLayout { alignment: end;
                    Rectangle { height: bin * 6px; background: Theme.accent; border-radius: 2px; }
                }
            }
        }
    }
}
