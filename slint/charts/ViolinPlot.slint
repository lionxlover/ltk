import { Theme } from "../core/Theme.slint";

export component ViolinPlot inherits Rectangle {
    in property <[int]> count: [0, 1, 2, 3];
    in property <string> label: "Violin Plot";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        // Bug: `alignment: center` on this HorizontalLayout overrode
        // `horizontal-stretch`, so every violin collapsed toward its own
        // (much narrower) preferred width instead of dividing the row
        // evenly — inconsistent, often-invisible spacing. Removed;
        // the inner VerticalLayout's own `alignment: center` (vertically
        // centering the two pills) was unaffected and unchanged.
        HorizontalLayout { vertical-stretch: 1; spacing: Theme.sp-3;
            for v[i] in root.count: Rectangle { horizontal-stretch: 1;
                VerticalLayout { alignment: center;
                    Rectangle { width: 24px; height: 12px; background: Theme.accent-subtle; border-radius: 12px; }
                    Rectangle { width: 24px; height: 12px; background: Theme.accent-subtle; border-radius: 12px; }
                }
            }
        }
    }
}
