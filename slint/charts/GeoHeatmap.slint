import { Theme } from "../core/Theme.slint";

export component GeoHeatmap inherits Rectangle {
    in property <string> label: "Geo Heatmap";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        Rectangle { vertical-stretch: 1; background: Theme.bg-overlay; border-radius: Theme.radius-sm;
            Rectangle { x: 40px; y: 30px; width: 40px; height: 40px; border-radius: Theme.radius-full; background: Theme.state-error; opacity: 0.6; }
            Rectangle { x: 100px; y: 20px; width: 30px; height: 30px; border-radius: Theme.radius-full; background: Theme.state-warning; opacity: 0.5; }
            Rectangle { x: 160px; y: 40px; width: 35px; height: 35px; border-radius: Theme.radius-full; background: Theme.state-success; opacity: 0.4; }
            Rectangle { x: 80px; y: 60px; width: 25px; height: 25px; border-radius: Theme.radius-full; background: Theme.accent; opacity: 0.5; }
        }
    }
}
