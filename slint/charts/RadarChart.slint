import { Theme } from "../core/Theme.slint";

export component RadarChart inherits Rectangle {
    in property <string> label: "Radar Chart";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        Rectangle { vertical-stretch: 1;
            Rectangle {
                width: 120px; height: 120px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-full;
                border-width: 1px;
                border-color: Theme.border-subtle;
                background: transparent;
            }
            Rectangle {
                width: 80px; height: 80px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-full;
                border-width: 1px;
                border-color: Theme.border-subtle;
                background: transparent;
            }
            Rectangle {
                width: 40px; height: 40px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-full;
                border-width: 1px;
                border-color: Theme.border-subtle;
                background: transparent;
            }

            Rectangle {
                width: 8px; height: 8px;
                x: (parent.width) / 2 - 4px; y: (parent.height) / 2 - 60px;
                border-radius: Theme.radius-full; background: Theme.accent;
            }
            Rectangle {
                width: 8px; height: 8px;
                x: (parent.width) / 2 + 50px; y: (parent.height) / 2 - 30px;
                border-radius: Theme.radius-full; background: Theme.accent;
            }
            Rectangle {
                width: 8px; height: 8px;
                x: (parent.width) / 2 + 30px; y: (parent.height) / 2 + 40px;
                border-radius: Theme.radius-full; background: Theme.accent;
            }
            Rectangle {
                width: 8px; height: 8px;
                x: (parent.width) / 2 - 40px; y: (parent.height) / 2 + 30px;
                border-radius: Theme.radius-full; background: Theme.accent;
            }
            Rectangle {
                width: 8px; height: 8px;
                x: (parent.width) / 2 - 50px; y: (parent.height) / 2 - 20px;
                border-radius: Theme.radius-full; background: Theme.accent;
            }
        }
    }
}
