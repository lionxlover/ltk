import { Theme } from "../core/Theme.slint";

export component CandlestickChart inherits Rectangle {
    in property <[int]> count: [0, 1, 2, 3, 4, 5, 6, 7];
    in property <string> label: "Candlestick (OHLC)";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        // Same bug as StackedBarChart/BoxPlot: `alignment: center`
        // overrode `horizontal-stretch`, so candles crowded to their
        // narrow (~8px) preferred width instead of spreading evenly.
        HorizontalLayout { vertical-stretch: 1; spacing: Theme.sp-1;
            for c[i] in root.count: Rectangle { horizontal-stretch: 1;
                VerticalLayout { alignment: center;
                    Rectangle { width: 1px; height: 20px; background: Math.mod(i, 2) == 0 ? Theme.state-success : Theme.state-error; }
                    Rectangle { width: 8px; height: 16px; background: Math.mod(i, 2) == 0 ? Theme.state-success : Theme.state-error; border-radius: 1px; }
                    Rectangle { width: 1px; height: 14px; background: Math.mod(i, 2) == 0 ? Theme.state-success : Theme.state-error; }
                }
            }
        }
    }
}
