import { Theme } from "../core/Theme.slint";

// The original always drew a full-circle border in a single fixed color —
// `value` was declared but never actually affected the drawing. Fixed with
// the same conic-gradient technique as PieChart/ProgressRingChart: a
// colored arc sized to `value`/`max-value`, track color for the remainder.
// (Named it `max-value`, not `max` — a property called `max` shadows the
// builtin `max()` function used below, breaking the "not a function" way.)
export component GaugeChart inherits Rectangle {
    in property <int> value: 72;
    in property <int> max-value: 100;
    in property <string> label: "Gauge";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    property <float> fraction: root.max-value > 0 ? max(0.0, min(1.0, root.value / root.max-value)) : 0;
    property <brush> fill-color: root.fraction > 0.8 ? Theme.state-error
        : root.fraction > 0.6 ? Theme.state-warning
        : Theme.accent;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        Rectangle { vertical-stretch: 1;
            Rectangle {
                width: 100px; height: 100px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-full;
                background: @conic-gradient(from 0deg,
                    root.fill-color 0deg, root.fill-color root.fraction * 360deg,
                    Theme.bg-overlay root.fraction * 360deg, Theme.bg-overlay 360deg);
            }
            Rectangle {
                width: 80px; height: 80px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-full;
                background: Theme.bg-surface;
            }

            Text {
                x: (parent.width - self.width) / 2; y: (parent.height) / 2;
                text: "\{root.value}%";
                color: Theme.text-primary;
                font-size: Theme.text-xl;
                font-weight: Theme.weight-bold;
                font-family: Theme.font-display;
            }
        }
    }
}
