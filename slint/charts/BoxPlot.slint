import { Theme } from "../core/Theme.slint";

export component BoxPlot inherits Rectangle {
    in property <[int]> count: [0, 1, 2, 3, 4];
    in property <string> label: "Box Plot";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        // Same bug as StackedBarChart/ViolinPlot: `alignment: center`
        // overrode `horizontal-stretch`, so boxes crowded together at
        // their narrow (~20px) preferred width instead of spreading
        // evenly across the row.
        HorizontalLayout { vertical-stretch: 1; spacing: Theme.sp-2;
            for b[i] in root.count: Rectangle { horizontal-stretch: 1;
                VerticalLayout { alignment: center;
                    Rectangle { width: 1px; height: 20px; background: Theme.text-tertiary; }
                    Rectangle { width: 20px; height: 30px; background: Theme.accent-subtle; border-width: 1px; border-color: Theme.accent; border-radius: 2px; }
                    Rectangle { width: 1px; height: 20px; background: Theme.text-tertiary; }
                }
            }
        }
    }
}
