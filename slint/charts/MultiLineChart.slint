import { Theme } from "../core/Theme.slint";

// Same fixed-8-point Path technique as LineChart (see its header comment).
export component MultiLineChart inherits Rectangle {
    in property <[float]> series-a: [0.2, 0.5, 0.3, 0.8, 0.6];
    in property <[float]> series-b: [0.4, 0.3, 0.7, 0.5, 0.9];
    in property <string> label: "Multi-series Line Chart";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    property <int> alen: root.series-a.length;
    property <int> adenom: max(1, alen - 1);
    property <int> aidx0: 0;
    property <int> aidx1: 1 < alen ? 1 : (alen > 0 ? alen - 1 : 0);
    property <int> aidx2: 2 < alen ? 2 : (alen > 0 ? alen - 1 : 0);
    property <int> aidx3: 3 < alen ? 3 : (alen > 0 ? alen - 1 : 0);
    property <int> aidx4: 4 < alen ? 4 : (alen > 0 ? alen - 1 : 0);
    property <int> aidx5: 5 < alen ? 5 : (alen > 0 ? alen - 1 : 0);
    property <int> aidx6: 6 < alen ? 6 : (alen > 0 ? alen - 1 : 0);
    property <int> aidx7: 7 < alen ? 7 : (alen > 0 ? alen - 1 : 0);
    property <float> av0: alen > 0 ? root.series-a[aidx0] : 0;
    property <float> av1: alen > 0 ? root.series-a[aidx1] : 0;
    property <float> av2: alen > 0 ? root.series-a[aidx2] : 0;
    property <float> av3: alen > 0 ? root.series-a[aidx3] : 0;
    property <float> av4: alen > 0 ? root.series-a[aidx4] : 0;
    property <float> av5: alen > 0 ? root.series-a[aidx5] : 0;
    property <float> av6: alen > 0 ? root.series-a[aidx6] : 0;
    property <float> av7: alen > 0 ? root.series-a[aidx7] : 0;
    property <float> ax0: aidx0 / adenom * 100;
    property <float> ax1: aidx1 / adenom * 100;
    property <float> ax2: aidx2 / adenom * 100;
    property <float> ax3: aidx3 / adenom * 100;
    property <float> ax4: aidx4 / adenom * 100;
    property <float> ax5: aidx5 / adenom * 100;
    property <float> ax6: aidx6 / adenom * 100;
    property <float> ax7: aidx7 / adenom * 100;

    property <int> blen: root.series-b.length;
    property <int> bdenom: max(1, blen - 1);
    property <int> bidx0: 0;
    property <int> bidx1: 1 < blen ? 1 : (blen > 0 ? blen - 1 : 0);
    property <int> bidx2: 2 < blen ? 2 : (blen > 0 ? blen - 1 : 0);
    property <int> bidx3: 3 < blen ? 3 : (blen > 0 ? blen - 1 : 0);
    property <int> bidx4: 4 < blen ? 4 : (blen > 0 ? blen - 1 : 0);
    property <int> bidx5: 5 < blen ? 5 : (blen > 0 ? blen - 1 : 0);
    property <int> bidx6: 6 < blen ? 6 : (blen > 0 ? blen - 1 : 0);
    property <int> bidx7: 7 < blen ? 7 : (blen > 0 ? blen - 1 : 0);
    property <float> bv0: blen > 0 ? root.series-b[bidx0] : 0;
    property <float> bv1: blen > 0 ? root.series-b[bidx1] : 0;
    property <float> bv2: blen > 0 ? root.series-b[bidx2] : 0;
    property <float> bv3: blen > 0 ? root.series-b[bidx3] : 0;
    property <float> bv4: blen > 0 ? root.series-b[bidx4] : 0;
    property <float> bv5: blen > 0 ? root.series-b[bidx5] : 0;
    property <float> bv6: blen > 0 ? root.series-b[bidx6] : 0;
    property <float> bv7: blen > 0 ? root.series-b[bidx7] : 0;
    property <float> bx0: bidx0 / bdenom * 100;
    property <float> bx1: bidx1 / bdenom * 100;
    property <float> bx2: bidx2 / bdenom * 100;
    property <float> bx3: bidx3 / bdenom * 100;
    property <float> bx4: bidx4 / bdenom * 100;
    property <float> bx5: bidx5 / bdenom * 100;
    property <float> bx6: bidx6 / bdenom * 100;
    property <float> bx7: bidx7 / bdenom * 100;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        Rectangle { vertical-stretch: 1; clip: true;
            Path {
                width: parent.width; height: parent.height;
                viewbox-width: 100; viewbox-height: 100;
                stroke: Theme.accent;
                stroke-width: 2px;
                MoveTo { x: ax0; y: (1 - av0) * 100; }
                LineTo { x: ax1; y: (1 - av1) * 100; }
                LineTo { x: ax2; y: (1 - av2) * 100; }
                LineTo { x: ax3; y: (1 - av3) * 100; }
                LineTo { x: ax4; y: (1 - av4) * 100; }
                LineTo { x: ax5; y: (1 - av5) * 100; }
                LineTo { x: ax6; y: (1 - av6) * 100; }
                LineTo { x: ax7; y: (1 - av7) * 100; }
            }
            Path {
                width: parent.width; height: parent.height;
                viewbox-width: 100; viewbox-height: 100;
                stroke: Theme.state-success;
                stroke-width: 2px;
                MoveTo { x: bx0; y: (1 - bv0) * 100; }
                LineTo { x: bx1; y: (1 - bv1) * 100; }
                LineTo { x: bx2; y: (1 - bv2) * 100; }
                LineTo { x: bx3; y: (1 - bv3) * 100; }
                LineTo { x: bx4; y: (1 - bv4) * 100; }
                LineTo { x: bx5; y: (1 - bv5) * 100; }
                LineTo { x: bx6; y: (1 - bv6) * 100; }
                LineTo { x: bx7; y: (1 - bv7) * 100; }
            }

            for pt[i] in root.series-a: Rectangle {
                x: i * (parent.width / (root.series-a.length > 1 ? root.series-a.length - 1 : 1)) - self.width / 2;
                y: parent.height - pt * parent.height - self.height / 2;
                width: 6px; height: 6px;
                border-radius: Theme.radius-full;
                background: Theme.accent;
                border-width: 2px; border-color: Theme.bg-surface;
            }
            for pt[i] in root.series-b: Rectangle {
                x: i * (parent.width / (root.series-b.length > 1 ? root.series-b.length - 1 : 1)) - self.width / 2;
                y: parent.height - pt * parent.height - self.height / 2;
                width: 6px; height: 6px;
                border-radius: Theme.radius-full;
                background: Theme.state-success;
                border-width: 2px; border-color: Theme.bg-surface;
            }
        }

        HorizontalLayout { spacing: Theme.sp-3;
            Rectangle { width: 8px; height: 8px; border-radius: Theme.radius-full; background: Theme.accent; }
            Text { text: "Series A"; color: Theme.text-tertiary; font-size: Theme.text-xs; }
            Rectangle { width: 8px; height: 8px; border-radius: Theme.radius-full; background: Theme.state-success; }
            Text { text: "Series B"; color: Theme.text-tertiary; font-size: Theme.text-xs; }
        }
    }
}
