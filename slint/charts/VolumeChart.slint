import { Theme } from "../core/Theme.slint";

export component VolumeChart inherits Rectangle {
    in property <[float]> data: [0.4, 0.7, 0.5, 0.8, 0.3, 0.6, 0.9];
    in property <string> label: "Volume Chart";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        // Same bug as BarChartVertical: `alignment: end` overrode
        // `horizontal-stretch`, collapsing every bar to 0px wide.
        HorizontalLayout { vertical-stretch: 1; spacing: 2px;
            for bar[i] in root.data: VerticalLayout { horizontal-stretch: 1; alignment: end;
                Rectangle {
                    height: bar * 100px;
                    background: Theme.accent;
                    border-radius: 1px;
                }
            }
        }
    }
}
