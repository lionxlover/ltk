import { Theme } from "../core/Theme.slint";

export component BarChartVertical inherits Rectangle {
    in property <[float]> data: [0.6, 0.8, 0.4, 0.9, 0.5];
    in property <string> label: "Bar Chart";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        HorizontalLayout { vertical-stretch: 1; spacing: Theme.sp-1; alignment: end;
            for bar[i] in root.data: Rectangle {
                horizontal-stretch: 1;
                height: bar * 100px;
                background: Theme.accent;
                border-radius: 4px;
            }
        }
    }
}
