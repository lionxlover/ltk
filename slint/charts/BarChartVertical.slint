import { Theme } from "../core/Theme.slint";

export component BarChartVertical inherits Rectangle {
    in property <[float]> data: [0.6, 0.8, 0.4, 0.9, 0.5];
    in property <string> label: "Bar Chart";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        // Bug: `alignment: end` on this HorizontalLayout overrode
        // `horizontal-stretch` — per Slint's layout docs, any alignment
        // other than the default `stretch` makes children fall back to
        // their own (here: zero, since Rectangle has no intrinsic width)
        // preferred width instead of dividing the available space. Every
        // bar collapsed to 0px wide and the whole chart rendered blank.
        // Fixed by leaving the outer layout at its default `stretch` (so
        // `horizontal-stretch: 1` actually divides the width evenly) and
        // moving the bottom-alignment into a per-bar `VerticalLayout`
        // instead — the same pattern `GroupedBarChart` already used
        // successfully.
        HorizontalLayout { vertical-stretch: 1; spacing: Theme.sp-1;
            for bar[i] in root.data: VerticalLayout { horizontal-stretch: 1; alignment: end;
                Rectangle {
                    height: bar * 100px;
                    background: Theme.accent;
                    border-radius: 4px;
                }
            }
        }
    }
}
