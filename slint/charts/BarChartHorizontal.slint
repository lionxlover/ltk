import { Theme } from "../core/Theme.slint";

export component BarChartHorizontal inherits Rectangle {
    in property <[float]> data: [0.6, 0.8, 0.4, 0.9, 0.5];
    in property <[string]> labels: [];
    in property <string> label: "Horizontal Bar Chart";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        for bar[i] in root.data: Rectangle {
            height: 24px;

            HorizontalLayout { spacing: Theme.sp-2;
                Text { text: i < root.labels.length ? root.labels[i] : ""; color: Theme.text-tertiary; font-size: Theme.text-xs; width: 60px; vertical-alignment: center; }
                Rectangle { vertical-stretch: 1;
                    Rectangle { height: 16px; y: (parent.height - self.height) / 2; width: bar * parent.width; background: Theme.accent; border-radius: Theme.radius-sm; }
                }
            }
        }
    }
}
