import { Theme } from "../core/Theme.slint";

// The "path" comments were aspirational — only floating dots were ever
// drawn, no line connected them, so the one thing a bump chart needs to
// show (rank changing over time) wasn't visible. Added real connecting
// lines via `Path`, reusing the exact same coordinate expressions as the
// existing dots (divided by `1px` to strip the unit, since Path's
// coordinate system is unitless) so the lines land exactly on the dots.
export component BumpChart inherits Rectangle {
    in property <string> label: "Bump / Ranking Chart";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        Rectangle { vertical-stretch: 1;
            // Rank lines
            for r in 4: Rectangle { x: 20px; y: 20px + r * 30px; width: parent.width - 40px; height: 1px; background: Theme.border-subtle; }

            Path {
                width: parent.width; height: parent.height;
                viewbox-width: parent.width / 1px; viewbox-height: parent.height / 1px;
                stroke: Theme.accent; stroke-width: 2px;
                MoveTo { x: 33; y: 28; }
                LineTo { x: (parent.width * 0.33) / 1px; y: 38; }
                LineTo { x: (parent.width * 0.66) / 1px; y: 31; }
                LineTo { x: (parent.width - 33px) / 1px; y: 25; }
            }
            Path {
                width: parent.width; height: parent.height;
                viewbox-width: parent.width / 1px; viewbox-height: parent.height / 1px;
                stroke: Theme.state-success; stroke-width: 2px;
                MoveTo { x: 33; y: 58; }
                LineTo { x: (parent.width * 0.33) / 1px; y: 51; }
                LineTo { x: (parent.width * 0.66) / 1px; y: 55; }
                LineTo { x: (parent.width - 33px) / 1px; y: 48; }
            }
            Path {
                width: parent.width; height: parent.height;
                viewbox-width: parent.width / 1px; viewbox-height: parent.height / 1px;
                stroke: Theme.state-warning; stroke-width: 2px;
                MoveTo { x: 33; y: 88; }
                LineTo { x: (parent.width * 0.33) / 1px; y: 81; }
                LineTo { x: (parent.width * 0.66) / 1px; y: 85; }
                LineTo { x: (parent.width - 33px) / 1px; y: 78; }
            }

            // Team A path
            Rectangle { x: 30px; y: 25px; width: 6px; height: 6px; border-radius: Theme.radius-full; background: Theme.accent; }
            Rectangle { x: parent.width * 0.33; y: 35px; width: 6px; height: 6px; border-radius: Theme.radius-full; background: Theme.accent; }
            Rectangle { x: parent.width * 0.66; y: 28px; width: 6px; height: 6px; border-radius: Theme.radius-full; background: Theme.accent; }
            Rectangle { x: parent.width - 36px; y: 22px; width: 6px; height: 6px; border-radius: Theme.radius-full; background: Theme.accent; }

            // Team B path
            Rectangle { x: 30px; y: 55px; width: 6px; height: 6px; border-radius: Theme.radius-full; background: Theme.state-success; }
            Rectangle { x: parent.width * 0.33; y: 48px; width: 6px; height: 6px; border-radius: Theme.radius-full; background: Theme.state-success; }
            Rectangle { x: parent.width * 0.66; y: 52px; width: 6px; height: 6px; border-radius: Theme.radius-full; background: Theme.state-success; }
            Rectangle { x: parent.width - 36px; y: 45px; width: 6px; height: 6px; border-radius: Theme.radius-full; background: Theme.state-success; }

            // Team C path
            Rectangle { x: 30px; y: 85px; width: 6px; height: 6px; border-radius: Theme.radius-full; background: Theme.state-warning; }
            Rectangle { x: parent.width * 0.33; y: 78px; width: 6px; height: 6px; border-radius: Theme.radius-full; background: Theme.state-warning; }
            Rectangle { x: parent.width * 0.66; y: 82px; width: 6px; height: 6px; border-radius: Theme.radius-full; background: Theme.state-warning; }
            Rectangle { x: parent.width - 36px; y: 75px; width: 6px; height: 6px; border-radius: Theme.radius-full; background: Theme.state-warning; }
        }
    }
}

