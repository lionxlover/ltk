import { Theme } from "../core/Theme.slint";

// Bug: all three rings were the same size at the exact same position —
// with matching border-width they occupy identical pixels, so only the
// last (state-warning) ring was visible; the other two were completely
// hidden underneath it. Offset them like a Venn diagram so all three
// show, which also reads more like a chord/relationship diagram.
export component ChordDiagram inherits Rectangle {
    in property <string> label: "Chord Diagram";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        Rectangle { vertical-stretch: 1;
            Rectangle {
                width: 100px; height: 100px;
                x: (parent.width - self.width) / 2 - 30px; y: (parent.height - self.height) / 2 - 15px;
                border-radius: Theme.radius-full;
                border-width: 14px;
                border-color: Theme.accent.with-alpha(0.7);
                background: transparent;
            }
            Rectangle {
                width: 100px; height: 100px;
                x: (parent.width - self.width) / 2 + 30px; y: (parent.height - self.height) / 2 - 15px;
                border-radius: Theme.radius-full;
                border-width: 14px;
                border-color: Theme.state-success.with-alpha(0.7);
                background: transparent;
            }
            Rectangle {
                width: 100px; height: 100px;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2 + 30px;
                border-radius: Theme.radius-full;
                border-width: 14px;
                border-color: Theme.state-warning.with-alpha(0.7);
                background: transparent;
            }
        }
    }
}

