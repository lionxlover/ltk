import { Theme } from "../core/Theme.slint";

export component StackedBarChart inherits Rectangle {
    in property <[float]> series-a: [0.3, 0.4, 0.2];
    in property <[float]> series-b: [0.2, 0.3, 0.4];
    in property <string> label: "Stacked Bar Chart";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        HorizontalLayout { vertical-stretch: 1; spacing: Theme.sp-2; alignment: center;
            for bar[i] in root.series-a: Rectangle { horizontal-stretch: 1;
                VerticalLayout { alignment: end;
                    Rectangle { height: (i < root.series-b.length ? root.series-b[i] : 0) * 100px; background: Theme.state-success; border-radius: 2px; }
                    Rectangle { height: bar * 100px; background: Theme.accent; border-radius: 2px; }
                }
            }
        }
    }
}
