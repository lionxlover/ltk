import { Theme } from "../core/Theme.slint";

export component ChoroplethMap inherits Rectangle {
    in property <string> label: "Choropleth / Geo Map";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        Rectangle { vertical-stretch: 1; background: Theme.bg-overlay; border-radius: Theme.radius-sm;
            Rectangle { x: 20px; y: 20px; width: 60px; height: 40px; background: Theme.accent-subtle; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.accent; }
            Rectangle { x: 90px; y: 15px; width: 50px; height: 50px; background: Theme.green_100; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.state-success; }
            Rectangle { x: 150px; y: 25px; width: 70px; height: 35px; background: Theme.amber_100; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.state-warning; }
            Rectangle { x: 60px; y: 70px; width: 80px; height: 30px; background: Theme.red_100; border-radius: Theme.radius-sm; border-width: 1px; border-color: Theme.state-error; }
        }
    }
}
