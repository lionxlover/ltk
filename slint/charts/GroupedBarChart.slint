import { Theme } from "../core/Theme.slint";

// Bug: referenced `root.series_b` (underscore) — a compile error, since
// the declared property is `series-b` (kebab-case; Slint identifiers use
// dashes, not underscores, and the two are not the same identifier).
export component GroupedBarChart inherits Rectangle {
    in property <[float]> series-a: [0.6, 0.8, 0.4];
    in property <[float]> series-b: [0.4, 0.5, 0.7];
    in property <string> label: "Grouped Bar Chart";

    background: Theme.bg-surface;
    border-radius: Theme.radius-md;
    border-width: 1px;
    border-color: Theme.border-subtle;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        Text { text: root.label; color: Theme.text-secondary; font-size: Theme.text-xs; font-weight: Theme.weight-semibold; }

        HorizontalLayout { vertical-stretch: 1; spacing: Theme.sp-4; alignment: center;
            for bar[i] in root.series-a: HorizontalLayout { spacing: 2px; alignment: start;
                Rectangle { width: 16px; VerticalLayout { alignment: end; Rectangle { height: bar * 100px; background: Theme.accent; border-radius: 2px; } } }
                Rectangle { width: 16px; VerticalLayout { alignment: end; Rectangle { height: (i < root.series-b.length ? root.series-b[i] : 0) * 100px; background: Theme.state-success; border-radius: 2px; } } }
            }
        }
    }
}
