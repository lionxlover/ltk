// LTKBadge — notification dot / count badge.
// Positions as overlay on its parent (top-right corner, macOS style).

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKRadius }  from "../theme/radius.slint";

export component LTKBadge inherits Rectangle {
    in property <string>  count;     // empty = dot only
    in property <color>   color:     LTKPalette.state-error;
    in property <bool>    visible:   true;
    in property <bool>    outlined:  false;

    visible: root.visible;
    height: root.count == "" ? 8px : 18px;
    width:  root.count == "" ? 8px : max(18px, badge-t.preferred-width + 8px);
    border-radius: LTKRadius.badge;
    background: root.color;
    border-width: root.outlined ? 2px : 0px;
    border-color: LTKPalette.bg-surface;

    if root.count != "" : badge-t := Text {
        text: root.count;
        color: #FFFFFF;
        font-family: LTKType.font-ui;
        font-size: LTKType.text-xs;
        font-weight: LTKType.weight-bold;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
