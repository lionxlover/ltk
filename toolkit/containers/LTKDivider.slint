// LTKDivider — horizontal or vertical separator line.
// Matches both macOS separator colour and GNOME separator.

import { LTKPalette } from "../theme/palette.slint";

export component LTKDivider inherits Rectangle {
    in property <bool>   vertical:  false;
    in property <color>  color:     LTKPalette.border-subtle;
    in property <length> thickness: 1px;

    width:  root.vertical ? root.thickness : parent.width;
    height: root.vertical ? parent.height  : root.thickness;
    background: root.color;
}
