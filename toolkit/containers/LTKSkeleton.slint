// LTKSkeleton — shimmer loading placeholder.
// macOS: pulsing opacity. GNOME: linear shimmer sweep.

import { LTKPalette } from "../theme/palette.slint";
import { LTKRadius }  from "../theme/radius.slint";

export component LTKSkeleton inherits Rectangle {
    in property <length>  skel-radius: LTKRadius.sm;
    in property <bool>    circle:      false;
    in property <bool>    text-line:   false;

    border-radius: root.circle ? min(parent.width, parent.height) / 2
                 : root.skel-radius;
    background: LTKPalette.border-base;
    clip: true;

    // Shimmer sweep overlay
    Rectangle {
        width: parent.width * 0.6;
        height: parent.height;
        border-radius: parent.border-radius;
        background: @linear-gradient(90deg, transparent 0%, LTKPalette.border-strong 50%, transparent 100%);
        // Animate x from -width to parent.width
        x: mod(animation-tick() / 3ms, parent.width + self.width) - self.width;
        opacity: 0.6;
    }
}

// Pre-composed skeleton card
export component LTKSkeletonCard inherits Rectangle {
    in property <bool> with-avatar: true;

    border-radius: 12px;
    background: LTKPalette.bg-surface;
    border-width: 1px;
    border-color: LTKPalette.border-subtle;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        if root.with-avatar : HorizontalLayout {
            spacing: 12px;
            alignment: center;
            LTKSkeleton { width: 36px; height: 36px; circle: true; }
            VerticalLayout {
                spacing: 6px;
                LTKSkeleton { width: 120px; height: 13px; }
                LTKSkeleton { width: 80px;  height: 11px; }
            }
        }

        LTKSkeleton { width: parent.width - 32px; height: 13px; }
        LTKSkeleton { width: (parent.width - 32px) * 0.8; height: 13px; }
        LTKSkeleton { width: (parent.width - 32px) * 0.6; height: 13px; }
    }
}
