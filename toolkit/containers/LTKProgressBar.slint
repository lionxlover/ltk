// LTKProgressBar — macOS NSProgressIndicator (determinate) + GNOME ProgressBar.
// Accent-coloured fill, animated shimmer on indeterminate mode.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LTKMotion }  from "../theme/motion.slint";

export component LTKProgressBar inherits Rectangle {
    in property <float>  value:        0.0;   // 0.0–1.0
    in property <bool>   indeterminate:false;
    in property <string> label;
    in property <bool>   show-percent: false;
    in property <color>  track-color:  LTKPalette.accent;
    in property <length> bar-height:   6px;

    min-width: 120px;
    height: root.label != "" || root.show-percent
        ? LTKType.text-sm + root.bar-height + LTKSpace.px4
        : root.bar-height;
    background: transparent;

    VerticalLayout {
        spacing: LTKSpace.px4;
        alignment: center;

        if root.label != "" || root.show-percent : HorizontalLayout {
            if root.label != "" : Text {
                text: root.label;
                color: LTKPalette.text-secondary;
                font-family: LTKType.font-ui;
                font-size: LTKType.text-xs;
                font-weight: LTKType.weight-medium;
                horizontal-stretch: 1;
            }
            if root.show-percent && !root.indeterminate : Text {
                text: round(root.value * 100) + "%";
                color: LTKPalette.text-tertiary;
                font-family: LTKType.font-mono;
                font-size: LTKType.text-xs;
            }
        }

        // Track
        Rectangle {
            height: root.bar-height;
            border-radius: root.bar-height / 2;
            background: root.track-color.with-alpha(0.15);
            clip: true;

            // Fill
            if !root.indeterminate : Rectangle {
                x: 0px;
                width: parent.width * clamp(root.value, 0.0, 1.0);
                height: parent.height;
                border-radius: parent.height / 2;
                background: root.track-color;
                animate width { duration: LTKMotion.base; easing: LTKMotion.ease-soft; }
            }

            // Indeterminate shimmer stripe
            if root.indeterminate : Rectangle {
                width: parent.width * 0.35;
                height: parent.height;
                border-radius: parent.height / 2;
                background: root.track-color;
                // Animated by the runtime — position loops 0→parent.width
                x: mod(animation-tick() / 4ms, parent.width + self.width) - self.width;
            }
        }
    }
}
