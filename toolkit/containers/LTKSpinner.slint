// LTKSpinner — macOS NSProgressIndicator (spinning) / GNOME Spinner.
// Pulsing arc on a dark ring. Sizes: sm/md/lg.

import { LTKPalette } from "../theme/palette.slint";
import { LTKMotion }  from "../theme/motion.slint";

export component LTKSpinner inherits Rectangle {
    in property <length>  size:    24px;
    in property <color>   color:   LTKPalette.accent;
    in property <bool>    visible: true;

    width: root.size; height: root.size;
    background: transparent;

    if root.visible : Rectangle {
        width: root.size; height: root.size;
        border-radius: root.size / 2;
        border-width: root.size * 0.1;
        border-color: root.color.with-alpha(0.20);

        // Animated arc (approximated via rotation of a partial circle overlay)
        Rectangle {
            width: root.size; height: root.size;
            border-radius: root.size / 2;
            border-width: root.size * 0.10;
            border-top-color: root.color;
            border-right-color: root.color.with-alpha(0.0);
            border-bottom-color: root.color.with-alpha(0.0);
            border-left-color: root.color.with-alpha(0.0);
            rotation-angle: mod(animation-tick() / 3ms, 360deg);
        }
    }
}
