// LTKEmptyState — GNOME-style empty / zero-data view.
// Centred icon, headline, body text, optional action button.
// Used in list views, file browsers, search results.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";

export component LTKEmptyState inherits Rectangle {
    in property <image>  icon;
    in property <string> headline;
    in property <string> body;
    in property <string> action-label;
    callback action-clicked();

    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: LTKSpace.space-2;
        padding: LTKSpace.space-8;

        Image {
            source: root.icon;
            width: 72px; height: 72px;
            colorize: LTKPalette.text-tertiary;
            opacity: 0.50;
            horizontal-alignment: center;
        }

        Text {
            text: root.headline;
            color: LTKPalette.text-primary;
            font-family: LTKType.font-display;
            font-size: LTKType.title-3;
            font-weight: LTKType.weight-semibold;
            horizontal-alignment: center;
        }

        if root.body != "" : Text {
            text: root.body;
            color: LTKPalette.text-secondary;
            font-family: LTKType.font-body;
            font-size: LTKType.callout;
            horizontal-alignment: center;
        }

        if root.action-label != "" : Rectangle {
            height: LTKSpace.space-3; background: transparent;
        }

        if root.action-label != "" : Rectangle {
            horizontal-alignment: center;
            width: min(240px, parent.width);
            // Primary button styled inline to avoid circular import
            height: 36px;
            border-radius: 9999px;
            background: LTKPalette.accent;
            Text {
                text: root.action-label;
                color: LTKPalette.on-accent;
                font-family: LTKType.font-ui;
                font-size: LTKType.text-sm;
                font-weight: LTKType.weight-semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { mouse-cursor: pointer; clicked => { root.action-clicked(); } }
        }
    }
}
