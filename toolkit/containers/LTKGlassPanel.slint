// LTKGlassPanel — macOS vibrancy frosted glass panel.
// Used for sidebars, floating palettes, popovers, toolbars.
// Three blur levels: thin / regular / thick (matches macOS vibrancy materials).

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LTKMotion }  from "../theme/motion.slint";

export enum LTKGlassTier { Thin, Regular, Thick }

export component LTKGlassPanel inherits Rectangle {
    in property <string>       title;
    in property <LTKGlassTier> tier:       LTKGlassTier.Regular;
    in property <bool>         show-title: true;
    in property <bool>         bordered:   true;
    in property <length>       panel-radius: LTKRadius.lg;
    in property <length>       pad:          LTKSpace.space-4;

    border-radius: root.panel-radius;
    border-width: root.bordered ? 1px : 0px;
    border-color: LTKPalette.border-subtle;
    clip: true;

    background:
        root.tier == LTKGlassTier.Thin    ? LTKPalette.glass-thin
      : root.tier == LTKGlassTier.Thick   ? LTKPalette.glass-thick
      : LTKPalette.glass-regular;

    // Subtle top specular highlight (macOS glass edge)
    Rectangle {
        y: 0px; height: 1px; width: parent.width;
        background: LTKPalette.border-base;
    }

    VerticalLayout {
        spacing: 0px;

        if root.show-title && root.title != "" : Rectangle {
            height: 38px;
            background: LTKPalette.border-subtle;
            HorizontalLayout {
                padding-left:  root.pad;
                padding-right: root.pad;
                alignment: center;
                Text {
                    text: root.title;
                    color: LTKPalette.text-secondary;
                    font-family: LTKType.font-ui;
                    font-size: LTKType.text-sm;
                    font-weight: LTKType.weight-semibold;
                    letter-spacing: 0.4px;
                }
            }
            Rectangle {
                y: parent.height - 1px; height: 1px; width: parent.width;
                background: LTKPalette.border-subtle;
            }
        }

        Rectangle {
            padding: root.pad;
            @children
        }
    }
}
