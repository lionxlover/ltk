// LTKCard — macOS NSBox / GNOME AdwActionRow inspired card.
// Three material variants: filled, glass, outlined.
// Hover: shadow lift with spring (macOS interactive card feel).

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LTKMotion }  from "../theme/motion.slint";
import { LTKShadow }  from "../theme/shadows.slint";

export enum LTKCardMaterial { Filled, Glass, Outlined }

export component LTKCard inherits Rectangle {
    in property <string>          title;
    in property <string>          subtitle;
    in property <LTKCardMaterial> material:    LTKCardMaterial.Filled;
    in property <bool>            interactive: false;
    in property <bool>            selected:    false;
    in property <length>          pad:         LTKSpace.space-4;
    callback clicked();

    border-radius: LTKRadius.card;
    border-width: 1px;
    clip: true;

    // Material-specific backgrounds
    background:
        root.selected ? LTKPalette.accent.with-alpha(0.10)
      : root.material == LTKCardMaterial.Glass    ? LTKPalette.glass-regular
      : root.material == LTKCardMaterial.Outlined ? transparent
      : LTKPalette.bg-surface;

    border-color:
        root.selected         ? LTKPalette.accent.with-alpha(0.55)
      : root.material == LTKCardMaterial.Outlined ? LTKPalette.border-base
      : LTKPalette.border-subtle;

    // macOS shadow lift on hover
    drop-shadow-blur:
        root.interactive && touch.has-hover && !touch.pressed ? LTKShadow.blur-md
      : root.material == LTKCardMaterial.Filled               ? LTKShadow.blur-xs
      : 0px;
    drop-shadow-offset-y:
        root.interactive && touch.has-hover && !touch.pressed ? LTKShadow.offset-md
      : LTKShadow.offset-xs;
    drop-shadow-color: LTKPalette.shadow-sm;

    // Spring press sink
    y: root.interactive && touch.pressed ? 1px : 0px;

    animate background       { duration: LTKMotion.fast; easing: LTKMotion.ease-decelerate; }
    animate border-color     { duration: LTKMotion.fast; }
    animate drop-shadow-blur { duration: LTKMotion.base; easing: LTKMotion.ease-soft; }
    animate y                { duration: 80ms; easing: LTKMotion.ease-spring; }

    VerticalLayout {
        padding: root.pad;
        spacing: LTKSpace.px4;

        if root.title != "" : Text {
            text: root.title;
            color: LTKPalette.text-primary;
            font-family: LTKType.font-display;
            font-size: LTKType.title-3;
            font-weight: LTKType.weight-semibold;
        }
        if root.subtitle != "" : Text {
            text: root.subtitle;
            color: LTKPalette.text-secondary;
            font-family: LTKType.font-body;
            font-size: LTKType.callout;
        }
        @children
    }

    touch := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
