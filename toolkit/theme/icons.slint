// LTK Icons — SF Symbols-inspired naming, SVG-backed.
// All icons are image properties pointing to SVG files.
// Replace with your icon set SVG paths.

export global LTKIcons {
    // ── Window controls ────────────────────────────────────────────────
    out property <image> close:      @image-url("../icons/x.svg");
    out property <image> minimize:   @image-url("../icons/minus.svg");
    out property <image> maximize:   @image-url("../icons/square.svg");
    out property <image> fullscreen: @image-url("../icons/expand.svg");

    // ── Navigation ─────────────────────────────────────────────────────
    out property <image> back:           @image-url("../icons/chevron-left.svg");
    out property <image> forward:        @image-url("../icons/chevron-right.svg");
    out property <image> up:             @image-url("../icons/chevron-up.svg");
    out property <image> down:           @image-url("../icons/chevron-down.svg");
    out property <image> sidebar:        @image-url("../icons/panel-left.svg");
    out property <image> home:           @image-url("../icons/home.svg");
    out property <image> settings:       @image-url("../icons/settings.svg");

    // ── Actions ────────────────────────────────────────────────────────
    out property <image> add:         @image-url("../icons/plus.svg");
    out property <image> remove:      @image-url("../icons/minus.svg");
    out property <image> edit:        @image-url("../icons/pencil.svg");
    out property <image> trash:       @image-url("../icons/trash.svg");
    out property <image> copy:        @image-url("../icons/copy.svg");
    out property <image> cut:         @image-url("../icons/scissors.svg");
    out property <image> paste:       @image-url("../icons/clipboard.svg");
    out property <image> share:       @image-url("../icons/share.svg");
    out property <image> download:    @image-url("../icons/download.svg");
    out property <image> upload:      @image-url("../icons/upload.svg");
    out property <image> search:      @image-url("../icons/search.svg");
    out property <image> filter:      @image-url("../icons/filter.svg");
    out property <image> sort:        @image-url("../icons/arrow-up-down.svg");
    out property <image> refresh:     @image-url("../icons/refresh.svg");
    out property <image> undo:        @image-url("../icons/undo.svg");
    out property <image> redo:        @image-url("../icons/redo.svg");
    out property <image> check:       @image-url("../icons/check.svg");
    out property <image> x:           @image-url("../icons/x.svg");
    out property <image> more:        @image-url("../icons/more-horizontal.svg");
    out property <image> more-vert:   @image-url("../icons/more-vertical.svg");
    out property <image> menu:        @image-url("../icons/menu.svg");

    // ── Files ──────────────────────────────────────────────────────────
    out property <image> file:        @image-url("../icons/file.svg");
    out property <image> folder:      @image-url("../icons/folder.svg");
    out property <image> folder-open: @image-url("../icons/folder-open.svg");
    out property <image> image:       @image-url("../icons/image.svg");
    out property <image> video:       @image-url("../icons/video.svg");
    out property <image> audio:       @image-url("../icons/music.svg");
    out property <image> document:    @image-url("../icons/file-text.svg");
    out property <image> archive:     @image-url("../icons/archive.svg");
    out property <image> code:        @image-url("../icons/code.svg");

    // ── System ─────────────────────────────────────────────────────────
    out property <image> wifi:        @image-url("../icons/wifi.svg");
    out property <image> network:     @image-url("../icons/globe.svg");
    out property <image> bluetooth:   @image-url("../icons/bluetooth.svg");
    out property <image> battery:     @image-url("../icons/battery.svg");
    out property <image> volume:      @image-url("../icons/volume.svg");
    out property <image> volume-mute: @image-url("../icons/volume-x.svg");
    out property <image> brightness:  @image-url("../icons/sun.svg");
    out property <image> moon:        @image-url("../icons/moon.svg");
    out property <image> lock:        @image-url("../icons/lock.svg");
    out property <image> unlock:      @image-url("../icons/unlock.svg");
    out property <image> eye:         @image-url("../icons/eye.svg");
    out property <image> eye-off:     @image-url("../icons/eye-off.svg");
    out property <image> bell:        @image-url("../icons/bell.svg");
    out property <image> bell-off:    @image-url("../icons/bell-off.svg");
    out property <image> info:        @image-url("../icons/info.svg");
    out property <image> warning:     @image-url("../icons/alert-triangle.svg");
    out property <image> error:       @image-url("../icons/alert-circle.svg");
    out property <image> help:        @image-url("../icons/help-circle.svg");
    out property <image> star:        @image-url("../icons/star.svg");
    out property <image> heart:       @image-url("../icons/heart.svg");
    out property <image> tag:         @image-url("../icons/tag.svg");
    out property <image> user:        @image-url("../icons/user.svg");
    out property <image> users:       @image-url("../icons/users.svg");
    out property <image> mail:        @image-url("../icons/mail.svg");
    out property <image> calendar:    @image-url("../icons/calendar.svg");
    out property <image> clock:       @image-url("../icons/clock.svg");
    out property <image> map-pin:     @image-url("../icons/map-pin.svg");
    out property <image> cpu:         @image-url("../icons/cpu.svg");
    out property <image> memory:      @image-url("../icons/server.svg");
    out property <image> terminal:    @image-url("../icons/terminal.svg");
    out property <image> key:         @image-url("../icons/key.svg");
    out property <image> link:        @image-url("../icons/link.svg");

    // ── Media ──────────────────────────────────────────────────────────
    out property <image> play:        @image-url("../icons/play.svg");
    out property <image> pause:       @image-url("../icons/pause.svg");
    out property <image> stop:        @image-url("../icons/square.svg");
    out property <image> skip-back:   @image-url("../icons/skip-back.svg");
    out property <image> skip-forward:@image-url("../icons/skip-forward.svg");
    out property <image> shuffle:     @image-url("../icons/shuffle.svg");
    out property <image> repeat:      @image-url("../icons/repeat.svg");
    out property <image> mic:         @image-url("../icons/mic.svg");
    out property <image> camera:      @image-url("../icons/camera.svg");
}
