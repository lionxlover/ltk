// LeonuxTokens — Leonux design philosophy globals.
// Radius hierarchy (5-tier) + Spacing scale (8px grid).
// Import this alongside LTKPalette, LTKType, etc.

export global LeonuxRadius {
    // ── 5-tier named radius hierarchy ────────────────────────────────
    //
    //   Primary   (r1)  24px — windows, large modals, onboarding
    //   Secondary (r2)  16px — cards, panels, bottom sheets, popovers
    //   Tertiary  (r3)  10px — buttons, inputs, menus
    //   Quaternary(r4)   6px — tags, chips, badges, selection rings
    //   Quinary   (r5)   3px — innermost, dense list items
    //   Full            9999px — pills, toggles, avatars
    //
    // Nested box rule: inner_radius = outer_radius - gap
    //
    //   Box 1 (window)   ← r1 = 24px, gap = 8px
    //   Box 2 (card)     ← r2 = 16px, gap = 6px
    //   Box 3 (panel)    ← r3 = 10px, gap = 4px
    //   Box 4 (chip)     ← r4 =  6px

    out property <length> r1:         24px;   // Primary
    out property <length> r2:         16px;   // Secondary
    out property <length> r3:         10px;   // Tertiary
    out property <length> r4:          6px;   // Quaternary
    out property <length> r5:          3px;   // Quinary
    out property <length> full:      9999px;  // Pill / circle

    // Semantic aliases
    out property <length> window:     24px;   // r1 — app window, fullscreen overlay
    out property <length> modal:      16px;   // r2 — dialog, sheet
    out property <length> card:       16px;   // r2 — card, panel
    out property <length> popover:    14px;   // r2-minus — contextual popup
    out property <length> menu:       10px;   // r3 — dropdown menu
    out property <length> button:   9999px;   // full — always pill
    out property <length> input:       6px;   // r4 — text field, textarea
    out property <length> badge:    9999px;   // full — count badge
    out property <length> chip:     9999px;   // full — filter chip
    out property <length> tag:         3px;   // r5 — category tag
    out property <length> toggle:   9999px;   // full — switch
    out property <length> avatar-circle: 9999px;
    out property <length> avatar-squircle: 27%; // ~27% of size = macOS icon shape
}

export global LeonuxSpace {
    // ── 8px base grid ────────────────────────────────────────────────
    //   Every step = 4px × n.
    //   Half-steps (4px, 12px) for tight internal padding only.
    //   Never use odd values.
    //
    //   micro  4px  — icon–label gap, badge padding, hairline insets
    //   xs     8px  — tight field padding, dense list row
    //   sm    12px  — form field internal padding
    //   md    16px  — standard gap between elements  ← BASE UNIT × 2
    //   lg    24px  — section spacing
    //   xl    32px  — view-level padding
    //   xl2   48px  — hero / feature sections
    //   xl3   64px  — full-page padding on wide screens

    out property <length> micro:   4px;
    out property <length> xs:      8px;
    out property <length> sm:     12px;
    out property <length> md:     16px;
    out property <length> lg:     24px;
    out property <length> xl:     32px;
    out property <length> xl2:    48px;
    out property <length> xl3:    64px;

    // Component-specific heights
    out property <length> control-sm:   24px;
    out property <length> control-md:   32px;
    out property <length> control-lg:   40px;
    out property <length> input-sm:     28px;
    out property <length> input-md:     36px;
    out property <length> input-lg:     44px;
    out property <length> headerbar:    47px;
    out property <length> titlebar:     38px;
    out property <length> toolbar:      40px;
    out property <length> statusbar:    24px;
    out property <length> sidebar:     260px;
    out property <length> nav-rail:     72px;
    out property <length> inspector:   280px;

    // Traffic light metrics
    out property <length> traffic:      12px;  // dot diameter
    out property <length> traffic-gap:   8px;  // gap between dots
    out property <length> traffic-margin:14px; // left edge margin

    // Nested padding (matches radius rule: gap = r_outer - r_inner)
    out property <length> nest-1-to-2:  8px;   // window → card gap
    out property <length> nest-2-to-3:  6px;   // card → panel gap
    out property <length> nest-3-to-4:  4px;   // panel → chip gap
}
