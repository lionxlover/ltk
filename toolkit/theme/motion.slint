// LTK Motion — Spring-first. Cubic-bezier only for opacity and page transitions.
// Based on macOS spring animation model + GNOME reduce-motion support.

export global LTKMotion {
    in-out property <bool> reduce-motion: false;

    // ── Spring presets (mass=1, vary stiffness+damping) ────────────────
    // micro   : checkbox, radio, toggle knob
    // standard: buttons, menus, panels
    // bouncy  : FAB, onboarding, delight
    // gentle  : sheet entrances, drawer slides
    // stiff   : drag snapping, resize handles
    //
    // Slint spring easing: cubic-bezier(0.34, 1.56, 0.64, 1) approximates standard
    // Actual RK4 spring lives in ltk-animation::spring::SpringSim

    // ── Duration scale (fallback when spring has settled estimate) ──────
    out property <duration> dur-instant:   0ms;
    out property <duration> dur-micro:    50ms;   // micro-interaction
    out property <duration> dur-fast:    130ms;   // hover, press feedback
    out property <duration> dur-base:    220ms;   // standard transition
    out property <duration> dur-medium:  320ms;   // panels, menus opening
    out property <duration> dur-slow:    480ms;   // page transitions
    out property <duration> dur-gentle:  640ms;   // sheet, drawer entrances
    out property <duration> dur-spring:  400ms;   // spring settle estimate

    // Reduce-motion overrides — all become 0ms
    out property <duration> fast:   reduce-motion ? 0ms : dur-fast;
    out property <duration> base:   reduce-motion ? 0ms : dur-base;
    out property <duration> medium: reduce-motion ? 0ms : dur-medium;
    out property <duration> slow:   reduce-motion ? 0ms : dur-slow;
    out property <duration> spring: reduce-motion ? 0ms : dur-spring;

    // ── Easing curves ─────────────────────────────────────────────────
    // Spring approximation (slight overshoot, natural settle)
    out property <easing> ease-spring:     cubic-bezier(0.34, 1.56, 0.64, 1.0);
    // Soft spring (no overshoot, smooth decelerate — GNOME preference)
    out property <easing> ease-soft:       cubic-bezier(0.16, 1.00, 0.30, 1.0);
    // macOS decelerate (ease-out equivalent but smoother)
    out property <easing> ease-decelerate: cubic-bezier(0.00, 0.00, 0.20, 1.0);
    // macOS accelerate (ease-in equivalent)
    out property <easing> ease-accelerate: cubic-bezier(0.40, 0.00, 1.00, 1.0);
    // Material / GNOME standard
    out property <easing> ease-standard:   cubic-bezier(0.40, 0.00, 0.20, 1.0);
    // Snap (decisive, quick settle)
    out property <easing> ease-snap:       cubic-bezier(0.50, 0.00, 0.10, 1.0);
    // Page transitions (ease-in-out, slow-in slow-out)
    out property <easing> ease-page:       cubic-bezier(0.42, 0.00, 0.58, 1.0);
    // Linear (progress bars, skeletons)
    out property <easing> ease-linear:     linear;
}
