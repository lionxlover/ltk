// LTK Shadows — macOS elevation model.
// macOS uses large, soft, low-opacity shadows for depth.
// GNOME uses minimal shadows, relying on borders for separation.
// LionOS defaults to the macOS approach in dark mode, GNOME in light mode.

import { LTKPalette } from "palette.slint";

export global LTKShadow {
    // ── Named elevation levels ─────────────────────────────────────────
    // Blur, offset-y, color (applied via drop-shadow in Slint components)
    // xs  — subtle card lift (GNOME card)
    // sm  — button hover (macOS button default)
    // md  — menus, popovers (macOS menu shadow)
    // lg  — modals, sheets (macOS panel shadow)
    // xl  — app window (macOS window shadow)

    out property <length> blur-xs:   4px;
    out property <length> blur-sm:   8px;
    out property <length> blur-md:  16px;
    out property <length> blur-lg:  32px;
    out property <length> blur-xl:  56px;
    out property <length> blur-2xl: 80px;

    out property <length> offset-xs:  1px;
    out property <length> offset-sm:  2px;
    out property <length> offset-md:  4px;
    out property <length> offset-lg:  8px;
    out property <length> offset-xl: 16px;

    // Spread (macOS uses slight negative spread for natural look)
    out property <length> spread-base:  0px;
    out property <length> spread-inset: -2px;

    // Shadow tint (coloured shadows for glass panels)
    out property <color> window-shadow-color: #00000099;
}
