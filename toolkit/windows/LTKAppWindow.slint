// LTKAppWindow — Full LionOS application window shell.
//
// Provides:
//  - Custom no-frame window with glass background
//  - LTKHeaderBar with traffic lights
//  - Optional sidebar slot (GNOME NavigationSplitView pattern)
//  - Content area slot
//  - Optional bottom bar slot
//  - Adaptive layout (sidebar collapses on narrow windows)

import { LTKPalette }   from "../theme/palette.slint";
import { LTKType }      from "../theme/typography.slint";
import { LTKSpace }     from "../theme/spacing.slint";
import { LTKMotion }    from "../theme/motion.slint";
import { LTKRadius }    from "../theme/radius.slint";
import { LTKHeaderBar } from "LTKHeaderBar.slint";

export component LTKAppWindow inherits Window {
    // ── Window properties ──────────────────────────────────────────────
    in property <string>  app-title:       "LionOS App";
    in property <string>  app-subtitle;
    in property <bool>    show-sidebar:    true;
    in property <bool>    sidebar-open:    true;
    in property <length>  sidebar-width:   LTKSpace.sidebar-width;
    in property <bool>    show-headerbar:  true;
    in property <bool>    show-bottom-bar: false;
    in property <bool>    adaptive:        true;    // collapse sidebar when narrow

    callback close-requested();
    callback minimize-requested();
    callback zoom-requested();
    callback menu-requested();
    callback sidebar-toggled(open: bool);

    // ── Window config ──────────────────────────────────────────────────
    no-frame: true;
    background: LTKPalette.bg-base;
    default-font-family: LTKType.font-ui;
    default-font-size: LTKType.text-base;
    min-width: 360px;
    min-height: 240px;

    // Adaptive breakpoint: collapse sidebar below 720px
    property <bool> sidebar-collapsed: root.adaptive && root.width < 720px;
    property <bool> effective-sidebar: root.show-sidebar && root.sidebar-open && !root.sidebar-collapsed;

    VerticalLayout {
        spacing: 0px;

        // ── Header bar ─────────────────────────────────────────────────
        if root.show-headerbar : LTKHeaderBar {
            title: root.app-title;
            subtitle: root.app-subtitle;
            close-requested    => { root.close-requested(); }
            minimize-requested => { root.minimize-requested(); }
            zoom-requested     => { root.zoom-requested(); }
            menu-requested     => { root.menu-requested(); }
        }

        // ── Main area (sidebar + content) ──────────────────────────────
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // Sidebar slot (persistent on wide, overlay on narrow)
            if root.effective-sidebar : Rectangle {
                width: root.sidebar-width;
                background: LTKPalette.bg-sidebar;
                clip: true;

                // Right border separator
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px; height: parent.height;
                    background: LTKPalette.border-subtle;
                }

                // Sidebar content injected by host
                @children  // first child = sidebar
            }

            // Sidebar overlay on narrow screens
            if root.show-sidebar && root.sidebar-open && root.sidebar-collapsed : Rectangle {
                x: 0px; y: 0px;
                width: parent.width; height: parent.height;
                background: LTKPalette.shadow-xl;
                z: 100;

                // Tap outside to close
                TouchArea {
                    clicked => {
                        root.sidebar-open = false;
                        root.sidebar-toggled(false);
                    }
                }

                Rectangle {
                    x: 0px;
                    width: root.sidebar-width;
                    height: parent.height;
                    background: LTKPalette.bg-sidebar;
                    drop-shadow-blur:    24px;
                    drop-shadow-offset-x: 4px;
                    drop-shadow-color:   LTKPalette.shadow-lg;
                    clip: true;
                    animate x { duration: LTKMotion.medium; easing: LTKMotion.ease-decelerate; }

                    @children  // overlay sidebar content
                }
            }

            // ── Content area ───────────────────────────────────────────
            Rectangle {
                horizontal-stretch: 1;
                background: LTKPalette.bg-base;
                clip: true;
                // Host places main content here (second @children slot)
            }
        }

        // ── Bottom bar (toolbar / tab bar) ─────────────────────────────
        if root.show-bottom-bar : Rectangle {
            height: LTKSpace.toolbar-height;
            background: LTKPalette.glass-thick;

            Rectangle {
                y: 0px; height: 1px; width: parent.width;
                background: LTKPalette.border-subtle;
            }
        }
    }
}
