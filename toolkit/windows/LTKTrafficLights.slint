// LTKTrafficLights — macOS-style window control buttons.
// Circles are grey by default; coloured only on hover or when window is focused.
// Matches macOS Big Sur+ visual spec exactly.

import { LTKPalette } from "../theme/palette.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKMotion }  from "../theme/motion.slint";

export component LTKTrafficLights inherits HorizontalLayout {
    in property <bool> window-focused: true;
    in property <bool> hovered:        false;
    callback close-clicked();
    callback minimize-clicked();
    callback zoom-clicked();

    spacing: LTKSpace.traffic-gap;
    padding-left: LTKSpace.traffic-margin;
    alignment: center;
    height: LTKSpace.headerbar-height;

    // Whether to show colours (hovered or focused)
    property <bool> show-color: root.hovered || root.window-focused;

    // ── Close ──────────────────────────────────────────────────────────
    close-btn := Rectangle {
        width:  LTKSpace.traffic-size;
        height: LTKSpace.traffic-size;
        border-radius: LTKSpace.traffic-size / 2;
        background: root.show-color ? LTKPalette.traffic-close : LTKPalette.traffic-inactive;
        animate background { duration: LTKMotion.fast; easing: LTKMotion.ease-decelerate; }

        // × glyph visible on hover
        if close-touch.has-hover && root.show-color : Text {
            text: "✕";
            color: #5B0000BB;
            font-size: 7px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        close-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.close-clicked(); }
        }
    }

    // ── Minimize ───────────────────────────────────────────────────────
    min-btn := Rectangle {
        width:  LTKSpace.traffic-size;
        height: LTKSpace.traffic-size;
        border-radius: LTKSpace.traffic-size / 2;
        background: root.show-color ? LTKPalette.traffic-minimize : LTKPalette.traffic-inactive;
        animate background { duration: LTKMotion.fast; easing: LTKMotion.ease-decelerate; }

        if min-touch.has-hover && root.show-color : Text {
            text: "−";
            color: #5B3A0044;
            font-size: 7px;
            font-weight: 900;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        min-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.minimize-clicked(); }
        }
    }

    // ── Zoom / Full Screen ─────────────────────────────────────────────
    zoom-btn := Rectangle {
        width:  LTKSpace.traffic-size;
        height: LTKSpace.traffic-size;
        border-radius: LTKSpace.traffic-size / 2;
        background: root.show-color ? LTKPalette.traffic-zoom : LTKPalette.traffic-inactive;
        animate background { duration: LTKMotion.fast; easing: LTKMotion.ease-decelerate; }

        if zoom-touch.has-hover && root.show-color : Text {
            text: "⤢";
            color: #003B1544;
            font-size: 7px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        zoom-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.zoom-clicked(); }
        }
    }
}
