// LTKHeaderBar — LionOS hybrid: macOS traffic lights + GNOME headerbar layout.
//
// Layout:
//   [traffic lights] ── [leading-slot] ── [title (center)] ── [trailing-slot] ── [⋮]
//
// The bar doubles as a drag region (WindowHandle).
// Blur / glass material matches macOS vibrancy.

import { LTKPalette }       from "../theme/palette.slint";
import { LTKType }          from "../theme/typography.slint";
import { LTKSpace }         from "../theme/spacing.slint";
import { LTKMotion }        from "../theme/motion.slint";
import { LTKTrafficLights } from "LTKTrafficLights.slint";
import { LTKIcons }         from "../theme/icons.slint";

export component LTKHeaderBar inherits Rectangle {
    // ── Properties ────────────────────────────────────────────────────
    in property <string>  title;
    in property <string>  subtitle;
    in property <bool>    show-title:    true;
    in property <bool>    show-traffic:  true;
    in property <bool>    window-focused:true;
    in property <bool>    borderless:    false;    // true in fullscreen
    in property <bool>    flat:          false;    // no blur, flush with content

    callback close-requested();
    callback minimize-requested();
    callback zoom-requested();
    callback menu-requested();

    // ── Sizing ────────────────────────────────────────────────────────
    height: LTKSpace.headerbar-height;

    // ── Glass material ────────────────────────────────────────────────
    background: root.flat
        ? LTKPalette.bg-surface
        : LTKPalette.glass-thick;

    // Bottom separator
    if !root.borderless : Rectangle {
        y: parent.height - 1px;
        height: 1px; width: parent.width;
        background: LTKPalette.border-subtle;
    }

    // ── Drag region (entire bar moves window) ─────────────────────────
    WindowHandle { height: parent.height; width: parent.width; }

    // ── Layout ────────────────────────────────────────────────────────
    HorizontalLayout {
        spacing: 0px;
        alignment: center;

        // Traffic lights (left edge)
        if root.show-traffic : LTKTrafficLights {
            window-focused: root.window-focused;
            hovered: tl-hover.has-hover;
            close-clicked    => { root.close-requested(); }
            minimize-clicked => { root.minimize-requested(); }
            zoom-clicked     => { root.zoom-requested(); }
            tl-hover := TouchArea { }
        }

        // Leading slot (back button, search, etc.)
        Rectangle {
            width: LTKSpace.space-5;    // reserve space for back buttons etc.
            @children  // host injects leading buttons here via @children
        }

        // Spacer left
        Rectangle { horizontal-stretch: 1; }

        // Title block (centered)
        if root.show-title : VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: root.title;
                color: LTKPalette.text-primary;
                font-family: LTKType.font-ui;
                font-size: LTKType.text-sm;
                font-weight: LTKType.weight-semibold;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.subtitle != "" : Text {
                text: root.subtitle;
                color: LTKPalette.text-tertiary;
                font-family: LTKType.font-ui;
                font-size: LTKType.text-xs;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Spacer right
        Rectangle { horizontal-stretch: 1; }

        // Trailing slot + app menu button
        HorizontalLayout {
            spacing: LTKSpace.px4;
            padding-right: LTKSpace.space-2;
            alignment: center;

            // Host places trailing buttons in @children
            @children

            // App menu (GNOME ⋮ pattern)
            menu-btn := Rectangle {
                width: 28px; height: 28px;
                border-radius: 14px;
                background: menu-touch.has-hover ? LTKPalette.border-base : transparent;
                animate background { duration: LTKMotion.fast; easing: LTKMotion.ease-decelerate; }

                Image {
                    source: LTKIcons.more-vert;
                    width: 16px; height: 16px;
                    colorize: LTKPalette.text-secondary;
                }

                menu-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.menu-requested(); }
                }
            }
        }
    }
}
