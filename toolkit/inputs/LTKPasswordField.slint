// LTKPasswordField — macOS password field with show/hide toggle.
// Eye icon button reveals plain text (macOS NSSecureTextField behaviour).

import { LTKTextField } from "LTKTextField.slint";
import { LTKPalette }   from "../theme/palette.slint";
import { LTKType }      from "../theme/typography.slint";
import { LTKSpace }     from "../theme/spacing.slint";
import { LTKRadius }    from "../theme/radius.slint";
import { LTKMotion }    from "../theme/motion.slint";
import { LTKIcons }     from "../theme/icons.slint";

export component LTKPasswordField inherits Rectangle {
    in property <string>  label;
    in property <string>  placeholder: "Enter password…";
    in property <string>  hint;
    in property <string>  error-text;
    in property <bool>    has-error:   false;
    in-out property <string> value;
    in property <bool>    enabled:     true;
    callback accepted(v: string);
    callback edited(v: string);

    property <bool> revealed: false;
    out property <bool> focused: fi.has-focus;

    property <color> border-col:
        root.has-error ? LTKPalette.state-error
      : root.focused   ? LTKPalette.accent
      : LTKPalette.border-base;

    min-width: 160px;
    background: transparent;

    VerticalLayout {
        spacing: LTKSpace.px4;

        if root.label != "" : Text {
            text: root.label;
            color: root.has-error ? LTKPalette.state-error
                 : root.focused   ? LTKPalette.accent
                 : LTKPalette.text-secondary;
            font-family: LTKType.font-ui;
            font-size: LTKType.text-xs;
            font-weight: LTKType.weight-semibold;
            letter-spacing: 0.4px;
            animate color { duration: LTKMotion.fast; }
        }

        Rectangle {
            height: LTKSpace.input-md;
            border-radius: LTKRadius.input;
            border-width: root.focused ? 2px : 1px;
            border-color: root.border-col;
            background: root.enabled ? LTKPalette.bg-surface : LTKPalette.bg-raised;
            clip: true;
            animate border-color { duration: LTKMotion.fast; }
            animate border-width { duration: LTKMotion.fast; easing: LTKMotion.ease-spring; }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 6px;
                alignment: center;

                fi := TextInput {
                    text <=> root.value;
                    enabled: root.enabled;
                    placeholder-text: root.placeholder;
                    placeholder-color: LTKPalette.text-tertiary;
                    color: LTKPalette.text-primary;
                    font-family: root.revealed ? LTKType.font-body : LTKType.font-mono;
                    font-size: LTKType.text-base;
                    input-type: root.revealed ? InputType.text : InputType.password;
                    selection-background-color: LTKPalette.accent.with-alpha(0.25);
                    vertical-alignment: center;
                    accepted => { root.accepted(root.value); }
                    edited   => { root.edited(root.value); }
                }

                // Eye toggle button
                TouchArea {
                    width: 28px; height: 28px;
                    mouse-cursor: pointer;
                    clicked => { root.revealed = !root.revealed; }
                    Rectangle {
                        border-radius: 6px;
                        background: et-h.has-hover ? LTKPalette.border-base : transparent;
                        animate background { duration: LTKMotion.fast; }
                        Image {
                            source: root.revealed ? LTKIcons.eye-off : LTKIcons.eye;
                            width: 15px; height: 15px;
                            colorize: root.revealed ? LTKPalette.accent : LTKPalette.text-tertiary;
                            animate colorize { duration: LTKMotion.fast; }
                        }
                        et-h := TouchArea { }
                    }
                }
            }
        }

        if root.has-error && root.error-text != "" : Text {
            text: root.error-text;
            color: LTKPalette.state-error;
            font-family: LTKType.font-ui;
            font-size: LTKType.text-xs;
        }
        if !root.has-error && root.hint != "" : Text {
            text: root.hint;
            color: LTKPalette.text-tertiary;
            font-family: LTKType.font-ui;
            font-size: LTKType.text-xs;
        }
    }
}
