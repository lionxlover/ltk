// LTKRangeSlider — dual-thumb range selector.
// macOS style: two accent thumbs, filled track between them.

import { LTKPalette } from "../theme/palette.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LTKMotion }  from "../theme/motion.slint";

export component LTKRangeSlider inherits Rectangle {
    in property <float>  min-value:  0;
    in property <float>  max-value:  100;
    in-out property <float> low:     20;
    in-out property <float> high:    80;
    in property <bool>   enabled:    true;
    in property <color>  track-col:  LTKPalette.accent;
    callback range-changed(low: float, high: float);

    height: 44px;
    background: transparent;
    opacity: root.enabled ? 1.0 : 0.38;

    property <float> lo-pct: (root.low  - root.min-value) / (root.max-value - root.min-value);
    property <float> hi-pct: (root.high - root.min-value) / (root.max-value - root.min-value);

    // Track
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px; width: parent.width;
        border-radius: 2px;
        background: LTKPalette.border-base;

        // Filled segment
        Rectangle {
            x: root.lo-pct * parent.width;
            width: (root.hi-pct - root.lo-pct) * parent.width;
            height: 4px; border-radius: 2px;
            background: root.track-col;
            animate x     { duration: 30ms; }
            animate width { duration: 30ms; }
        }
    }

    // Low thumb
    Rectangle {
        width:  lo-t.has-hover ? 24px : 20px;
        height: lo-t.has-hover ? 24px : 20px;
        border-radius: self.width / 2;
        x: root.lo-pct * parent.width - self.width / 2;
        y: (parent.height - self.height) / 2;
        background: #FFFFFF;
        border-width: 2.5px;
        border-color: root.track-col;
        drop-shadow-blur: 6px; drop-shadow-offset-y: 2px; drop-shadow-color: LTKPalette.shadow-sm;
        animate width { duration: LTKMotion.fast; easing: LTKMotion.ease-spring; }
        animate height { duration: LTKMotion.fast; easing: LTKMotion.ease-spring; }

        lo-t := TouchArea {
            mouse-cursor: ew-resize;
            pointer-event(e) => {
                if e.kind == PointerEventKind.move || e.kind == PointerEventKind.down {
                    root.low = clamp(
                        root.min-value + (e.position.x / parent.width) * (root.max-value - root.min-value),
                        root.min-value, root.high - root.step
                    );
                    root.range-changed(root.low, root.high);
                }
            }
        }
    }

    // High thumb
    Rectangle {
        width:  hi-t.has-hover ? 24px : 20px;
        height: hi-t.has-hover ? 24px : 20px;
        border-radius: self.width / 2;
        x: root.hi-pct * parent.width - self.width / 2;
        y: (parent.height - self.height) / 2;
        background: #FFFFFF;
        border-width: 2.5px;
        border-color: root.track-col;
        drop-shadow-blur: 6px; drop-shadow-offset-y: 2px; drop-shadow-color: LTKPalette.shadow-sm;
        animate width { duration: LTKMotion.fast; easing: LTKMotion.ease-spring; }
        animate height { duration: LTKMotion.fast; easing: LTKMotion.ease-spring; }

        hi-t := TouchArea {
            mouse-cursor: ew-resize;
            pointer-event(e) => {
                if e.kind == PointerEventKind.move || e.kind == PointerEventKind.down {
                    root.high = clamp(
                        root.min-value + (e.position.x / parent.width) * (root.max-value - root.min-value),
                        root.low + root.step, root.max-value
                    );
                    root.range-changed(root.low, root.high);
                }
            }
        }
    }

    in property <float> step: 1.0;
    property <float> range-width: root.max-value - root.min-value;
}
