// LTKOTPField — 6-digit one-time-password input.
// macOS digit-box style: individual rounded rectangles, auto-advance.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LTKMotion }  from "../theme/motion.slint";

export component LTKOTPField inherits Rectangle {
    in property <int>      digits:  6;
    in-out property <string> value: "";
    in property <bool>     has-error: false;
    in property <string>   label;
    callback completed(code: string);

    background: transparent;
    min-width: root.digits * 52px + (root.digits - 1) * 8px;

    VerticalLayout {
        spacing: LTKSpace.space-1;

        if root.label != "" : Text {
            text: root.label;
            color: root.has-error ? LTKPalette.state-error : LTKPalette.text-secondary;
            font-family: LTKType.font-ui;
            font-size: LTKType.text-xs;
            font-weight: LTKType.weight-semibold;
            letter-spacing: 0.4px;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: center;

            for i in [0, 1, 2, 3, 4, 5] : Rectangle {
                width: 48px; height: 56px;
                border-radius: LTKRadius.sm;
                border-width: root.value.character-count == i ? 2px : 1px;
                border-color: root.has-error   ? LTKPalette.state-error
                            : root.value.character-count == i ? LTKPalette.accent
                            : root.value.character-count > i  ? LTKPalette.border-strong
                            : LTKPalette.border-base;
                background: LTKPalette.bg-surface;
                animate border-color { duration: LTKMotion.fast; }
                animate border-width { duration: LTKMotion.fast; easing: LTKMotion.ease-spring; }

                // Scale pop when digit entered
                y: root.value.character-count > i ? -1px : 0px;
                animate y { duration: LTKMotion.fast; easing: LTKMotion.ease-spring; }

                Text {
                    text: root.value.character-count > i ? "•" : "";
                    color: LTKPalette.text-primary;
                    font-family: LTKType.font-mono;
                    font-size: 22px;
                    font-weight: LTKType.weight-bold;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Hidden text input captures keystrokes
        TextInput {
            x: -9999px; opacity: 0;
            text <=> root.value;
            input-type: InputType.number;
            edited => {
                if root.value.character-count > root.digits {
                    root.value = root.value.slice(0, root.digits);
                }
                if root.value.character-count == root.digits {
                    root.completed(root.value);
                }
            }
        }
    }
}
