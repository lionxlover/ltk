// LTKRadioButton — macOS radio button with spring inner dot.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKMotion }  from "../theme/motion.slint";

export component LTKRadioButton inherits Rectangle {
    in property <string>  label;
    in property <string>  description;
    in-out property <bool> checked: false;
    in property <bool>    enabled:  true;
    callback selected();

    height: root.description != "" ? 46px : 30px;
    background: transparent;
    opacity: root.enabled ? 1.0 : 0.38;

    HorizontalLayout {
        spacing: LTKSpace.space-1;
        alignment: center;

        // Ring
        Rectangle {
            width: 18px; height: 18px;
            border-radius: 9px;
            border-width: 1.5px;
            border-color: root.checked ? LTKPalette.accent : LTKPalette.border-strong;
            background: transparent;
            animate border-color { duration: LTKMotion.fast; }

            // Inner dot — spring scale from 0 to full
            if root.checked : Rectangle {
                width: 9px; height: 9px;
                border-radius: 4.5px;
                background: LTKPalette.accent;
                x: 3px; y: 3px;
                // Spring pop: animate from scale 0 to 1
                animate width  { duration: LTKMotion.spring; easing: LTKMotion.ease-spring; }
                animate height { duration: LTKMotion.spring; easing: LTKMotion.ease-spring; }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                color: LTKPalette.text-primary;
                font-family: LTKType.font-ui;
                font-size: LTKType.text-base;
            }
            if root.description != "" : Text {
                text: root.description;
                color: LTKPalette.text-tertiary;
                font-family: LTKType.font-ui;
                font-size: LTKType.text-sm;
            }
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.checked = true; root.selected(); }
    }
}
