// LTKComboBox — macOS NSPopUpButton / GNOME ComboBoxText style.
// Chevron animates on open; selected label in primary text colour.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LTKMotion }  from "../theme/motion.slint";
import { LTKIcons }   from "../theme/icons.slint";

export struct LTKOption { value: string, label: string, enabled: bool }

export component LTKComboBox inherits Rectangle {
    in property <string>       label;
    in property <[LTKOption]>  options;
    in-out property <int>      selected-index: -1;
    in property <string>       placeholder: "Choose…";
    in property <bool>         enabled: true;

    callback changed(index: int, value: string);

    out property <bool> open: false;
    property <string> selected-label:
        root.selected-index >= 0 ? root.options[root.selected-index].label : "";

    min-width: 140px;
    background: transparent;

    VerticalLayout {
        spacing: LTKSpace.px4;

        if root.label != "" : Text {
            text: root.label;
            color: LTKPalette.text-secondary;
            font-family: LTKType.font-ui;
            font-size: LTKType.text-xs;
            font-weight: LTKType.weight-semibold;
            letter-spacing: 0.4px;
        }

        // Trigger button
        trigger := Rectangle {
            height: LTKSpace.input-md;
            border-radius: LTKRadius.input;
            border-width: root.open ? 2px : 1px;
            border-color: root.open ? LTKPalette.accent : LTKPalette.border-base;
            background: LTKPalette.bg-surface;
            opacity: root.enabled ? 1.0 : 0.38;
            animate border-color { duration: LTKMotion.fast; }
            animate border-width { duration: LTKMotion.fast; easing: LTKMotion.ease-spring; }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                alignment: center;

                Text {
                    text: root.selected-label != "" ? root.selected-label : root.placeholder;
                    color: root.selected-label != "" ? LTKPalette.text-primary : LTKPalette.text-tertiary;
                    font-family: LTKType.font-ui;
                    font-size: LTKType.text-base;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Image {
                    source: LTKIcons.down;
                    width: 14px; height: 14px;
                    colorize: LTKPalette.text-tertiary;
                    rotation-angle: root.open ? 180deg : 0deg;
                    animate rotation-angle { duration: LTKMotion.fast; easing: LTKMotion.ease-spring; }
                }
            }

            TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => { root.open = !root.open; }
            }
        }

        // Dropdown panel
        if root.open : Rectangle {
            border-radius: LTKRadius.menu;
            border-width: 1px;
            border-color: LTKPalette.border-base;
            background: LTKPalette.bg-raised;
            drop-shadow-blur:    20px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color:   LTKPalette.shadow-md;
            clip: true;
            z: 500;

            VerticalLayout {
                padding: LTKSpace.px4;
                for opt[i] in root.options : Rectangle {
                    height: 32px;
                    border-radius: LTKRadius.sm;
                    background: i == root.selected-index ? LTKPalette.accent.with-alpha(0.12)
                              : o-touch.has-hover ? LTKPalette.border-subtle
                              : transparent;
                    animate background { duration: LTKMotion.fast; }

                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px;
                        alignment: center;
                        // macOS checkmark on selected
                        if i == root.selected-index : Text {
                            text: "✓";
                            color: LTKPalette.accent;
                            font-size: 13px;
                            width: 20px;
                            vertical-alignment: center;
                        }
                        if i != root.selected-index : Rectangle { width: 20px; }
                        Text {
                            text: opt.label;
                            color: i == root.selected-index ? LTKPalette.accent : LTKPalette.text-primary;
                            font-family: LTKType.font-ui;
                            font-size: LTKType.text-base;
                            vertical-alignment: center;
                            opacity: opt.enabled ? 1.0 : 0.38;
                        }
                    }
                    o-touch := TouchArea {
                        enabled: opt.enabled;
                        mouse-cursor: pointer;
                        clicked => {
                            root.selected-index = i;
                            root.open = false;
                            root.changed(i, opt.value);
                        }
                    }
                }
            }
        }
    }
    // Click-away to close
    if root.open : TouchArea { z: -1; clicked => { root.open = false; } }
}
