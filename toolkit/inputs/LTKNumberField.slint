// LTKNumberField — macOS NSStepper style: text field + +/− buttons.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LTKMotion }  from "../theme/motion.slint";

export component LTKNumberField inherits Rectangle {
    in property <string> label;
    in-out property <float> value: 0.0;
    in property <float>  min-val:  0.0;
    in property <float>  max-val:  100.0;
    in property <float>  step:     1.0;
    in property <int>    decimals: 0;
    in property <string> suffix;
    in property <bool>   enabled:  true;
    callback value-changed(v: float);

    min-width: 120px;
    background: transparent;

    VerticalLayout {
        spacing: LTKSpace.px4;

        if root.label != "" : Text {
            text: root.label;
            color: LTKPalette.text-secondary;
            font-family: LTKType.font-ui;
            font-size: LTKType.text-xs;
            font-weight: LTKType.weight-semibold;
            letter-spacing: 0.4px;
        }

        Rectangle {
            height: LTKSpace.input-md;
            border-radius: LTKRadius.input;
            border-width: 1px;
            border-color: LTKPalette.border-base;
            background: LTKPalette.bg-surface;
            clip: true;
            opacity: root.enabled ? 1.0 : 0.38;

            HorizontalLayout {
                spacing: 0px;

                // Decrement
                Rectangle {
                    width: 32px;
                    background: dec-t.has-hover ? LTKPalette.border-base : transparent;
                    animate background { duration: LTKMotion.fast; }
                    Text {
                        text: "−";
                        color: LTKPalette.text-secondary;
                        font-size: LTKType.text-lg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        x: parent.width - 1px; width: 1px; height: parent.height;
                        background: LTKPalette.border-subtle;
                    }
                    dec-t := TouchArea {
                        enabled: root.enabled;
                        mouse-cursor: pointer;
                        clicked => {
                            root.value = clamp(root.value - root.step, root.min-val, root.max-val);
                            root.value-changed(root.value);
                        }
                    }
                }

                // Value display
                Rectangle {
                    horizontal-stretch: 1;
                    Text {
                        text: root.value + root.suffix;
                        color: LTKPalette.text-primary;
                        font-family: LTKType.font-mono;
                        font-size: LTKType.text-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Increment
                Rectangle {
                    width: 32px;
                    background: inc-t.has-hover ? LTKPalette.border-base : transparent;
                    animate background { duration: LTKMotion.fast; }
                    Rectangle {
                        x: 0px; width: 1px; height: parent.height;
                        background: LTKPalette.border-subtle;
                    }
                    Text {
                        text: "+";
                        color: LTKPalette.text-secondary;
                        font-size: LTKType.text-lg;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    inc-t := TouchArea {
                        enabled: root.enabled;
                        mouse-cursor: pointer;
                        clicked => {
                            root.value = clamp(root.value + root.step, root.min-val, root.max-val);
                            root.value-changed(root.value);
                        }
                    }
                }
            }
        }
    }
}
