// LTKBanner — full-width informational banner (GNOME AdwBanner).
// Sits directly below the headerbar. Supports action button.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKMotion }  from "../theme/motion.slint";

export enum LTKBannerKind { Info, Success, Warning, Error }

export component LTKBanner inherits Rectangle {
    in property <string>         message;
    in property <string>         action-label;
    in property <LTKBannerKind>  kind:     LTKBannerKind.Info;
    in property <bool>           visible:  true;
    in property <bool>           closable: true;
    callback action-clicked();
    callback dismissed();

    property <color> kind-color:
        root.kind == LTKBannerKind.Success ? LTKPalette.state-success
      : root.kind == LTKBannerKind.Warning ? LTKPalette.state-warning
      : root.kind == LTKBannerKind.Error   ? LTKPalette.state-error
      : LTKPalette.accent;

    visible: root.visible;
    height: 40px;
    background: root.kind-color.with-alpha(0.10);
    border-width: 0px;

    // Bottom accent line
    Rectangle {
        y: parent.height - 2px; height: 2px; width: parent.width;
        background: root.kind-color.with-alpha(0.35);
    }

    HorizontalLayout {
        padding-left:  LTKSpace.space-3;
        padding-right: LTKSpace.space-2;
        spacing: LTKSpace.space-2;
        alignment: center;
        vertical-alignment: center;

        Text {
            text: root.message;
            color: LTKPalette.text-primary;
            font-family: LTKType.font-ui;
            font-size: LTKType.text-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        if root.action-label != "" : TouchArea {
            mouse-cursor: pointer;
            clicked => { root.action-clicked(); }
            Text {
                text: root.action-label;
                color: root.kind-color;
                font-family: LTKType.font-ui;
                font-size: LTKType.text-sm;
                font-weight: LTKType.weight-semibold;
            }
        }

        if root.closable : TouchArea {
            width: 28px; height: 28px;
            mouse-cursor: pointer;
            clicked => { root.dismissed(); }
            Text {
                text: "×";
                color: LTKPalette.text-secondary;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
