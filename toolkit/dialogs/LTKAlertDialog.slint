// LTKAlertDialog — macOS NSAlert exact clone.
// Icon top, title, message, 1-3 buttons in bottom row.
// Default button gets accent fill; destructive gets red.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LTKMotion }  from "../theme/motion.slint";
import { LTKIcons }   from "../theme/icons.slint";

export enum LTKAlertKind { Info, Warning, Error, Success }

export component LTKAlertDialog inherits Rectangle {
    in property <bool>        open:       false;
    in property <string>      title;
    in property <string>      message;
    in property <LTKAlertKind>kind:       LTKAlertKind.Info;
    in property <string>      primary-label:     "OK";
    in property <string>      secondary-label;
    in property <string>      destructive-label;

    callback primary-clicked();
    callback secondary-clicked();
    callback destructive-clicked();

    background: transparent;
    z: 900;

    property <color> kind-color:
        root.kind == LTKAlertKind.Success ? LTKPalette.state-success
      : root.kind == LTKAlertKind.Warning ? LTKPalette.state-warning
      : root.kind == LTKAlertKind.Error   ? LTKPalette.state-error
      : LTKPalette.accent;

    if root.open : Rectangle {
        width: parent.width; height: parent.height;
        background: LTKPalette.shadow-xl.with-alpha(0.65);
        animate opacity { duration: LTKMotion.fast; }
        if root.open : TouchArea { }  // block clicks behind dialog
    }

    if root.open : Rectangle {
        width: 320px;
        x: (parent.width - 320px) / 2;
        y: max(60px, (parent.height - dlg-lay.preferred-height) / 2 - 40px);
        height: dlg-lay.preferred-height;
        border-radius: LTKRadius.dialog;
        border-width: 1px;
        border-color: LTKPalette.border-base;
        background: LTKPalette.bg-overlay;
        drop-shadow-blur: 48px;
        drop-shadow-offset-y: 16px;
        drop-shadow-color: LTKPalette.shadow-xl;
        clip: true;
        z: 901;

        dlg-lay := VerticalLayout {
            padding: LTKSpace.space-5;
            spacing: LTKSpace.space-3;
            alignment: start;

            // Kind icon (macOS: large centred icon above title)
            Rectangle {
                height: 52px;
                background: transparent;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 52px; height: 52px;
                        border-radius: 26px;
                        background: root.kind-color.with-alpha(0.12);
                        Image {
                            source: root.kind == LTKAlertKind.Error   ? LTKIcons.error
                                  : root.kind == LTKAlertKind.Warning ? LTKIcons.warning
                                  : root.kind == LTKAlertKind.Success ? LTKIcons.check
                                  : LTKIcons.info;
                            width: 24px; height: 24px;
                            colorize: root.kind-color;
                        }
                    }
                }
            }

            // Title
            Text {
                text: root.title;
                color: LTKPalette.text-primary;
                font-family: LTKType.font-display;
                font-size: LTKType.headline;
                font-weight: LTKType.weight-bold;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            // Message
            if root.message != "" : Text {
                text: root.message;
                color: LTKPalette.text-secondary;
                font-family: LTKType.font-body;
                font-size: LTKType.subheadline;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle { height: LTKSpace.px4; background: transparent; }

            // Button row — macOS: Cancel left, OK right (primary on right)
            HorizontalLayout {
                spacing: LTKSpace.space-1;

                if root.destructive-label != "" : Rectangle {
                    height: 36px;
                    border-radius: 9999px;
                    background: LTKPalette.state-error.with-alpha(0.12);
                    border-width: 1px;
                    border-color: LTKPalette.state-error.with-alpha(0.30);
                    horizontal-stretch: 1;
                    Text {
                        text: root.destructive-label;
                        color: LTKPalette.state-error;
                        font-family: LTKType.font-ui;
                        font-size: LTKType.text-sm;
                        font-weight: LTKType.weight-semibold;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { root.destructive-clicked(); } }
                }

                if root.secondary-label != "" : Rectangle {
                    height: 36px;
                    border-radius: 9999px;
                    background: LTKPalette.glass-regular;
                    border-width: 1px;
                    border-color: LTKPalette.border-strong;
                    horizontal-stretch: 1;
                    Text {
                        text: root.secondary-label;
                        color: LTKPalette.text-primary;
                        font-family: LTKType.font-ui;
                        font-size: LTKType.text-sm;
                        font-weight: LTKType.weight-semibold;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { root.secondary-clicked(); } }
                }

                Rectangle {
                    height: 36px;
                    border-radius: 9999px;
                    background: LTKPalette.accent;
                    horizontal-stretch: 1;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: LTKPalette.accent-glow;
                    Text {
                        text: root.primary-label;
                        color: LTKPalette.on-accent;
                        font-family: LTKType.font-ui;
                        font-size: LTKType.text-sm;
                        font-weight: LTKType.weight-bold;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { mouse-cursor: pointer; clicked => { root.primary-clicked(); } }
                }
            }
        }
    }
}
