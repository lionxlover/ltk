// LTKShimmer — macOS Catalyst loading shimmer.
// Linear gradient sweep on a coloured rectangle.

import { LTKPalette } from "../theme/palette.slint";
import { LTKRadius }  from "../theme/radius.slint";

export component LTKShimmer inherits Rectangle {
    in property <color>  base-color:    LTKPalette.border-base;
    in property <color>  shimmer-color: LTKPalette.border-strong;
    in property <length> skel-radius:   LTKRadius.sm;

    border-radius: root.skel-radius;
    background: root.base-color;
    clip: true;

    Rectangle {
        width: parent.width * 0.5;
        height: parent.height;
        background: @linear-gradient(90deg,
            transparent           0%,
            root.shimmer-color   50%,
            transparent         100%);
        x: mod(animation-tick() / 2.5ms, parent.width * 1.5) - parent.width * 0.5;
    }
}
