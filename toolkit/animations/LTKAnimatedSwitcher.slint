// LTKAnimatedSwitcher — cross-fade between two child views.
// Based on macOS view transition: fade-out A, fade-in B.

import { LTKMotion } from "../theme/motion.slint";

export component LTKAnimatedSwitcher inherits Rectangle {
    in property <int>  current: 0;

    // Host places multiple children; only index == current is visible.
    // Opacity-only transition (macOS page transition style).
    for child[i] in @children : Rectangle {
        opacity: i == root.current ? 1.0 : 0.0;
        visible: i == root.current;
        animate opacity { duration: LTKMotion.base; easing: LTKMotion.ease-decelerate; }
        @children   // re-host child content
    }
}
