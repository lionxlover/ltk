// LTKImageViewer — macOS Preview / GNOME Image Viewer.
// Pan, zoom controls, filename caption, fullscreen toggle.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LTKMotion }  from "../theme/motion.slint";
import { LTKIcons }   from "../theme/icons.slint";

export component LTKImageViewer inherits Rectangle {
    in property <image>  source;
    in property <string> filename;
    in property <bool>   show-toolbar: true;
    in property <bool>   fullscreen:   false;

    callback zoom-in();
    callback zoom-out();
    callback zoom-reset();
    callback fullscreen-toggled(v: bool);
    callback close();

    background: #000000;
    border-radius: root.fullscreen ? 0px : LTKRadius.lg;
    clip: true;

    // Image display
    Image {
        source: root.source;
        width:  parent.width;
        height: root.show-toolbar ? parent.height - LTKSpace.toolbar-height : parent.height;
        image-fit: contain;
    }

    // Bottom toolbar
    if root.show-toolbar : Rectangle {
        y: parent.height - LTKSpace.toolbar-height;
        height: LTKSpace.toolbar-height;
        width: parent.width;
        background: #000000BB;

        HorizontalLayout {
            padding-left:  LTKSpace.space-3;
            padding-right: LTKSpace.space-3;
            spacing: LTKSpace.space-1;
            alignment: center;
            vertical-alignment: center;

            Text {
                text: root.filename;
                color: #FFFFFFAA;
                font-family: LTKType.font-mono;
                font-size: LTKType.text-xs;
                horizontal-stretch: 1;
                overflow: elide;
            }

            // Zoom controls
            for icon-data in [{ icon: LTKIcons.remove, label: "Zoom Out" },
                               { icon: LTKIcons.add,    label: "Zoom In"  }] : TouchArea {
                width: 32px; height: 32px;
                mouse-cursor: pointer;
                clicked => {
                    if icon-data.label == "Zoom Out" { root.zoom-out(); }
                    else { root.zoom-in(); }
                }
                Rectangle {
                    border-radius: 6px;
                    background: parent.has-hover ? #FFFFFF22 : transparent;
                    Image {
                        source: icon-data.icon;
                        width: 16px; height: 16px;
                        colorize: #FFFFFFCC;
                    }
                }
            }

            TouchArea {
                width: 32px; height: 32px;
                mouse-cursor: pointer;
                clicked => { root.fullscreen-toggled(!root.fullscreen); }
                Rectangle {
                    border-radius: 6px;
                    background: parent.has-hover ? #FFFFFF22 : transparent;
                    Image {
                        source: LTKIcons.fullscreen;
                        width: 16px; height: 16px;
                        colorize: #FFFFFFCC;
                    }
                }
            }
        }
    }
}
