// Bordered, translucent — secondary action. macOS "borderless" look in toolbars.
import { LTKButton }   from "LTKButton.slint";
import { LTKPalette }  from "../theme/palette.slint";

export component LTKSecondaryButton inherits LTKButton {
    bg:        LTKPalette.glass-regular;
    bg-hover:  LTKPalette.border-base;
    fg:        LTKPalette.text-primary;
    border-col:LTKPalette.border-strong;
    bw:        1px;
    drop-shadow-blur: 0px;  // no shadow lift on secondary
}
