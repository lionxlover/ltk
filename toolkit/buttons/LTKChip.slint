// LTKChip — compact tag/filter chip.
// GNOME badge style: pill shape, accent-tinted when selected.

import { LTKPalette }  from "../theme/palette.slint";
import { LTKRadius }   from "../theme/radius.slint";
import { LTKType }     from "../theme/typography.slint";
import { LTKMotion }   from "../theme/motion.slint";

export component LTKChip inherits Rectangle {
    in property <string>  text;
    in property <image>   icon;
    in property <bool>    has-icon: false;
    in property <bool>    selected: false;
    in property <bool>    closable: false;
    in property <color>   accent:   LTKPalette.accent;
    callback clicked();
    callback closed();

    height: 26px;
    border-radius: LTKRadius.chip;
    border-width: 1px;
    background: root.selected ? root.accent.with-alpha(0.15) : LTKPalette.glass-thin;
    border-color: root.selected ? root.accent.with-alpha(0.45) : LTKPalette.border-base;

    animate background   { duration: LTKMotion.fast; }
    animate border-color { duration: LTKMotion.fast; }

    HorizontalLayout {
        padding-left: root.has-icon ? 8px : 10px;
        padding-right: root.closable ? 4px : 10px;
        spacing: 4px;
        alignment: center;

        if root.has-icon : Image {
            source: root.icon;
            width: 12px; height: 12px;
            colorize: root.selected ? root.accent : LTKPalette.text-secondary;
        }

        Text {
            text: root.text;
            color: root.selected ? root.accent : LTKPalette.text-secondary;
            font-family: LTKType.font-ui;
            font-size: LTKType.text-xs;
            font-weight: LTKType.weight-medium;
            vertical-alignment: center;
        }

        if root.closable : TouchArea {
            width: 16px; height: 16px;
            mouse-cursor: pointer;
            clicked => { root.closed(); }
            Text {
                text: "×";
                color: LTKPalette.text-tertiary;
                font-size: LTKType.text-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
