// LTKButton — Base button using macOS control geometry + spring animation.
//
// macOS rules:
//  - Always pill-shaped (border-radius: 9999px)
//  - System default height: 32px (standard control size)
//  - No hover background change — only opacity + shadow lift
//  - Press: scale(0.97) + spring back (micro spring)
//  - Loading state: spinner replaces label, no layout shift

import { LTKPalette }  from "../theme/palette.slint";
import { LTKType }     from "../theme/typography.slint";
import { LTKSpace }    from "../theme/spacing.slint";
import { LTKRadius }   from "../theme/radius.slint";
import { LTKMotion }   from "../theme/motion.slint";

export component LTKButton inherits Rectangle {
    // ── API ───────────────────────────────────────────────────────────
    in property <string>  text;
    in property <image>   icon;
    in property <bool>    has-icon:       false;
    in property <bool>    icon-trailing:  false;
    in property <bool>    enabled:        true;
    in property <bool>    loading:        false;
    in property <bool>    destructive:    false;  // red tint (macOS destructive)

    // ── Colour tokens (overridden by variants) ────────────────────────
    in property <color>   bg:         LTKPalette.accent;
    in property <color>   fg:         LTKPalette.on-accent;
    in property <color>   bg-hover:   LTKPalette.accent-dim;
    in property <color>   border-col: transparent;
    in property <length>  bw:         0px;

    // ── Size ─────────────────────────────────────────────────────────
    in property <length>  btn-height: LTKSpace.control-md;
    in property <length>  min-w:      72px;

    callback clicked();
    callback pressed();
    callback released();

    out property <bool> is-hovered: touch.has-hover;
    out property <bool> is-pressed: touch.pressed;

    // ── Geometry ──────────────────────────────────────────────────────
    height: root.btn-height;
    min-width: root.min-w;
    border-radius: LTKRadius.button;
    opacity: root.enabled ? 1.0 : 0.38;  // macOS disabled = 38% opacity

    // ── Spring press scale (macOS micro spring) ────────────────────────
    // Slint doesn't support scale transforms directly via animate,
    // so we approximate with y offset (subtle sink effect)
    y: root.is-pressed && root.enabled ? 1px : 0px;
    animate y { duration: 80ms; easing: LTKMotion.ease-spring; }

    // ── Background ────────────────────────────────────────────────────
    background: root.destructive ? LTKPalette.state-error
              : root.is-pressed  ? root.bg-hover
              : root.bg;

    // ── Shadow lift on hover (macOS button feel) ──────────────────────
    drop-shadow-blur:     root.is-hovered && !root.is-pressed ? 12px : 2px;
    drop-shadow-offset-y: root.is-hovered && !root.is-pressed ? 3px  : 1px;
    drop-shadow-color:    LTKPalette.accent-glow;

    animate background        { duration: LTKMotion.fast; easing: LTKMotion.ease-decelerate; }
    animate drop-shadow-blur  { duration: LTKMotion.base; easing: LTKMotion.ease-soft; }

    // ── Border ────────────────────────────────────────────────────────
    border-width: root.bw;
    border-color: root.border-col;

    // ── Content ───────────────────────────────────────────────────────
    HorizontalLayout {
        padding-left:  root.has-icon && !root.icon-trailing ? 14px : 18px;
        padding-right: root.has-icon &&  root.icon-trailing ? 14px : 18px;
        spacing: 6px;
        alignment: center;

        if root.has-icon && !root.icon-trailing && !root.loading : Image {
            source: root.icon;
            width: 15px; height: 15px;
            colorize: root.fg;
        }

        if root.loading : Rectangle {
            width: 14px; height: 14px;
            border-radius: 7px;
            border-width: 2px;
            border-color: root.fg.with-alpha(0.4);
            border-top-color: root.fg;
            // Slint doesn't animate rotation natively; spinner shimmer instead:
            opacity: 0.8;
        }

        if !root.loading : Text {
            text: root.text;
            color: root.fg;
            font-family: LTKType.font-ui;
            font-size: LTKType.text-sm;
            font-weight: LTKType.weight-semibold;
            vertical-alignment: center;
        }

        if root.has-icon && root.icon-trailing && !root.loading : Image {
            source: root.icon;
            width: 14px; height: 14px;
            colorize: root.fg;
        }
    }

    touch := TouchArea {
        enabled: root.enabled && !root.loading;
        mouse-cursor: pointer;
        clicked       => { root.clicked(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { root.pressed(); }
            if e.kind == PointerEventKind.up   { root.released(); }
        }
    }
}
