// Icon-only circular button (macOS toolbar icon button style).
// 28×28 by default; hover reveals circular background.

import { LTKPalette }  from "../theme/palette.slint";
import { LTKRadius }   from "../theme/radius.slint";
import { LTKMotion }   from "../theme/motion.slint";

export component LTKIconButton inherits Rectangle {
    in property <image>  icon;
    in property <string> tooltip;
    in property <bool>   enabled: true;
    in property <length> size:    28px;
    in property <color>  icon-color:       LTKPalette.text-secondary;
    in property <color>  icon-hover-color: LTKPalette.text-primary;
    in property <color>  bg-hover:         LTKPalette.border-base;
    callback clicked();

    width: root.size; height: root.size;
    border-radius: root.size / 2;
    opacity: root.enabled ? 1.0 : 0.38;
    background: touch.has-hover ? root.bg-hover : transparent;
    animate background { duration: LTKMotion.fast; easing: LTKMotion.ease-decelerate; }

    Image {
        source: root.icon;
        width:  root.size * 0.54;
        height: root.size * 0.54;
        colorize: touch.has-hover ? root.icon-hover-color : root.icon-color;
        animate colorize { duration: LTKMotion.fast; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
