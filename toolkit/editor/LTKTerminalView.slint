// LTKTerminalView — scrollable terminal output display.
// Black background, monospace, selection support.
// Separate from interactive input (compose with LTKTextField).

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";

export component LTKTerminalView inherits Rectangle {
    in property <string>  output;
    in property <color>   term-bg:  #0A0C10;
    in property <color>   term-fg:  #A6E3A1;   // Catppuccin green
    in property <color>   term-cursor: #CDD6F4;
    in property <bool>    scroll-to-bottom: true;

    border-radius: LTKRadius.md;
    border-width: 1px;
    border-color: LTKPalette.border-base;
    background: root.term-bg;
    clip: true;

    // Top bar
    Rectangle {
        height: 28px;
        background: #111318;
        border-bottom-width: 1px;
        border-bottom-color: LTKPalette.border-subtle;

        HorizontalLayout {
            padding-left: LTKSpace.space-2;
            spacing: LTKSpace.space-1;
            alignment: center;
            // macOS terminal dot decorations
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #FF5F57; }
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #FFBD2E; }
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #28C840; }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: "bash";
                color: LTKPalette.text-tertiary;
                font-family: LTKType.font-mono;
                font-size: LTKType.text-xs;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    // Output area
    ScrollView {
        y: 28px;
        height: parent.height - 28px;
        width: parent.width;

        TextInput {
            text: root.output;
            enabled: false;
            multi-line: true;
            color: root.term-fg;
            font-family: LTKType.font-mono;
            font-size: LTKType.text-code;
            selection-background-color: #FFFFFF22;
            selection-foreground-color: root.term-fg;
            padding: LTKSpace.space-2;
            wrap: TextWrap.no-wrap;
        }
    }
}
