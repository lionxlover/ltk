// LTKToolbar — macOS NSToolbar / GNOME Toolbar.
// Flexible item container with separators, spacers, overflow.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKMotion }  from "../theme/motion.slint";

export component LTKToolbar inherits Rectangle {
    in property <bool>    bordered-bottom: true;
    in property <bool>    flush-with-header: false;
    in property <color>   tool-bg: LTKPalette.glass-thick;

    height: LTKSpace.toolbar-height;
    background: root.tool-bg;

    if root.bordered-bottom : Rectangle {
        y: parent.height - 1px; height: 1px; width: parent.width;
        background: LTKPalette.border-subtle;
    }

    HorizontalLayout {
        padding-left:  LTKSpace.space-2;
        padding-right: LTKSpace.space-2;
        spacing: LTKSpace.px4;
        alignment: center;
        vertical-alignment: center;
        @children
    }
}

export component LTKToolbarSeparator inherits Rectangle {
    width: 1px; height: 20px;
    background: LTKPalette.border-base;
}

export component LTKToolbarSpacer inherits Rectangle {
    horizontal-stretch: 1;
    background: transparent;
}
