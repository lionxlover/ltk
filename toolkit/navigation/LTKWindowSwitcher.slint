// LTKWindowSwitcher — macOS Mission Control-inspired window thumbnail strip.
// Displays open windows/views as cards; selected = raised + accent border.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LTKMotion }  from "../theme/motion.slint";

export struct LTKWindowThumb { title: string, icon: image, preview: image, has-preview: bool }

export component LTKWindowSwitcher inherits Rectangle {
    in property <[LTKWindowThumb]> windows;
    in-out property <int>          active: 0;
    callback activated(i: int);

    height: 90px;
    background: LTKPalette.glass-thick;
    border-radius: LTKRadius.xl;
    border-width: 1px;
    border-color: LTKPalette.border-subtle;

    ScrollView {
        HorizontalLayout {
            padding: LTKSpace.space-1;
            spacing: LTKSpace.space-1;
            alignment: LayoutAlignment.start;

            for win[i] in root.windows : Rectangle {
                width: 120px; height: 74px;
                border-radius: LTKRadius.md;
                border-width: i == root.active ? 2px : 1px;
                border-color: i == root.active ? LTKPalette.accent : LTKPalette.border-subtle;
                background: i == root.active ? LTKPalette.bg-surface : LTKPalette.bg-raised;
                drop-shadow-blur: i == root.active ? 8px : 0px;
                drop-shadow-color: LTKPalette.accent.with-alpha(0.30);
                clip: true;
                animate border-color     { duration: LTKMotion.fast; }
                animate border-width     { duration: LTKMotion.fast; }
                animate drop-shadow-blur { duration: LTKMotion.fast; }

                y: i == root.active ? -2px : 0px;
                animate y { duration: LTKMotion.fast; easing: LTKMotion.ease-spring; }

                VerticalLayout {
                    spacing: 0px;
                    // Preview area
                    Rectangle {
                        height: 50px;
                        background: LTKPalette.bg-overlay;
                        if win.has-preview : Image {
                            source: win.preview;
                            width: parent.width; height: parent.height;
                            image-fit: cover;
                        }
                        if !win.has-preview : Rectangle {
                            background: LTKPalette.accent.with-alpha(0.08);
                            Image {
                                source: win.icon;
                                width: 24px; height: 24px;
                                colorize: LTKPalette.accent.with-alpha(0.40);
                            }
                        }
                    }
                    // Title bar
                    HorizontalLayout {
                        height: 24px;
                        padding-left: 6px; padding-right: 6px;
                        spacing: 4px;
                        alignment: center;
                        Image {
                            source: win.icon;
                            width: 12px; height: 12px;
                            colorize: i == root.active ? LTKPalette.text-primary : LTKPalette.text-secondary;
                        }
                        Text {
                            text: win.title;
                            color: i == root.active ? LTKPalette.text-primary : LTKPalette.text-secondary;
                            font-family: LTKType.font-ui;
                            font-size: 10px;
                            font-weight: i == root.active ? LTKType.weight-medium : LTKType.weight-regular;
                            overflow: elide;
                        }
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.active = i; root.activated(i); }
                }
            }
        }
    }
}
