// LTK Kitchen Sink — all major components on one page.
// Use to validate theme tokens and visual regression test.

import { LTKPalette, LTKType, LTKSpace, LTKMotion }
    from "../ltk.slint";
import { LTKAppWindow }
    from "../windows/LTKAppWindow.slint";
import { LTKHeaderBar }
    from "../windows/LTKHeaderBar.slint";
import { LTKPrimaryButton, LTKSecondaryButton,
         LTKDestructiveButton, LTKGhostButton,
         LTKIconButton, LTKFAButton,
         LTKSegmentControl, LTKSegment,
         LTKToggleSwitch, LTKChip }
    from "../ltk.slint";
import { LTKTextField, LTKSearchField,
         LTKCheckBox, LTKRadioButton,
         LTKSlider, LTKComboBox, LTKOption }
    from "../ltk.slint";
import { LTKSidebar, LTKNavEntry, LTKTabBar, LTKTab, LTKTabStyle,
         LTKBreadcrumb, LTKCrumb }
    from "../ltk.slint";
import { LTKCard, LTKCardMaterial, LTKGlassPanel, LTKGlassTier,
         LTKAccordionItem, LTKSectionGroup, LTKSectionRow }
    from "../ltk.slint";
import { LTKToast, LTKToastKind,
         LTKBanner, LTKBannerKind, LTKTooltip }
    from "../ltk.slint";
import { LTKProgressBar, LTKSpinner, LTKBadge, LTKAvatar, LTKDivider, LTKSkeletonCard }
    from "../ltk.slint";

export component KitchenSink inherits Window {
    title: "LTK Kitchen Sink";
    width: 1280px;
    height: 900px;
    no-frame: true;
    background: LTKPalette.bg-base;
    default-font-family: LTKType.font-ui;
    default-font-size: LTKType.text-base;

    LTKHeaderBar {
        title: "LTK Kitchen Sink";
        subtitle: "All components · LionOS Design System";
    }

    Rectangle {
        y: 47px;
        height: parent.height - 47px;
        width: parent.width;

        ScrollView {
            VerticalLayout {
                padding: LTKSpace.space-6;
                spacing: LTKSpace.space-5;

                // ── Banner ─────────────────────────────────────────────
                LTKBanner {
                    message: "LionOS design system v2.0 — macOS × GNOME inspiration";
                    action-label: "Learn more";
                    kind: LTKBannerKind.Info;
                }

                // ── Breadcrumb ─────────────────────────────────────────
                LTKBreadcrumb {
                    crumbs: [
                        { label: "LionOS", icon: @image-url(""), has-icon: false },
                        { label: "Settings", icon: @image-url(""), has-icon: false },
                        { label: "Appearance", icon: @image-url(""), has-icon: false },
                    ];
                }

                LTKDivider { }

                // ── Buttons ────────────────────────────────────────────
                Text {
                    text: "BUTTONS";
                    color: LTKPalette.text-tertiary;
                    font-family: LTKType.font-mono;
                    font-size: LTKType.text-xs;
                    letter-spacing: 1px;
                }
                HorizontalLayout {
                    spacing: LTKSpace.space-1;
                    LTKPrimaryButton    { text: "Primary"; }
                    LTKSecondaryButton  { text: "Secondary"; }
                    LTKGhostButton      { text: "Ghost"; }
                    LTKDestructiveButton{ text: "Delete"; }
                    LTKPrimaryButton    { text: "Loading…"; loading: true; }
                }

                // ── Segment ────────────────────────────────────────────
                LTKSegmentControl {
                    segments: [
                        { label: "Day",   icon: @image-url(""), has-icon: false },
                        { label: "Week",  icon: @image-url(""), has-icon: false },
                        { label: "Month", icon: @image-url(""), has-icon: false },
                    ];
                }

                // ── Toggle & Chip ──────────────────────────────────────
                HorizontalLayout {
                    spacing: LTKSpace.space-3;
                    LTKToggleSwitch { label: "Dark mode"; checked: true; }
                    LTKToggleSwitch { label: "Notifications"; description: "App alerts and sounds"; }
                }
                HorizontalLayout {
                    spacing: LTKSpace.px4;
                    LTKChip { text: "macOS"; }
                    LTKChip { text: "GNOME";    selected: true; }
                    LTKChip { text: "LionOS";   closable: true; }
                    LTKChip { text: "Slint-UI"; }
                }

                LTKDivider { }

                // ── Inputs ─────────────────────────────────────────────
                Text {
                    text: "INPUTS";
                    color: LTKPalette.text-tertiary;
                    font-family: LTKType.font-mono;
                    font-size: LTKType.text-xs;
                    letter-spacing: 1px;
                }
                HorizontalLayout {
                    spacing: LTKSpace.space-4;
                    LTKTextField {
                        label: "Username";
                        placeholder: "lion@lionos.dev";
                        horizontal-stretch: 1;
                    }
                    LTKSearchField {
                        kbd-shortcut: "⌘K";
                        horizontal-stretch: 1;
                    }
                }
                HorizontalLayout {
                    spacing: LTKSpace.space-5;
                    LTKCheckBox  { label: "Enable vibrancy"; checked: true; }
                    LTKCheckBox  { label: "Reduce motion"; }
                    LTKRadioButton { label: "Dark mode";  checked: true; }
                    LTKRadioButton { label: "Light mode"; }
                }
                LTKSlider { value: 65; show-value: true; suffix: "%"; }
                LTKComboBox {
                    label: "Accent colour";
                    options: [
                        { value: "blue",     label: "Blue (LionOS)",  enabled: true },
                        { value: "purple",   label: "Purple",         enabled: true },
                        { value: "green",    label: "Green",          enabled: true },
                    ];
                    selected-index: 0;
                }

                LTKDivider { }

                // ── Progress ───────────────────────────────────────────
                Text {
                    text: "PROGRESS & STATUS";
                    color: LTKPalette.text-tertiary;
                    font-family: LTKType.font-mono;
                    font-size: LTKType.text-xs;
                    letter-spacing: 1px;
                }
                LTKProgressBar { value: 0.72; label: "Installing…"; show-percent: true; }
                LTKProgressBar { indeterminate: true; label: "Loading data"; }
                HorizontalLayout {
                    spacing: LTKSpace.space-3;
                    alignment: center;
                    LTKSpinner { size: 20px; }
                    LTKSpinner { size: 28px; }
                    LTKSpinner { size: 36px; }
                    LTKAvatar  { initials: "LT"; bg: LTKPalette.accent; }
                    LTKAvatar  { initials: "GN"; bg: LTKPalette.state-success; shape: LTKAvatarShape.Squircle; }
                    LTKBadge   { count: "12"; }
                    LTKBadge   { count: "99+"; color: LTKPalette.state-error; }
                }

                LTKDivider { }

                // ── Cards ──────────────────────────────────────────────
                Text {
                    text: "CONTAINERS";
                    color: LTKPalette.text-tertiary;
                    font-family: LTKType.font-mono;
                    font-size: LTKType.text-xs;
                    letter-spacing: 1px;
                }
                HorizontalLayout {
                    spacing: LTKSpace.space-3;
                    LTKCard {
                        title: "Filled Card";
                        subtitle: "macOS NSBox aesthetic";
                        interactive: true;
                        horizontal-stretch: 1;
                        LTKPrimaryButton { text: "Action"; }
                    }
                    LTKCard {
                        title: "Glass Card";
                        subtitle: "macOS vibrancy material";
                        material: LTKCardMaterial.Glass;
                        interactive: true;
                        horizontal-stretch: 1;
                        LTKSecondaryButton { text: "Open"; }
                    }
                    LTKCard {
                        title: "Outlined Card";
                        subtitle: "GNOME preference-style";
                        material: LTKCardMaterial.Outlined;
                        horizontal-stretch: 1;
                    }
                }

                // ── Accordion ──────────────────────────────────────────
                LTKAccordionItem {
                    title: "Advanced Settings";
                    subtitle: "GPU, memory, performance";
                    LTKToggleSwitch { label: "Hardware acceleration"; checked: true; }
                }

                // ── GNOME Section Group ────────────────────────────────
                LTKSectionGroup {
                    label: "APPEARANCE";
                    LTKSectionRow {
                        title: "Theme";
                        subtitle: "LionOS Dark";
                        separator: true;
                        LTKGhostButton { text: "Change"; }
                    }
                    LTKSectionRow {
                        title: "Accent colour";
                        subtitle: "Blue — 213° OKLCH";
                        separator: true;
                        LTKGhostButton { text: "Edit"; }
                    }
                    LTKSectionRow {
                        title: "Reduce motion";
                        separator: false;
                        LTKToggleSwitch { }
                    }
                }

                // ── Skeleton ───────────────────────────────────────────
                Text {
                    text: "LOADING STATES";
                    color: LTKPalette.text-tertiary;
                    font-family: LTKType.font-mono;
                    font-size: LTKType.text-xs;
                    letter-spacing: 1px;
                }
                HorizontalLayout {
                    spacing: LTKSpace.space-3;
                    LTKSkeletonCard { width: 280px; height: 120px; }
                    LTKSkeletonCard { width: 280px; height: 120px; with-avatar: false; }
                }

                // ── Notifications ──────────────────────────────────────
                LTKToast {
                    message: "Settings saved successfully";
                    action-label: "Undo";
                    kind: LTKToastKind.Success;
                    visible: true;
                }
                LTKToast {
                    message: "Network connection lost";
                    kind: LTKToastKind.Error;
                    visible: true;
                }

                Rectangle { height: LTKSpace.space-8; }
            }
        }
    }
}
