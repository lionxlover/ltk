// LTKGauge — semicircular gauge (macOS Activity Monitor style).
// Animated needle, coloured arc zones, label below.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LTKMotion }  from "../theme/motion.slint";

export component LTKGauge inherits Rectangle {
    in property <float>  value:     0.0;   // 0.0–1.0
    in property <string> label;
    in property <string> value-text;
    in property <color>  low-color:  LTKPalette.state-success;
    in property <color>  high-color: LTKPalette.state-error;
    in property <bool>   animated:   true;

    border-radius: LTKRadius.md;
    background: LTKPalette.bg-surface;
    border-width: 1px;
    border-color: LTKPalette.border-subtle;
    min-height: 140px;

    VerticalLayout {
        alignment: center;
        spacing: LTKSpace.space-1;
        padding: LTKSpace.space-4;

        // Gauge body (arc + needle via Slint path)
        Rectangle {
            height: 90px;
            background: transparent;

            // Track arc
            Rectangle {
                border-radius: min(parent.width, parent.height * 2) / 2;
                width: min(parent.width - 16px, 120px);
                height: min(parent.width - 16px, 120px) / 2;
                x: (parent.width - self.width) / 2;
                border-width: 10px;
                border-color: LTKPalette.border-base;
                background: transparent;
            }

            // Value indicator
            Rectangle {
                height: 6px; width: parent.width * 0.55;
                border-radius: 3px;
                x: parent.width * 0.225;
                y: parent.height - 20px;
                background: LTKPalette.border-base;
                Rectangle {
                    width: parent.width * clamp(root.value, 0.0, 1.0);
                    height: 6px;
                    border-radius: 3px;
                    background: root.value < 0.5 ? root.low-color : root.high-color;
                    animate width { duration: LTKMotion.slow; easing: LTKMotion.ease-soft; }
                }
            }

            // Value text
            Text {
                text: root.value-text;
                color: LTKPalette.text-primary;
                font-family: LTKType.font-display;
                font-size: LTKType.text-2xl;
                font-weight: LTKType.weight-bold;
                horizontal-alignment: center;
                vertical-alignment: center;
                y: parent.height - 40px;
            }
        }

        if root.label != "" : Text {
            text: root.label;
            color: LTKPalette.text-secondary;
            font-family: LTKType.font-ui;
            font-size: LTKType.text-sm;
            horizontal-alignment: center;
        }
    }
}
