// LTK System Widgets — macOS menu bar extras / GNOME shell panel widgets.
// Clock, battery, network, volume — compact horizontal strip items.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKMotion }  from "../theme/motion.slint";
import { LTKIcons }   from "../theme/icons.slint";

// ── Clock Widget ─────────────────────────────────────────────────────
export component LTKClockWidget inherits Rectangle {
    in property <string> time-text:  "12:34";
    in property <string> date-text:  "Mon 5 Jul";
    in property <bool>   show-date:  true;
    background: transparent;

    HorizontalLayout {
        spacing: 4px;
        alignment: center;
        if root.show-date : Text {
            text: root.date-text;
            color: LTKPalette.text-secondary;
            font-family: LTKType.font-ui;
            font-size: LTKType.text-xs;
            vertical-alignment: center;
        }
        Text {
            text: root.time-text;
            color: LTKPalette.text-primary;
            font-family: LTKType.font-ui;
            font-size: LTKType.text-sm;
            font-weight: LTKType.weight-semibold;
            vertical-alignment: center;
        }
    }
}

// ── Battery Widget ────────────────────────────────────────────────────
export component LTKBatteryWidget inherits Rectangle {
    in property <float>  level:      0.80;   // 0.0–1.0
    in property <bool>   charging:   false;
    background: transparent;
    width: 44px;

    HorizontalLayout {
        spacing: 4px;
        alignment: center;
        vertical-alignment: center;

        property <color> bat-color:
            root.charging    ? LTKPalette.state-success
          : root.level < 0.2 ? LTKPalette.state-error
          : root.level < 0.4 ? LTKPalette.state-warning
          : LTKPalette.text-secondary;

        // Battery body
        Rectangle {
            width: 22px; height: 11px;
            border-radius: 2px;
            border-width: 1px;
            border-color: parent.bat-color;
            background: transparent;

            // Fill
            Rectangle {
                x: 1px; y: 1px;
                width: max(1px, 18px * root.level);
                height: 7px;
                border-radius: 1px;
                background: parent.bat-color;
                animate width { duration: LTKMotion.base; }
            }

            // Terminal nub
            Rectangle {
                x: 22px; y: 3px;
                width: 2px; height: 5px;
                border-radius: 1px;
                background: parent.bat-color;
            }
        }

        Text {
            text: round(root.level * 100) + "%";
            color: LTKPalette.text-secondary;
            font-family: LTKType.font-mono;
            font-size: 10px;
            vertical-alignment: center;
        }
    }
}

// ── Volume Widget ─────────────────────────────────────────────────────
export component LTKVolumeWidget inherits Rectangle {
    in property <float>  level:  0.70;
    in property <bool>   muted:  false;
    callback clicked();
    background: transparent;

    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        spacing: 4px; alignment: center; vertical-alignment: center;
        Image {
            source: root.muted || root.level == 0.0 ? LTKIcons.volume-mute : LTKIcons.volume;
            width: 14px; height: 14px;
            colorize: LTKPalette.text-secondary;
        }
        Text {
            text: round(root.level * 100) + "%";
            color: LTKPalette.text-secondary;
            font-family: LTKType.font-mono;
            font-size: 10px;
            vertical-alignment: center;
        }
    }
}

// ── Network Widget ────────────────────────────────────────────────────
export component LTKNetworkWidget inherits Rectangle {
    in property <string>  ssid;
    in property <int>     signal: 4;  // 0–4 bars
    in property <bool>    connected: true;
    callback clicked();
    background: transparent;

    TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    HorizontalLayout {
        spacing: 4px; alignment: center; vertical-alignment: center;
        Image {
            source: LTKIcons.wifi;
            width: 14px; height: 14px;
            colorize: root.connected ? LTKPalette.text-secondary : LTKPalette.state-error;
        }
        if root.ssid != "" : Text {
            text: root.ssid;
            color: LTKPalette.text-secondary;
            font-family: LTKType.font-ui;
            font-size: 10px;
            overflow: elide;
            max-width: 80px;
            vertical-alignment: center;
        }
    }
}
