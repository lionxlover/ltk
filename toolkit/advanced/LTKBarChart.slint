// LTKBarChart — vertical or horizontal bar chart.
// macOS Charts.framework rounded-bar aesthetic.
// Animated bar growth on appear, hover highlight.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LTKMotion }  from "../theme/motion.slint";

export struct LTKBarItem { label: string, value: float, color: color }

export component LTKBarChart inherits Rectangle {
    in property <[LTKBarItem]> items;
    in property <float>        max-value:    100.0;
    in property <string>       title;
    in property <bool>         horizontal:   false;
    in property <bool>         show-values:  true;
    in property <bool>         show-labels:  true;
    in property <length>       bar-gap:      8px;
    callback bar-clicked(index: int);

    border-radius: LTKRadius.md;
    border-width: 1px;
    border-color: LTKPalette.border-subtle;
    background: LTKPalette.bg-surface;
    clip: true;

    property <length> pad: LTKSpace.space-4;
    property <length> label-h: root.show-labels ? 22px : 0px;

    if root.title != "" : Text {
        x: root.pad; y: root.pad;
        text: root.title;
        color: LTKPalette.text-primary;
        font-family: LTKType.font-ui;
        font-size: LTKType.text-sm;
        font-weight: LTKType.weight-semibold;
    }

    if !root.horizontal : HorizontalLayout {
        x: root.pad;
        y: root.title != "" ? root.pad + 24px : root.pad;
        width: parent.width - root.pad * 2;
        height: parent.height - root.pad * 2 - (root.title != "" ? 24px : 0px) - root.label-h;
        spacing: root.bar-gap;
        alignment: LayoutAlignment.stretch;

        for item[i] in root.items : VerticalLayout {
            alignment: end;
            spacing: 2px;
            horizontal-stretch: 1;

            if root.show-values : Text {
                text: item.value;
                color: LTKPalette.text-tertiary;
                font-family: LTKType.font-mono;
                font-size: 10px;
                horizontal-alignment: center;
            }

            Rectangle {
                border-radius: LTKRadius.xs;
                border-top-left-radius:  LTKRadius.xs;
                border-top-right-radius: LTKRadius.xs;
                height: parent.height * (item.value / root.max-value);
                background: b-touch.has-hover ? item.color.brighter(0.15) : item.color;
                animate height     { duration: LTKMotion.slow; easing: LTKMotion.ease-spring; }
                animate background { duration: LTKMotion.fast; }

                b-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.bar-clicked(i); }
                }
            }
        }
    }

    if root.show-labels : HorizontalLayout {
        x: root.pad;
        y: parent.height - root.pad - root.label-h;
        width: parent.width - root.pad * 2;
        spacing: root.bar-gap;
        alignment: LayoutAlignment.stretch;

        for item in root.items : Text {
            text: item.label;
            color: LTKPalette.text-tertiary;
            font-family: LTKType.font-ui;
            font-size: 10px;
            horizontal-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}
