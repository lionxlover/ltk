// LTKTableView — macOS NSTableView / GNOME GtkTreeView inspired.
// Sticky column headers with sort indicators, resizable columns.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LTKMotion }  from "../theme/motion.slint";

export struct LTKColumn  { id: string, label: string, width: length, sortable: bool, align-right: bool }
export struct LTKTableRow { id: string, cells: [string], selected: bool }

export component LTKTableView inherits Rectangle {
    in property <[LTKColumn]>   columns;
    in property <[LTKTableRow]> rows;
    in-out property <string>    sort-column;
    in-out property <bool>      sort-ascending: true;
    in-out property <int>       selected-index: -1;

    callback sort-changed(col-id: string, ascending: bool);
    callback row-selected(index: int, id: string);
    callback row-activated(index: int, id: string);

    border-radius: LTKRadius.md;
    border-width: 1px;
    border-color: LTKPalette.border-subtle;
    background: LTKPalette.bg-surface;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        // ── Column headers ────────────────────────────────────────────
        Rectangle {
            height: 34px;
            background: LTKPalette.bg-headerbar;
            border-bottom-width: 1px;
            border-color: LTKPalette.border-base;

            HorizontalLayout {
                padding-left: LTKSpace.space-3;
                spacing: 0px;

                for col in root.columns : Rectangle {
                    width: col.width;

                    HorizontalLayout {
                        spacing: 5px;
                        alignment: col.align-right ? LayoutAlignment.end : LayoutAlignment.start;
                        padding-right: 8px;
                        vertical-alignment: center;

                        Text {
                            text: col.label;
                            color: col.id == root.sort-column ? LTKPalette.accent : LTKPalette.text-tertiary;
                            font-family: LTKType.font-mono;
                            font-size: LTKType.text-xs;
                            font-weight: LTKType.weight-semibold;
                            letter-spacing: 0.6px;
                            vertical-alignment: center;
                            animate color { duration: LTKMotion.fast; }
                        }

                        if col.id == root.sort-column : Text {
                            text: root.sort-ascending ? "↑" : "↓";
                            color: LTKPalette.accent;
                            font-size: LTKType.text-xs;
                            vertical-alignment: center;
                        }
                    }

                    if col.sortable : TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if root.sort-column == col.id {
                                root.sort-ascending = !root.sort-ascending;
                            } else {
                                root.sort-column = col.id;
                                root.sort-ascending = true;
                            }
                            root.sort-changed(col.id, root.sort-ascending);
                        }
                    }

                    // Column divider
                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px; height: 18px;
                        y: 8px;
                        background: LTKPalette.border-subtle;
                    }
                }
            }
        }

        // ── Data rows ─────────────────────────────────────────────────
        ScrollView {
            VerticalLayout {
                spacing: 0px;

                for row[i] in root.rows : Rectangle {
                    height: 38px;
                    background:
                        i == root.selected-index ? LTKPalette.accent
                      : row-t.has-hover          ? LTKPalette.border-subtle
                      : mod(i, 2) == 1           ? LTKPalette.border-subtle.with-alpha(0.5)
                      : transparent;
                    animate background { duration: LTKMotion.fast; }

                    HorizontalLayout {
                        padding-left: LTKSpace.space-3;
                        spacing: 0px;

                        for cell[ci] in row.cells : Rectangle {
                            width: root.columns[ci].width;
                            Text {
                                text: cell;
                                color: i == root.selected-index ? #FFFFFF : LTKPalette.text-primary;
                                font-family: LTKType.font-ui;
                                font-size: LTKType.text-sm;
                                horizontal-alignment: root.columns[ci].align-right ? right : left;
                                vertical-alignment: center;
                                padding-right: 8px;
                                overflow: elide;
                                animate color { duration: LTKMotion.fast; }
                            }
                        }
                    }

                    Rectangle {
                        y: parent.height - 1px; height: 1px; width: parent.width;
                        background: i == root.selected-index ? transparent : LTKPalette.border-subtle;
                    }

                    row-t := TouchArea {
                        mouse-cursor: pointer;
                        clicked       => { root.selected-index = i; root.row-selected(i, row.id); }
                        double-clicked=> { root.row-activated(i, row.id); }
                    }
                }
            }
        }
    }
}
