// LTKNotificationCenter — macOS Notification Center panel.
// Slides in from right; stacked notification cards with clear actions.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LTKMotion }  from "../theme/motion.slint";
import { LTKIcons }   from "../theme/icons.slint";

export struct LTKNotification {
    id:       string,
    app:      string,
    title:    string,
    body:     string,
    time:     string,
    icon:     image,
    has-icon: bool,
    unread:   bool,
}

export component LTKNotificationCenter inherits Rectangle {
    in property <bool>                open: false;
    in property <[LTKNotification]>   items;
    in property <string>              date-header: "Today";
    callback clear-all();
    callback notification-clicked(id: string);
    callback notification-dismissed(id: string);

    background: transparent;
    z: 500;

    // Backdrop scrim (click-away)
    if root.open : TouchArea {
        width: parent.width; height: parent.height;
        clicked => { root.open = false; }
    }

    // Panel
    if root.open : Rectangle {
        x: parent.width - 340px;
        y: 0px;
        width: 340px;
        height: parent.height;
        background: LTKPalette.glass-thick;
        border-left-width: 1px;
        border-color: LTKPalette.border-subtle;
        drop-shadow-blur: 40px;
        drop-shadow-offset-x: -8px;
        drop-shadow-color: LTKPalette.shadow-lg;
        clip: true;
        z: 501;

        animate x { duration: LTKMotion.medium; easing: LTKMotion.ease-decelerate; }

        VerticalLayout {
            spacing: 0px;

            // Header
            Rectangle {
                height: 52px;
                HorizontalLayout {
                    padding-left: LTKSpace.space-4;
                    padding-right: LTKSpace.space-3;
                    alignment: center;
                    Text {
                        text: "Notifications";
                        color: LTKPalette.text-primary;
                        font-family: LTKType.font-display;
                        font-size: LTKType.title-3;
                        font-weight: LTKType.weight-bold;
                        horizontal-stretch: 1;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.clear-all(); }
                        Text {
                            text: "Clear All";
                            color: LTKPalette.accent;
                            font-family: LTKType.font-ui;
                            font-size: LTKType.text-sm;
                            font-weight: LTKType.weight-medium;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: LTKPalette.border-subtle; }

            ScrollView {
                VerticalLayout {
                    padding: LTKSpace.space-2;
                    spacing: LTKSpace.space-1;

                    // Date header
                    Text {
                        text: root.date-header;
                        color: LTKPalette.text-tertiary;
                        font-family: LTKType.font-mono;
                        font-size: LTKType.text-xs;
                        letter-spacing: 0.8px;
                        padding-left: LTKSpace.space-1;
                        padding-top: LTKSpace.space-1;
                    }

                    // Notification cards
                    for n in root.items : Rectangle {
                        border-radius: LTKRadius.lg;
                        background: LTKPalette.bg-raised;
                        border-width: 1px;
                        border-color: n.unread ? LTKPalette.accent.with-alpha(0.25) : LTKPalette.border-subtle;
                        clip: true;

                        HorizontalLayout {
                            padding: LTKSpace.space-2;
                            spacing: LTKSpace.space-2;
                            alignment: start;

                            // App icon
                            if n.has-icon : Rectangle {
                                width: 36px; height: 36px;
                                border-radius: 9px;
                                background: LTKPalette.accent.with-alpha(0.12);
                                Image { source: n.icon; width: 20px; height: 20px; colorize: LTKPalette.accent; }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;

                                HorizontalLayout {
                                    Text {
                                        text: n.app;
                                        color: LTKPalette.text-tertiary;
                                        font-family: LTKType.font-mono;
                                        font-size: 10px;
                                        letter-spacing: 0.5px;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: n.time;
                                        color: LTKPalette.text-tertiary;
                                        font-family: LTKType.font-mono;
                                        font-size: 10px;
                                    }
                                }

                                Text {
                                    text: n.title;
                                    color: LTKPalette.text-primary;
                                    font-family: LTKType.font-ui;
                                    font-size: LTKType.text-sm;
                                    font-weight: LTKType.weight-semibold;
                                }

                                if n.body != "" : Text {
                                    text: n.body;
                                    color: LTKPalette.text-secondary;
                                    font-family: LTKType.font-ui;
                                    font-size: LTKType.text-sm;
                                    wrap: word-wrap;
                                    max-lines: 2;
                                    overflow: elide;
                                }
                            }

                            // Dismiss × button
                            TouchArea {
                                width: 20px; height: 20px;
                                mouse-cursor: pointer;
                                clicked => { root.notification-dismissed(n.id); }
                                Text {
                                    text: "×";
                                    color: LTKPalette.text-tertiary;
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Unread dot
                        if n.unread : Rectangle {
                            x: 8px; y: 8px;
                            width: 7px; height: 7px;
                            border-radius: 3.5px;
                            background: LTKPalette.accent;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            z: -1;
                            clicked => { root.notification-clicked(n.id); }
                        }
                    }

                    // Empty state
                    if root.items.length == 0 : Rectangle {
                        height: 200px;
                        VerticalLayout {
                            alignment: center; spacing: LTKSpace.space-2;
                            Image { source: LTKIcons.bell-off; width: 40px; height: 40px; colorize: LTKPalette.text-tertiary; opacity: 0.4; }
                            Text {
                                text: "No Notifications";
                                color: LTKPalette.text-tertiary;
                                font-family: LTKType.font-ui;
                                font-size: LTKType.text-base;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}
