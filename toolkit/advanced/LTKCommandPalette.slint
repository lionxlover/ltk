// LTKCommandPalette — macOS ⌘K / GNOME run dialog inspired.
// Floating center modal with fuzzy-search input and result list.
// Keyboard navigable. Spring entrance animation.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LTKMotion }  from "../theme/motion.slint";
import { LTKIcons }   from "../theme/icons.slint";

export struct LTKCommand {
    id:       string,
    label:    string,
    group:    string,
    shortcut: string,
    icon:     image,
    has-icon: bool,
}

export component LTKCommandPalette inherits Rectangle {
    in property <bool>         open:    false;
    in property <[LTKCommand]> results;
    in property <int>          highlighted: 0;
    in-out property <string>   query;
    in property <string>       placeholder: "Type a command or search…";

    callback query-changed(q: string);
    callback command-selected(id: string);
    callback closed();

    background: transparent;
    z: 1200;

    // Backdrop
    if root.open : Rectangle {
        width: parent.width; height: parent.height;
        background: LTKPalette.shadow-xl.with-alpha(0.55);
        animate opacity { duration: LTKMotion.fast; }
        TouchArea { clicked => { root.closed(); } }
    }

    // Panel
    if root.open : Rectangle {
        width: 560px;
        x: (parent.width - 560px) / 2;
        y: max(60px, parent.height * 0.18);
        height: panel-col.preferred-height;
        max-height: parent.height * 0.65;
        border-radius: LTKRadius.xl;
        border-width: 1px;
        border-color: LTKPalette.border-base;
        background: LTKPalette.glass-thick;
        drop-shadow-blur: 60px;
        drop-shadow-offset-y: 20px;
        drop-shadow-color: LTKPalette.shadow-xl;
        clip: true;
        z: 1201;

        animate y { duration: LTKMotion.spring; easing: LTKMotion.ease-spring; }
        animate opacity { duration: LTKMotion.fast; easing: LTKMotion.ease-decelerate; }

        panel-col := VerticalLayout {
            spacing: 0px;

            // Search input row
            Rectangle {
                height: 52px;
                border-bottom-width: 1px;
                border-color: LTKPalette.border-subtle;
                background: transparent;

                HorizontalLayout {
                    padding-left: LTKSpace.space-3;
                    padding-right: LTKSpace.space-3;
                    spacing: LTKSpace.space-2;
                    alignment: center;

                    Image { source: LTKIcons.search; width: 18px; height: 18px; colorize: LTKPalette.text-secondary; }

                    TextInput {
                        text <=> root.query;
                        placeholder-text: root.placeholder;
                        placeholder-color: LTKPalette.text-tertiary;
                        color: LTKPalette.text-primary;
                        font-family: LTKType.font-ui;
                        font-size: LTKType.text-md;
                        vertical-alignment: center;
                        edited => { root.query-changed(root.query); }
                        key-pressed(e) => {
                            if e.text == Key.Escape { root.closed(); accept }
                            else { reject }
                        }
                    }

                    if root.query != "" : TouchArea {
                        width: 20px; height: 20px; mouse-cursor: pointer;
                        clicked => { root.query = ""; root.query-changed(""); }
                        Rectangle {
                            border-radius: 10px;
                            background: LTKPalette.border-strong;
                            Text { text: "×"; color: LTKPalette.text-secondary; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
            }

            // Result list
            if root.results.length > 0 : ScrollView {
                max-height: parent.max-height - 52px;
                VerticalLayout {
                    padding: LTKSpace.px4;
                    spacing: 0px;

                    for cmd[i] in root.results : Rectangle {
                        height: 38px;
                        border-radius: LTKRadius.sm;
                        background: i == root.highlighted ? LTKPalette.accent
                                  : cmd-t.has-hover       ? LTKPalette.border-subtle
                                  : transparent;
                        animate background { duration: LTKMotion.fast; }

                        HorizontalLayout {
                            padding-left: LTKSpace.space-2;
                            padding-right: LTKSpace.space-2;
                            spacing: LTKSpace.space-2;
                            alignment: center;

                            if cmd.has-icon : Image {
                                source: cmd.icon;
                                width: 15px; height: 15px;
                                colorize: i == root.highlighted ? #FFFFFF : LTKPalette.text-secondary;
                                animate colorize { duration: LTKMotion.fast; }
                            }

                            Text {
                                text: cmd.label;
                                color: i == root.highlighted ? #FFFFFF : LTKPalette.text-primary;
                                font-family: LTKType.font-ui;
                                font-size: LTKType.text-sm;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                animate color { duration: LTKMotion.fast; }
                            }

                            if cmd.group != "" : Text {
                                text: cmd.group;
                                color: i == root.highlighted ? #FFFFFF66 : LTKPalette.text-tertiary;
                                font-family: LTKType.font-mono;
                                font-size: LTKType.text-xs;
                                vertical-alignment: center;
                            }

                            if cmd.shortcut != "" : Rectangle {
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: i == root.highlighted ? #FFFFFF33 : LTKPalette.border-base;
                                background: i == root.highlighted ? #FFFFFF14 : LTKPalette.bg-raised;
                                height: 18px;
                                width: sc-t.preferred-width + 8px;
                                sc-t := Text {
                                    text: cmd.shortcut;
                                    color: i == root.highlighted ? #FFFFFF88 : LTKPalette.text-tertiary;
                                    font-family: LTKType.font-mono;
                                    font-size: 10px;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                        }

                        cmd-t := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.command-selected(cmd.id); }
                        }
                    }
                }
            }

            // Footer hint bar
            Rectangle {
                height: 32px;
                background: LTKPalette.border-subtle.with-alpha(0.5);
                border-top-width: 1px;
                border-color: LTKPalette.border-subtle;
                HorizontalLayout {
                    padding-left: LTKSpace.space-3;
                    padding-right: LTKSpace.space-3;
                    spacing: LTKSpace.space-2;
                    alignment: start;
                    vertical-alignment: center;

                    for hint in [
                        { key: "↵",  label: "select" },
                        { key: "↑↓", label: "navigate" },
                        { key: "esc",label: "close" },
                    ] : HorizontalLayout {
                        spacing: 4px; alignment: center;
                        Rectangle {
                            border-radius: 3px; border-width: 1px;
                            border-color: LTKPalette.border-base;
                            background: LTKPalette.bg-raised;
                            height: 18px; width: kh-t.preferred-width + 7px;
                            kh-t := Text { text: hint.key; color: LTKPalette.text-tertiary; font-family: LTKType.font-mono; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: hint.label; color: LTKPalette.text-tertiary; font-family: LTKType.font-ui; font-size: 10px; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
