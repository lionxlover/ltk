// LTKMarkdownView — rendered markdown display (read-only).
// Styled headings, body, code blocks, blockquotes, horizontal rules.
// macOS Reader mode × GNOME document view aesthetic.

import { LTKPalette } from "../theme/palette.slint";
import { LTKType }    from "../theme/typography.slint";
import { LTKSpace }   from "../theme/spacing.slint";
import { LTKRadius }  from "../theme/radius.slint";
import { LeonuxRadius, LeonuxSpace } from "../theme/leonux_tokens.slint";

export struct LTKMdBlock {
    kind:    string,    // "h1"|"h2"|"h3"|"p"|"code"|"quote"|"hr"|"li"
    content: string,
    lang:    string,    // for code blocks
}

export component LTKMarkdownView inherits Rectangle {
    in property <[LTKMdBlock]> blocks;
    in property <bool>         centered:   false;
    in property <length>       max-width:  760px;
    in property <length>       line-width: LTKType.body;

    background: LTKPalette.bg-base;

    ScrollView {
        VerticalLayout {
            padding: LeonuxSpace.xl;
            spacing: LeonuxSpace.sm;
            max-width: root.max-width;
            alignment: root.centered ? LayoutAlignment.center : LayoutAlignment.start;

            for block in root.blocks : Rectangle {
                background: transparent;

                // H1
                if block.kind == "h1" : Text {
                    text: block.content;
                    color: LTKPalette.text-primary;
                    font-family: LTKType.font-display;
                    font-size: LTKType.title-2;
                    font-weight: LTKType.weight-bold;
                    wrap: word-wrap;
                }
                // H2
                if block.kind == "h2" : Rectangle {
                    VerticalLayout {
                        spacing: LeonuxSpace.xs;
                        Text {
                            text: block.content;
                            color: LTKPalette.text-primary;
                            font-family: LTKType.font-display;
                            font-size: LTKType.title-3;
                            font-weight: LTKType.weight-semibold;
                            wrap: word-wrap;
                        }
                        Rectangle { height: 1px; background: LTKPalette.border-subtle; }
                    }
                }
                // H3
                if block.kind == "h3" : Text {
                    text: block.content;
                    color: LTKPalette.text-primary;
                    font-family: LTKType.font-ui;
                    font-size: LTKType.headline;
                    font-weight: LTKType.weight-semibold;
                    wrap: word-wrap;
                }
                // Paragraph
                if block.kind == "p" : Text {
                    text: block.content;
                    color: LTKPalette.text-secondary;
                    font-family: LTKType.font-body;
                    font-size: root.line-width;
                    wrap: word-wrap;
                }
                // Inline code block
                if block.kind == "code" : Rectangle {
                    border-radius: LeonuxRadius.r3;  // Tertiary = 10px
                    background: #0D0F13;
                    border-width: 1px;
                    border-color: LTKPalette.border-base;

                    VerticalLayout {
                        spacing: 0px;
                        // Language badge
                        if block.lang != "" : Rectangle {
                            height: 28px;
                            background: LTKPalette.border-subtle;
                            border-bottom-width: 1px;
                            border-color: LTKPalette.border-base;
                            HorizontalLayout {
                                padding-left: LeonuxSpace.sm;
                                alignment: center;
                                Text {
                                    text: block.lang;
                                    color: LTKPalette.text-tertiary;
                                    font-family: LTKType.font-mono;
                                    font-size: LTKType.text-xs;
                                    letter-spacing: 0.5px;
                                }
                            }
                        }
                        Text {
                            text: block.content;
                            color: #A6E3A1;
                            font-family: LTKType.font-mono;
                            font-size: LTKType.text-code;
                            wrap: word-wrap;
                            padding: LeonuxSpace.sm;
                        }
                    }
                }
                // Blockquote
                if block.kind == "quote" : Rectangle {
                    border-radius: LeonuxRadius.r4;  // Quaternary = 6px
                    background: LTKPalette.accent.with-alpha(0.06);
                    border-left-width: 3px;
                    border-color: LTKPalette.accent.with-alpha(0.45);
                    Text {
                        text: block.content;
                        color: LTKPalette.text-secondary;
                        font-family: LTKType.font-body;
                        font-size: root.line-width;
                        wrap: word-wrap;
                        padding-left: LeonuxSpace.md;
                        padding-top: LeonuxSpace.sm;
                        padding-bottom: LeonuxSpace.sm;
                    }
                }
                // Horizontal rule
                if block.kind == "hr" : Rectangle {
                    height: 17px;
                    background: transparent;
                    Rectangle {
                        y: 8px; height: 1px; width: parent.width;
                        background: LTKPalette.border-base;
                    }
                }
                // List item
                if block.kind == "li" : HorizontalLayout {
                    spacing: LeonuxSpace.sm;
                    alignment: start;
                    Rectangle {
                        width: 6px; height: 6px; border-radius: 3px;
                        background: LTKPalette.accent;
                        y: 8px;
                    }
                    Text {
                        text: block.content;
                        color: LTKPalette.text-secondary;
                        font-family: LTKType.font-body;
                        font-size: root.line-width;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
    }
}
